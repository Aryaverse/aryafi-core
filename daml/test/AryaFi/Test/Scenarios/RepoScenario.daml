-- | Institutional Repurchase Agreement (Repo) and Margin Reference Application.
--
-- Demonstrates the end-to-end tri-party repo trade lifecycle:
--
-- Participants:
--   - Seller:        Primary Dealer Bank (GoldmanSachs)
--   - Buyer:         Institutional Liquidity Fund (BlackRockLiquidity)
--   - Custodian:     Tri-Party Custody Bank (BNYMellon)
--   - TripartyAgent: Collateral Allocation Agent (Euroclear)
--   - KycAuthority:  Institutional KYC Registry
--   - SanctionsAuth: Sanctions Screening Provider
--   - Regulator:     Securities and Exchange Commission (SEC)
--
-- Lifecycle Workflow:
--   Phase 1 — Institutional Compliance Verification
--     1. KYC and Sanctions attestations issued for Seller and Buyer
--   Phase 2 — Trade Agreement & Opening Leg DvP Settlement
--     2. Tri-party RepoAgreement initiated (10M Treasuries, 2% haircut, 9.8M cash)
--     3. Buyer books corresponding ReverseRepoPosition
--     4. Custodian executes opening leg settlement -> RepoActive
--   Phase 3 — Mark-to-Market Revaluation & Variation Margin Call
--     5. Market decline triggers collateral revaluation
--     6. Buyer detects margin deficit and issues Variation MarginCall
--     7. Seller satisfies margin call with cash transfer reference
--     8. Buyer confirms margin satisfaction
--   Phase 4 — Collateral Substitution
--     9. Seller exercises collateral substitution with equivalent Treasury paper
--   Phase 5 — Maturity Repurchase Settlement & Closeout
--     10. Seller initiates closing leg at maturity
--     11. Custodian executes closing repurchase DvP settlement -> RepoSettled
--     12. Buyer closes ReverseRepoPosition
module AryaFi.Test.Scenarios.RepoScenario where

import Daml.Script
import AryaFi.Compliance.KYC
import AryaFi.Compliance.Sanctions
import AryaFi.Contracts.Repo
import AryaFi.Contracts.ReverseRepo
import AryaFi.Contracts.Margin
import AryaFi.Common.Types
import AryaFi.Common.Identifiers
import DA.Date (date, Month(..))
import DA.Time (time)

testInstitutionalRepoAndMarginWorkflow : Script ()
testInstitutionalRepoAndMarginWorkflow = script do

  -- =========================================================================
  -- Party Allocation
  -- =========================================================================
  seller <- allocateParty "GoldmanSachsDealer"
  buyer <- allocateParty "BlackRockLiquidityDesk"
  custodian <- allocateParty "BNYMellonCustody"
  triparty <- allocateParty "EuroclearTriParty"
  kycAuth <- allocateParty "GlobalKycRegistry"
  sanctionsAuth <- allocateParty "GlobalSanctionsAgency"
  regulator <- allocateParty "SEC"

  let now = time (date 2026 Sep 1) 9 0 0
  let expiryDate = time (date 2027 Sep 1) 9 0 0
  let repoEndDate = time (date 2026 Sep 15) 15 0 0 -- 14-day repo
  let marginDeadline = time (date 2026 Sep 8) 17 0 0
  setTime now

  -- =========================================================================
  -- Phase 1: Institutional Compliance Verification
  -- =========================================================================
  sellerKycCid <- submit kycAuth do
    createCmd KycAttestation with
      authority = kycAuth
      subjectParty = seller
      lei = Some (LEI "7845000ABCD1234EF56")
      status = KycVerified
      verificationTimestamp = now
      expiryTimestamp = expiryDate
      jurisdiction = "US"
      riskTier = "Tier3Institutional (risk score 10)"
      providerRef = Some (ExternalRef "KYC-SELLER-001")
      observers = [regulator]

  buyerKycCid <- submit kycAuth do
    createCmd KycAttestation with
      authority = kycAuth
      subjectParty = buyer
      lei = Some (LEI "5493000G7M5A0Z5F6S89")
      status = KycVerified
      verificationTimestamp = now
      expiryTimestamp = expiryDate
      jurisdiction = "US"
      riskTier = "Tier3Institutional (risk score 8)"
      providerRef = Some (ExternalRef "KYC-BUYER-001")
      observers = [regulator]

  sellerSanctionsCid <- submit sanctionsAuth do
    createCmd SanctionsAttestation with
      screeningAuthority = sanctionsAuth
      subjectParty = seller
      lei = None
      status = SanctionsClear
      screeningTimestamp = now
      expiryTimestamp = expiryDate
      screeningProviderRef = "SANC-REF-GS-01" <> " lists: " <> show (["OFAC_SDN", "EU_CONSOLIDATED"] : [Text])
      providerRef = Some (ExternalRef "SANC-SELLER-001")
      observers = [regulator]

  buyerSanctionsCid <- submit sanctionsAuth do
    createCmd SanctionsAttestation with
      screeningAuthority = sanctionsAuth
      subjectParty = buyer
      lei = None
      status = SanctionsClear
      screeningTimestamp = now
      expiryTimestamp = expiryDate
      screeningProviderRef = "SANC-REF-BLK-01" <> " lists: " <> show (["OFAC_SDN", "EU_CONSOLIDATED"] : [Text])
      providerRef = Some (ExternalRef "SANC-BUYER-001")
      observers = [regulator]

  isSellerKycValid <- submit kycAuth do exerciseCmd sellerKycCid IsKycValid
  isBuyerKycValid <- submit kycAuth do exerciseCmd buyerKycCid IsKycValid
  assertMsg "Both counterparties must hold valid KYC" (isSellerKycValid && isBuyerKycValid)

  isSellerClear <- submit sanctionsAuth do exerciseCmd sellerSanctionsCid IsSanctionsClear
  isBuyerClear <- submit sanctionsAuth do exerciseCmd buyerSanctionsCid IsSanctionsClear
  assertMsg "Both counterparties must be sanctions-clear" (isSellerClear && isBuyerClear)

  -- =========================================================================
  -- Phase 2: Trade Agreement & Opening Leg DvP Settlement
  -- =========================================================================
  repoCid <- submit (actAs [seller, buyer, custodian]) do
    createCmd RepoAgreement with
      repoId = "REPO-2026-GS-BLK-001"
      seller = seller
      buyer = buyer
      tripartyAgent = Some triparty
      custodian = custodian
      isin = ISIN "US912828ZM50"
      collateralQuantity = 10000000.0 -- 10M US Treasuries
      collateralAccountId = AccountId "ACC-TRI-PARTY-BNY-01"
      haircut = 0.02 -- 2% haircut
      currency = "USD"
      purchasePrice = 9800000.0 -- 9.8M USD cash lent
      repurchasePrice = 9820008.33 -- 9.8M + 14-day interest at 5.25%
      repoRate = 0.0525
      dayCountConvention = Act360
      startDate = now
      endDate = repoEndDate
      status = RepoPendingOpening
      openingSettlementRef = None
      closingSettlementRef = None
      correlationId = CorrelationId "CORR-REPO-TRADESTORE-001"
      observers = [regulator]

  -- Buyer books corresponding ReverseRepoPosition
  revPosCid <- submit buyer do
    createCmd ReverseRepoPosition with
      positionId = "REV-POS-BLK-001"
      buyer = buyer
      seller = seller
      custodian = custodian
      repoId = "REPO-2026-GS-BLK-001"
      isin = ISIN "US912828ZM50"
      collateralQuantity = 10000000.0
      currency = "USD"
      purchasePrice = 9800000.0
      repurchasePrice = 9820008.33
      repoRate = 0.0525
      startDate = now
      endDate = repoEndDate
      currentMarketValue = 10000000.0
      status = Active
      correlationId = CorrelationId "CORR-REPO-TRADESTORE-001"
      observers = [regulator]

  -- Custodian executes opening leg settlement
  repoCidActive <- submit custodian do
    exerciseCmd repoCid ExecuteOpeningLeg with
      settlementRef = "SETTLE-OPEN-DVP-BNY-001"

  Some repoActive <- queryContractId buyer repoCidActive
  assertMsg "Repo must be Active" (repoActive.status == RepoActive)

  -- =========================================================================
  -- Phase 3: Mark-to-Market Revaluation & Variation Margin Call
  -- =========================================================================

  -- Collateral value drops to 9,600,000 USD
  revPosCidUpdated <- submit buyer do
    exerciseCmd revPosCid UpdateMarkToMarket with
      newMarketValue = 9600000.0

  -- Buyer calculates deficit with 2% margin (Required = 9.8M * 1.02 = 9.996M; Deficit = 9.996M - 9.6M = 396,000 USD)
  deficit <- submit buyer do
    exerciseCmd revPosCidUpdated CalculateMarginDeficit with
      requiredMarginRatio = 0.02

  assertMsg "Deficit must be 396,000 USD" (deficit == 396000.0)

  -- Buyer serves Variation Margin Call
  marginCallCid <- submit (actAs [buyer, seller]) do
    createCmd MarginCall with
      marginCallId = "MC-VAR-2026-001"
      caller = buyer
      payer = seller
      custodian = custodian
      marginType = VariationMargin
      relatedAgreementRef = "REPO-2026-GS-BLK-001"
      currency = "USD"
      requiredAmount = 396000.0
      deadline = marginDeadline
      status = MarginCallIssued
      correlationId = CorrelationId "CORR-MARGIN-001"
      observers = [regulator]

  -- Seller submits variation margin via Fedwire cash transfer
  marginCallSubmittedCid <- submit seller do
    exerciseCmd marginCallCid SatisfyWithCash with
      paymentRef = "FEDWIRE-IMAD-20260908-001234"

  isMarginMetBeforeConfirmation <- submit buyer do
    exerciseCmd marginCallSubmittedCid IsMarginSatisfied
  assertMsg "Margin is not satisfied until the caller confirms receipt" (not isMarginMetBeforeConfirmation)

  -- Buyer confirms receipt of the Fedwire funds
  marginCallSatisfiedCid <- submit buyer do
    exerciseCmd marginCallSubmittedCid ConfirmMarginReceipt

  isMarginMet <- submit buyer do
    exerciseCmd marginCallSatisfiedCid IsMarginSatisfied
  assertMsg "Margin call must be satisfied" isMarginMet

  -- =========================================================================
  -- Phase 4: Collateral Substitution
  -- =========================================================================

  -- Seller substitutes collateral with alternative Treasury paper (US912828XG01)
  repoCidSubstituted <- submit (actAs [seller, buyer]) do
    exerciseCmd repoCidActive SubstituteCollateral with
      newIsin = ISIN "US912828XG01"
      newQuantity = 10100000.0
      newHaircut = 0.02

  Some repoSub <- queryContractId seller repoCidSubstituted
  assertMsg "ISIN must be updated" (repoSub.isin == ISIN "US912828XG01")

  -- =========================================================================
  -- Phase 5: Maturity Repurchase Settlement & Closeout
  -- =========================================================================

  -- Seller initiates closing leg at maturity
  repoCidPendingClose <- submit seller do
    exerciseCmd repoCidSubstituted InitiateClosingLeg

  Some repoPendingClose <- queryContractId seller repoCidPendingClose
  assertMsg "Status must be RepoPendingClosing" (repoPendingClose.status == RepoPendingClosing)

  -- Custodian executes closing repurchase settlement
  repoCidSettled <- submit custodian do
    exerciseCmd repoCidPendingClose ExecuteClosingLeg with
      settlementRef = "SETTLE-CLOSE-DVP-BNY-001"

  Some repoFinal <- queryContractId buyer repoCidSettled
  assertMsg "Repo status must be RepoSettled" (repoFinal.status == RepoSettled)

  -- Buyer closes ReverseRepoPosition
  revPosCidClosed <- submit buyer do
    exerciseCmd revPosCidUpdated CloseReverseRepo

  Some revClosed <- queryContractId buyer revPosCidClosed
  assertMsg "Reverse repo position must be Closed" (revClosed.status == Closed)
  pure ()
