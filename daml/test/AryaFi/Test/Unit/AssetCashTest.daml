-- | Unit tests for AryaFi.Finance.Asset and AryaFi.Finance.Cash.
-- Covers: asset lock/unlock, transfer, cash split/merge, cash transfer,
-- locking, observer management, invariant preservation, and negative tests.
module AryaFi.Test.Unit.AssetCashTest where

import Daml.Script
import AryaFi.Finance.Asset
import AryaFi.Finance.Cash
import AryaFi.Common.Identifiers
import AryaFi.Common.Types

-- ---------------------------------------------------------------------------
-- AssetHolding Tests
-- ---------------------------------------------------------------------------

mkAssetHolding : Party -> Party -> Party -> AccountId -> Script (ContractId AssetHolding)
mkAssetHolding issuer custodian owner accId = submit (actAs [issuer, custodian, owner]) do
  createCmd AssetHolding with
    issuer = issuer
    custodian = custodian
    owner = owner
    accountId = accId
    assetClass = FundShare
    assetId = "FIGI-BBG000BLNQ16"
    quantity = 50000.0
    isLocked = False
    lockReference = None
    lockHolder = None
    externalRef = None
    observers = []

testAssetLockAndUnlock : Script ()
testAssetLockAndUnlock = script do
  issuer    <- allocateParty "FundIssuer"
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "InstitutionalInvestor"

  holdingCid <- mkAssetHolding issuer custodian owner (AccountId "ACC-FUND-001")

  -- Lock the asset
  lockedCid <- submit (actAs [owner, custodian]) do
    exerciseCmd holdingCid LockAsset with
      lockRef = "PLEDGE-REPO-2026-001"
      lockingParty = custodian

  lockedData <- queryContractId owner lockedCid
  case lockedData of
    None -> abort "Locked asset not found"
    Some h -> do
      assertMsg "Asset is locked" (h.isLocked == True)
      assertMsg "Lock reference set" (h.lockReference == Some "PLEDGE-REPO-2026-001")

  -- Unlock it
  unlockedCid <- submit (actAs [owner, custodian]) do
    exerciseCmd lockedCid UnlockAsset

  unlockedData <- queryContractId owner unlockedCid
  case unlockedData of
    None -> abort "Unlocked asset not found"
    Some h -> do
      assertMsg "Asset is unlocked" (h.isLocked == False)
      assertMsg "Lock reference cleared" (h.lockReference == None)

testAssetTransfer : Script ()
testAssetTransfer = script do
  issuer     <- allocateParty "FundIssuer"
  custodian  <- allocateParty "GlobalCustodian"
  seller     <- allocateParty "SellerFund"
  buyer      <- allocateParty "BuyerFund"

  holdingCid <- mkAssetHolding issuer custodian seller (AccountId "ACC-SELLER-001")

  transferredCid <- submit (actAs [seller, custodian, buyer]) do
    exerciseCmd holdingCid TransferAsset with
      newOwner = buyer
      newAccountId = AccountId "ACC-BUYER-001"

  -- Buyer can see the transferred position
  buyerView <- queryContractId buyer transferredCid
  case buyerView of
    None -> abort "Buyer cannot see transferred asset"
    Some h -> do
      assertMsg "Owner is now buyer" (h.owner == buyer)
      assertMsg "Account updated" (h.accountId == AccountId "ACC-BUYER-001")
      assertMsg "Quantity preserved" (h.quantity == 50000.0)

  -- Seller can no longer see (not a signatory anymore)
  -- NOTE: In Daml, the old contract is archived, not the new one.
  -- The original seller is no longer a signatory; they won't divulge the new contract.
  pure ()

testAssetObserverManagement : Script ()
testAssetObserverManagement = script do
  issuer    <- allocateParty "FundIssuer"
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "InstitutionalInvestor"
  agent     <- allocateParty "SettlementAgent"
  outsider  <- allocateParty "OutsiderCorp"

  holdingCid <- mkAssetHolding issuer custodian owner (AccountId "ACC-OBS-001")

  -- Outsider cannot see
  outsiderView <- queryContractId outsider holdingCid
  assertMsg "Outsider blind to asset" (outsiderView == None)

  -- Add agent as observer
  withAgentCid <- submit owner do
    exerciseCmd holdingCid AddObserver with newObserver = agent

  agentView <- queryContractId agent withAgentCid
  assertMsg "Agent can see asset" (agentView /= None)

-- Negative: cannot lock already-locked asset
testCannotDoubleLockAsset : Script ()
testCannotDoubleLockAsset = script do
  issuer    <- allocateParty "FundIssuer"
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "InstitutionalInvestor"

  holdingCid <- mkAssetHolding issuer custodian owner (AccountId "ACC-DBLLK-001")

  lockedCid <- submit (actAs [owner, custodian]) do
    exerciseCmd holdingCid LockAsset with
      lockRef = "REPO-001"
      lockingParty = custodian

  submitMustFail (actAs [owner, custodian]) do
    exerciseCmd lockedCid LockAsset with
      lockRef = "REPO-002"
      lockingParty = custodian

-- Negative: cannot transfer locked asset
testCannotTransferLockedAsset : Script ()
testCannotTransferLockedAsset = script do
  issuer    <- allocateParty "FundIssuer"
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "InstitutionalInvestor"
  buyer     <- allocateParty "BuyerFund"

  holdingCid <- mkAssetHolding issuer custodian owner (AccountId "ACC-LKTR-001")

  lockedCid <- submit (actAs [owner, custodian]) do
    exerciseCmd holdingCid LockAsset with
      lockRef = "DVP-001"
      lockingParty = custodian

  submitMustFail (actAs [owner, custodian]) do
    exerciseCmd lockedCid TransferAsset with
      newOwner = buyer
      newAccountId = AccountId "ACC-BUYER-LKTR-001"

-- Negative: third party cannot lock asset
testThirdPartyCannotLockAsset : Script ()
testThirdPartyCannotLockAsset = script do
  issuer    <- allocateParty "FundIssuer"
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "InstitutionalInvestor"
  hacker    <- allocateParty "Hacker"

  holdingCid <- mkAssetHolding issuer custodian owner (AccountId "ACC-HACK-001")

  submitMustFail hacker do
    exerciseCmd holdingCid LockAsset with
      lockRef = "STEAL-001"
      lockingParty = hacker

-- ---------------------------------------------------------------------------
-- CashPosition Tests
-- ---------------------------------------------------------------------------

mkCash : Party -> Party -> AccountId -> Amount -> Script (ContractId CashPosition)
mkCash bank owner accId amt = submit (actAs [bank, owner]) do
  createCmd CashPosition with
    bank = bank
    owner = owner
    accountId = accId
    currency = "USD"
    amount = amt
    isLocked = False
    lockReference = None
    lockHolder = None
    observers = []

testCashSplitPreservesAmount : Script ()
testCashSplitPreservesAmount = script do
  bank  <- allocateParty "FederalBank"
  owner <- allocateParty "DealerBankA"

  let initialAmount = 10000000.0
  cashCid <- mkCash bank owner (AccountId "ACC-CASH-001") initialAmount

  (c1Cid, c2Cid) <- submit owner do
    exerciseCmd cashCid SplitCash with splitAmount = 3000000.0

  c1 <- queryContractId owner c1Cid
  c2 <- queryContractId owner c2Cid

  case (c1, c2) of
    (Some p1, Some p2) -> do
      assertMsg "Split piece 1 amount" (p1.amount == 3000000.0)
      assertMsg "Split piece 2 amount" (p2.amount == 7000000.0)
      assertMsg "Total preserved" (p1.amount + p2.amount == initialAmount)
    _ -> abort "Split positions not found"

testCashMergePreservesAmount : Script ()
testCashMergePreservesAmount = script do
  bank  <- allocateParty "FederalBank"
  owner <- allocateParty "DealerBankA"

  c1Cid <- mkCash bank owner (AccountId "ACC-CASH-MERGE-001") 4000000.0
  c2Cid <- mkCash bank owner (AccountId "ACC-CASH-MERGE-001") 6000000.0

  mergedCid <- submit owner do
    exerciseCmd c1Cid MergeCash with otherCid = c2Cid

  mergedData <- queryContractId owner mergedCid
  case mergedData of
    None -> abort "Merged position not found"
    Some p -> do
      assertMsg "Merged amount is 10M" (p.amount == 10000000.0)
      assertMsg "Currency preserved" (p.currency == "USD")

testCashTransfer : Script ()
testCashTransfer = script do
  bank  <- allocateParty "FederalBank"
  alice <- allocateParty "AliceDealer"
  bob   <- allocateParty "BobDealer"

  cashCid <- mkCash bank alice (AccountId "ACC-ALICE-001") 5000000.0

  transferredCid <- submit (actAs [alice, bank, bob]) do
    exerciseCmd cashCid TransferCash with
      newOwner = bob
      newAccountId = AccountId "ACC-BOB-001"
      correlationId = CorrelationId "CORR-TRANSFER-001"

  bobView <- queryContractId bob transferredCid
  case bobView of
    None -> abort "Bob cannot see transferred cash"
    Some p -> do
      assertMsg "Owner is now bob" (p.owner == bob)
      assertMsg "Account updated" (p.accountId == AccountId "ACC-BOB-001")
      assertMsg "Amount preserved" (p.amount == 5000000.0)
      assertMsg "Currency preserved" (p.currency == "USD")

testCashLockAndUnlock : Script ()
testCashLockAndUnlock = script do
  bank  <- allocateParty "FederalBank"
  owner <- allocateParty "DealerBankA"

  cashCid <- mkCash bank owner (AccountId "ACC-LOCK-001") 2000000.0

  -- Lock for DvP
  lockedCid <- submit (actAs [owner, bank]) do
    exerciseCmd cashCid LockCash with lockRef = "DVP-TREASURY-2026-001"; holder = bank

  lockedData <- queryContractId owner lockedCid
  case lockedData of
    None -> abort "Locked cash not found"
    Some p -> do
      assertMsg "Cash is locked" (p.isLocked == True)
      assertMsg "Lock ref set" (p.lockReference == Some "DVP-TREASURY-2026-001")

  -- Unlock after settlement
  unlockedCid <- submit (actAs [owner, bank]) do
    exerciseCmd lockedCid UnlockCash

  unlockedData <- queryContractId owner unlockedCid
  case unlockedData of
    None -> abort "Unlocked cash not found"
    Some p -> do
      assertMsg "Cash is unlocked" (p.isLocked == False)
      assertMsg "Lock ref cleared" (p.lockReference == None)

testCashObserverPrivacy : Script ()
testCashObserverPrivacy = script do
  bank     <- allocateParty "FederalBank"
  owner    <- allocateParty "DealerBankA"
  agent    <- allocateParty "SettlementAgent"
  outsider <- allocateParty "OutsiderCorp"

  cashCid <- mkCash bank owner (AccountId "ACC-PRIV-001") 1000000.0

  -- Outsider cannot see cash position
  outsiderView <- queryContractId outsider cashCid
  assertMsg "Outsider blind to cash" (outsiderView == None)

  -- Add settlement agent
  withAgentCid <- submit owner do
    exerciseCmd cashCid AddCashObserver with newObserver = agent

  agentView <- queryContractId agent withAgentCid
  assertMsg "Agent can see cash" (agentView /= None)

  -- Remove agent
  withoutAgentCid <- submit owner do
    exerciseCmd withAgentCid RemoveCashObserver with observerToRemove = agent

  agentView2 <- queryContractId agent withoutAgentCid
  assertMsg "Agent can no longer see cash" (agentView2 == None)

-- Negative: split amount must be positive
testSplitAmountMustBePositive : Script ()
testSplitAmountMustBePositive = script do
  bank  <- allocateParty "FederalBank"
  owner <- allocateParty "DealerBankA"

  cashCid <- mkCash bank owner (AccountId "ACC-NEGSP-001") 500000.0

  submitMustFail owner do
    exerciseCmd cashCid SplitCash with splitAmount = 0.0

-- Negative: split amount must be less than total
testSplitAmountMustBeLessThanTotal : Script ()
testSplitAmountMustBeLessThanTotal = script do
  bank  <- allocateParty "FederalBank"
  owner <- allocateParty "DealerBankA"

  cashCid <- mkCash bank owner (AccountId "ACC-NEGSP2-001") 500000.0

  submitMustFail owner do
    exerciseCmd cashCid SplitCash with splitAmount = 500000.0  -- equal not allowed

-- Negative: cannot split locked cash
testCannotSplitLockedCash : Script ()
testCannotSplitLockedCash = script do
  bank  <- allocateParty "FederalBank"
  owner <- allocateParty "DealerBankA"

  cashCid <- mkCash bank owner (AccountId "ACC-SPLK-001") 1000000.0

  lockedCid <- submit (actAs [owner, bank]) do
    exerciseCmd cashCid LockCash with lockRef = "LOCK-REF-001"; holder = bank

  submitMustFail owner do
    exerciseCmd lockedCid SplitCash with splitAmount = 200000.0

-- Negative: cannot merge across different currencies
testCannotMergeAcrossCurrencies : Script ()
testCannotMergeAcrossCurrencies = script do
  bank  <- allocateParty "FederalBank"
  owner <- allocateParty "DealerBankA"

  let accId = AccountId "ACC-MULTICURR-001"

  -- Create USD position
  usdCid <- submit (actAs [bank, owner]) do
    createCmd CashPosition with
      bank = bank
      owner = owner
      accountId = accId
      currency = "USD"
      amount = 1000000.0
      isLocked = False
      lockReference = None
      lockHolder = None
      observers = []

  -- Create EUR position at same account (different currency, so different key)
  let eurAccId = AccountId "ACC-MULTICURR-EUR-001"
  eurCid <- submit (actAs [bank, owner]) do
    createCmd CashPosition with
      bank = bank
      owner = owner
      accountId = eurAccId
      currency = "EUR"
      amount = 900000.0
      isLocked = False
      lockReference = None
      lockHolder = None
      observers = []

  -- Attempt to merge USD into EUR — must fail
  submitMustFail owner do
    exerciseCmd usdCid MergeCash with otherCid = eurCid

-- Negative: third party cannot transfer cash
testThirdPartyCannotTransferCash : Script ()
testThirdPartyCannotTransferCash = script do
  bank  <- allocateParty "FederalBank"
  owner <- allocateParty "DealerBankA"
  hacker <- allocateParty "Hacker"

  cashCid <- mkCash bank owner (AccountId "ACC-HACKTR-001") 5000000.0

  submitMustFail hacker do
    exerciseCmd cashCid TransferCash with
      newOwner = hacker
      newAccountId = AccountId "ACC-HACKER-001"
      correlationId = CorrelationId "CORR-STEAL-001"

-- Negative: cannot create cash with zero amount (ensure clause)
testCashEnsurePositiveAmount : Script ()
testCashEnsurePositiveAmount = script do
  bank  <- allocateParty "FederalBank"
  owner <- allocateParty "DealerBankA"

  submitMustFail (actAs [bank, owner]) do
    createCmd CashPosition with
      bank = bank
      owner = owner
      accountId = AccountId "ACC-ZERO-001"
      currency = "USD"
      amount = 0.0      -- ensure clause rejects this
      isLocked = False
      lockReference = None
      lockHolder = None
      observers = []

-- ---------------------------------------------------------------------------
-- Entry Point
-- ---------------------------------------------------------------------------

runAssetCashTests : Script ()
runAssetCashTests = script do
  -- Asset tests
  testAssetLockAndUnlock
  testAssetTransfer
  testAssetObserverManagement
  testCannotDoubleLockAsset
  testCannotTransferLockedAsset
  testThirdPartyCannotLockAsset
  -- Cash tests
  testCashSplitPreservesAmount
  testCashMergePreservesAmount
  testCashTransfer
  testCashLockAndUnlock
  testCashObserverPrivacy
  testSplitAmountMustBePositive
  testSplitAmountMustBeLessThanTotal
  testCannotSplitLockedCash
  testCannotMergeAcrossCurrencies
  testThirdPartyCannotTransferCash
  testCashEnsurePositiveAmount
