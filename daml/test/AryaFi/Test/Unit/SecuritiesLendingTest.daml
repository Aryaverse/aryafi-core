-- | Comprehensive unit and lifecycle tests for SecuritiesLendingAgreement.
module AryaFi.Test.Unit.SecuritiesLendingTest where

import Daml.Script
import AryaFi.Contracts.SecuritiesLending
import AryaFi.Common.Identifiers (AccountId(..), CorrelationId(..), ISIN(..))
import DA.Date (date, Month(..))
import DA.Time (time)

setupParties : Script (Party, Party, Party, Party)
setupParties = do
  lender <- allocateParty "BlackRockFund"
  borrower <- allocateParty "CitadelSecurities"
  custodian <- allocateParty "BNYMellon"
  regulator <- allocateParty "SEC"
  pure (lender, borrower, custodian, regulator)

baseStartDate : Time
baseStartDate = time (date 2026 Sep 1) 9 0 0

baseRecallDeadline : Time
baseRecallDeadline = time (date 2026 Sep 5) 17 0 0

-- ---------------------------------------------------------------------------
-- Positive Lifecycle Tests
-- ---------------------------------------------------------------------------

-- | Test full securities lending lifecycle: origination -> fee accrual -> payment -> recall -> partial return -> close
testSecLendingFullLifecycle : Script ()
testSecLendingFullLifecycle = script do
  (lender, borrower, custodian, regulator) <- setupParties
  setTime baseStartDate

  secLoanCid <- submit (actAs [lender, borrower, custodian]) do
    createCmd SecuritiesLendingAgreement with
      lendingId = "SECLEND-2026-001"
      lender = lender
      borrower = borrower
      custodian = custodian
      isin = ISIN "US0378331005" -- Apple Inc.
      borrowedQuantity = 1000000.0
      borrowAccountId = AccountId "ACC-BORROW-CIT-01"
      lendingFeeRate = 0.0075 -- 75 bps
      rebateRate = 0.045 -- 4.5% rebate on cash collateral
      collateralCurrency = "USD"
      collateralAmount = 150000000.0 -- 150M USD
      collateralPledgeRef = None
      accruedLendingFee = 0.0
      startDate = baseStartDate
      status = LendingActive
      correlationId = CorrelationId "CORR-SECLEND-001"
      observers = []

  -- Check IsLendingActive query
  isActive <- submit lender do
    exerciseCmd secLoanCid IsLendingActive
  assertMsg "Agreement must be active" isActive

  -- 1. Counterparties agree the borrow fee for the month (31,250 USD)
  secLoanCidAccrued <- submit (actAs [lender, borrower]) do
    exerciseCmd secLoanCid AccrueLendingFee with
      additionalFee = 31250.0

  Some loanAccrued <- queryContractId lender secLoanCidAccrued
  assertMsg "Accrued fee must equal 31,250 USD" (loanAccrued.accruedLendingFee == 31250.0)

  -- 2. Lender confirms receipt of the fee payment
  secLoanCidPaid <- submit lender do
    exerciseCmd secLoanCidAccrued PayLendingFee with
      paymentAmount = 31250.0

  Some loanPaid <- queryContractId borrower secLoanCidPaid
  assertMsg "Accrued fee must be zero" (loanPaid.accruedLendingFee == 0.0)

  -- 3. Revalue collateral following market rise (to 155M)
  secLoanCidRevalued <- submit (actAs [lender, borrower]) do
    exerciseCmd secLoanCidPaid RevalueCollateral with
      newCollateralAmount = 155000000.0

  Some loanRevalued <- queryContractId borrower secLoanCidRevalued
  assertMsg "Collateral must equal 155M" (loanRevalued.collateralAmount == 155000000.0)

  -- 4. Lender issues recall for 400,000 shares
  secLoanCidRecalled <- submit lender do
    exerciseCmd secLoanCidRevalued RecallSecurities with
      recallQuantity = 400000.0
      deadline = baseRecallDeadline

  Some loanRecalled <- queryContractId borrower secLoanCidRecalled
  case loanRecalled.status of
    LendingRecallIssued{recallQuantity = qty, recallDeadline = dline} -> do
      assertMsg "Recall quantity must match" (qty == 400000.0)
      assertMsg "Deadline must match" (dline == baseRecallDeadline)
    _ -> assertMsg "Status must be LendingRecallIssued" False

  -- 5. Borrower returns recalled 400,000 shares with 62M collateral release
  secLoanCidPartialReturn <- submit borrower do
    exerciseCmd secLoanCidRecalled ReturnSecurities with
      returnedQuantity = 400000.0
      collateralReleaseAmount = 62000000.0

  Some loanPartial <- queryContractId borrower secLoanCidPartialReturn
  assertMsg "Remaining borrowed must be 600,000" (loanPartial.borrowedQuantity == 600000.0)
  assertMsg "Remaining collateral must be 93M" (loanPartial.collateralAmount == 93000000.0)

  assertMsg "Recall is satisfied, agreement back to Active" (loanPartial.status == LendingActive)

  -- 6. Add regulator as observer (both counterparties consent)
  secLoanCidObserved <- submit (actAs [lender, borrower]) do
    exerciseCmd secLoanCidPartialReturn AddSecLendingObserver with
      newObserver = regulator

  -- 7. Borrower returns final 600,000 shares with remaining 93M collateral release
  secLoanCidClosed <- submit borrower do
    exerciseCmd secLoanCidObserved ReturnSecurities with
      returnedQuantity = 600000.0
      collateralReleaseAmount = 93000000.0

  Some loanFinal <- queryContractId lender secLoanCidClosed
  assertMsg "Status must be LendingClosed" (loanFinal.status == LendingClosed)
  assertMsg "Nothing remains on loan" (loanFinal.borrowedQuantity == 0.0)
  assertMsg "No collateral remains posted" (loanFinal.collateralAmount == 0.0)
  pure ()

-- | Test securities lending default on missed recall
testSecLendingDefaultDeclaration : Script ()
testSecLendingDefaultDeclaration = script do
  (lender, borrower, custodian, _) <- setupParties

  secLoanCid <- submit (actAs [lender, borrower, custodian]) do
    createCmd SecuritiesLendingAgreement with
      lendingId = "SECLEND-DEF-001"
      lender = lender
      borrower = borrower
      custodian = custodian
      isin = ISIN "US0378331005"
      borrowedQuantity = 500000.0
      borrowAccountId = AccountId "ACC-CIT-01"
      lendingFeeRate = 0.01
      rebateRate = 0.04
      collateralCurrency = "USD"
      collateralAmount = 75000000.0
      collateralPledgeRef = None
      accruedLendingFee = 0.0
      startDate = baseStartDate
      status = LendingActive
      correlationId = CorrelationId "CORR-DEF-001"
      observers = []

  -- Lender declares default
  secLoanCidDef <- submit lender do
    exerciseCmd secLoanCid DeclareSecLendingDefault with
      reason = "Counterparty failed to satisfy mandatory recall settlement deadline"

  Some defLoan <- queryContractId lender secLoanCidDef
  case defLoan.status of
    LendingDefaulted reason ->
      assertMsg "Reason must match" (reason == "Counterparty failed to satisfy mandatory recall settlement deadline")
    _ -> assertMsg "Status must be LendingDefaulted" False
  pure ()

-- ---------------------------------------------------------------------------
-- Negative Tests
-- ---------------------------------------------------------------------------

-- | Negative: Borrower cannot issue recall
testUnauthorizedRecallFails : Script ()
testUnauthorizedRecallFails = script do
  (lender, borrower, custodian, _) <- setupParties

  secLoanCid <- submit (actAs [lender, borrower, custodian]) do
    createCmd SecuritiesLendingAgreement with
      lendingId = "SECLEND-UNAUTH-01"
      lender = lender
      borrower = borrower
      custodian = custodian
      isin = ISIN "US0378331005"
      borrowedQuantity = 100000.0
      borrowAccountId = AccountId "ACC-01"
      lendingFeeRate = 0.01
      rebateRate = 0.04
      collateralCurrency = "USD"
      collateralAmount = 15000000.0
      collateralPledgeRef = None
      accruedLendingFee = 0.0
      startDate = baseStartDate
      status = LendingActive
      correlationId = CorrelationId "CORR-UNAUTH-01"
      observers = []

  submitMustFail borrower do
    exerciseCmd secLoanCid RecallSecurities with
      recallQuantity = 50000.0
      deadline = baseRecallDeadline

-- | Negative: Recall quantity exceeding borrowed quantity must fail
testRecallExceedingBorrowedFails : Script ()
testRecallExceedingBorrowedFails = script do
  (lender, borrower, custodian, _) <- setupParties

  secLoanCid <- submit (actAs [lender, borrower, custodian]) do
    createCmd SecuritiesLendingAgreement with
      lendingId = "SECLEND-EXCEED-01"
      lender = lender
      borrower = borrower
      custodian = custodian
      isin = ISIN "US0378331005"
      borrowedQuantity = 100000.0
      borrowAccountId = AccountId "ACC-01"
      lendingFeeRate = 0.01
      rebateRate = 0.04
      collateralCurrency = "USD"
      collateralAmount = 15000000.0
      collateralPledgeRef = None
      accruedLendingFee = 0.0
      startDate = baseStartDate
      status = LendingActive
      correlationId = CorrelationId "CORR-EXCEED-01"
      observers = []

  submitMustFail lender do
    exerciseCmd secLoanCid RecallSecurities with
      recallQuantity = 150000.0 -- Exceeds 100,000
      deadline = baseRecallDeadline

-- | Negative: Releasing more collateral than posted must fail
testExcessCollateralReleaseFails : Script ()
testExcessCollateralReleaseFails = script do
  (lender, borrower, custodian, _) <- setupParties

  secLoanCid <- submit (actAs [lender, borrower, custodian]) do
    createCmd SecuritiesLendingAgreement with
      lendingId = "SECLEND-COLLAT-FAIL"
      lender = lender
      borrower = borrower
      custodian = custodian
      isin = ISIN "US0378331005"
      borrowedQuantity = 100000.0
      borrowAccountId = AccountId "ACC-01"
      lendingFeeRate = 0.01
      rebateRate = 0.04
      collateralCurrency = "USD"
      collateralAmount = 15000000.0
      collateralPledgeRef = None
      accruedLendingFee = 0.0
      startDate = baseStartDate
      status = LendingActive
      correlationId = CorrelationId "CORR-FAIL-01"
      observers = []

  submitMustFail borrower do
    exerciseCmd secLoanCid ReturnSecurities with
      returnedQuantity = 50000.0
      collateralReleaseAmount = 20000000.0 -- Exceeds 15,000,000

-- | Helper: an Active agreement with 100,000 shares on loan against 15M collateral.
mkAgreement : Party -> Party -> Party -> Decimal -> Script (ContractId SecuritiesLendingAgreement)
mkAgreement lender borrower custodian fee =
  submit (actAs [lender, borrower, custodian]) do
    createCmd SecuritiesLendingAgreement with
      lendingId = "SECLEND-HELPER-01"
      lender = lender
      borrower = borrower
      custodian = custodian
      isin = ISIN "US0378331005"
      borrowedQuantity = 100000.0
      borrowAccountId = AccountId "ACC-01"
      lendingFeeRate = 0.01
      rebateRate = 0.04
      collateralCurrency = "USD"
      collateralAmount = 15000000.0
      collateralPledgeRef = None
      accruedLendingFee = fee
      startDate = baseStartDate
      status = LendingActive
      correlationId = CorrelationId "CORR-HELPER-01"
      observers = []

-- | A full return while fees are outstanding records a true zero quantity
-- (no phantom 0.01 units); the agreement closes once the lender confirms the fee.
testFullReturnWithFeesOutstanding : Script ()
testFullReturnWithFeesOutstanding = script do
  (lender, borrower, custodian, _) <- setupParties
  secLoanCid <- mkAgreement lender borrower custodian 2500.0

  returnedCid <- submit borrower do
    exerciseCmd secLoanCid ReturnSecurities with
      returnedQuantity = 100000.0
      collateralReleaseAmount = 15000000.0

  Some returned <- queryContractId lender returnedCid
  assertMsg "Borrowed quantity must be exactly zero" (returned.borrowedQuantity == 0.0)
  assertMsg "Collateral must be exactly zero" (returned.collateralAmount == 0.0)
  assertMsg "Agreement stays open while fees are owed" (returned.status == LendingActive)

  closedCid <- submit lender do
    exerciseCmd returnedCid PayLendingFee with paymentAmount = 2500.0
  Some closed <- queryContractId lender closedCid
  assertMsg "Agreement closes once the last fee is confirmed" (closed.status == LendingClosed)

-- | Negative: the borrower cannot strip collateral by returning a token quantity,
-- and cannot confirm its own fee payment.
testBorrowerCannotReduceOwnObligations : Script ()
testBorrowerCannotReduceOwnObligations = script do
  (lender, borrower, custodian, _) <- setupParties
  secLoanCid <- mkAgreement lender borrower custodian 2500.0

  -- Returning 1 share cannot release all 15M of collateral
  submitMustFail borrower do
    exerciseCmd secLoanCid ReturnSecurities with
      returnedQuantity = 1.0
      collateralReleaseAmount = 15000000.0

  submitMustFail borrower do
    exerciseCmd secLoanCid PayLendingFee with paymentAmount = 2500.0

  submitMustFail lender do
    exerciseCmd secLoanCid AccrueLendingFee with additionalFee = 1000000.0

-- | A partial return under recall reduces the outstanding recall quantity
-- instead of silently cancelling the recall.
testPartialReturnKeepsRecall : Script ()
testPartialReturnKeepsRecall = script do
  (lender, borrower, custodian, _) <- setupParties
  setTime baseStartDate
  secLoanCid <- mkAgreement lender borrower custodian 0.0

  recalledCid <- submit lender do
    exerciseCmd secLoanCid RecallSecurities with
      recallQuantity = 60000.0
      deadline = baseRecallDeadline

  partialCid <- submit borrower do
    exerciseCmd recalledCid ReturnSecurities with
      returnedQuantity = 20000.0
      collateralReleaseAmount = 3000000.0

  Some partial <- queryContractId lender partialCid
  case partial.status of
    LendingRecallIssued{recallQuantity = qty, recallDeadline = dline} -> do
      assertMsg "40,000 shares remain recalled" (qty == 40000.0)
      assertMsg "Deadline unchanged" (dline == baseRecallDeadline)
    _ -> abort "Recall must remain in force after a partial return"
