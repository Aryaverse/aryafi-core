module AryaFi.Test.Negative.ComplianceViolationTest where

import Daml.Script
import AryaFi.Compliance.Eligibility
import AryaFi.Common.Policies

negativeEligibilityRejection : Script ()
negativeEligibilityRejection = script do
  complianceOfficer <- allocateParty "ComplianceOfficer"

  policyCid <- submit complianceOfficer do
    createCmd EligibilityPolicy with
      policyManager = complianceOfficer
      policyName = "US-Approved-Collateral"
      allowedJurisdictions = ["US", "GB"]
      allowedAssetClasses = ["DebtSecurity", "CashAsset"]
      minCreditRating = "AA"
      isActive = True

  decision <- submit complianceOfficer do
    exerciseCmd policyCid EvaluateEligibility with
      targetJurisdiction = "NK" -- Unauthorized jurisdiction
      targetAssetClass = "DebtSecurity"

  case decision of
    Rejected _ -> pure ()
    _ -> abort "Expected eligibility rejection for restricted jurisdiction"
