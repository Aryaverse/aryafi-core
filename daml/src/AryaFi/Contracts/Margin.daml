module AryaFi.Contracts.Margin where

import AryaFi.Common.Types (Amount, Currency)
import AryaFi.Common.Identifiers (ReferenceId)

-- | Margin call status.
data MarginCallStatus
  = MarginCalled
  | MarginMet
  | MarginDisputed
  | MarginDefaulted
  deriving (Eq, Show)

-- | Institutional Variation / Initial Margin Call Template.
template MarginCall
  with
    marginCallId : ReferenceId
    caller : Party
    payer : Party
    currency : Currency
    requiredAmount : Amount
    deadline : Time
    status : MarginCallStatus
  where
    signatory caller, payer

    choice FulfillMarginCall : ContractId MarginCall
      controller payer
      do
        create this with status = MarginMet

    choice DisputeMarginCall : ContractId MarginCall
      with
        disputeReason : Text
      controller payer
      do
        create this with status = MarginDisputed
