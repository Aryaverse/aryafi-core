-- | Multi-party conditional escrow contract for AryaFi financial workflows.
-- ConditionalEscrow holds assets pending satisfaction of a release condition
-- agreed between the escrow agent and both depositor and beneficiary.
--
-- Lifecycle:
--   EscrowHeld → EscrowReleased  (agent + beneficiary: condition met)
--              | EscrowRefunded  (agent + depositor: return funds)
--              | EscrowExpired   (post-deadline, agent triggers)
--              | EscrowDisputed  (agent freezes pending resolution)
-- EscrowExpired → EscrowRefunded (depositor claims refund after expiry)
-- EscrowDisputed → EscrowReleased | EscrowRefunded | EscrowHeld (agent resolves dispute)
--
-- An escrow can hold the deposited cash itself. It is created
-- EscrowAwaitingDeposit, and the depositor deposits with DepositIntoEscrow:
-- the amount of one of its cash positions is locked to the escrow agent
-- through the bank's transfer factory, and the escrow holds the locked
-- position. Releasing it delivers the position to the beneficiary's account;
-- refunding it unlocks it for the depositor. Until then neither the depositor
-- nor the beneficiary can move it; the agent, as the lock holder, releases it
-- together with the beneficiary, or refunds it.
module AryaFi.Contracts.Escrow where

import qualified Splice.Api.Token.HoldingV2 as HoldingV2
import AryaFi.Common.Types (Amount, Currency)
import AryaFi.Common.Identifiers (AccountId(..), ReferenceId, CorrelationId)
import AryaFi.Common.Errors (require, requireNonEmpty)
import DA.Action (when)
import DA.Optional (isSome)
import AryaFi.Finance.Encumbrance (unencumber)
import AryaFi.Finance.TokenRegistry (deliverLocked)
import AryaFi.Finance.TokenTransfer (PositionTransferFactory, LockPosition(..))

-- ---------------------------------------------------------------------------
-- Escrow Status
-- ---------------------------------------------------------------------------

-- | Escrow lifecycle states.
data EscrowStatus
  = EscrowHeld
    -- ^ Assets are held in escrow pending the release condition.
  | EscrowReleased
    -- ^ Release condition was met; assets delivered to beneficiary.
  | EscrowRefunded
    -- ^ Condition not met or agreement to abort; assets returned to depositor.
  | EscrowExpired
    -- ^ Escrow expiry time has passed without release; eligible for refund.
  | EscrowDisputed
    -- ^ A dispute has been raised; escrow is frozen pending resolution.
  | EscrowAwaitingDeposit
    -- ^ Agreed; awaiting the depositor's deposit (DepositIntoEscrow).
  deriving (Eq, Show)

-- | The result of a deposit: the escrow, and the rest of the depositor's
-- position, unlocked, if it held more than the escrowed amount.
data EscrowDeposited = EscrowDeposited
  with
    escrowCid : ContractId ConditionalEscrow
    changeCid : Optional (ContractId HoldingV2.Holding)
  deriving (Eq, Show)

-- ---------------------------------------------------------------------------
-- ConditionalEscrow Template
-- ---------------------------------------------------------------------------

-- | Multi-party conditional escrow contract.
--
-- Dual-signatory creation: escrow agent + depositor co-sign.
-- Beneficiary is an observer (cannot control, but has visibility).
--
-- Release requires both agent and beneficiary authorization.
-- Refund requires both agent and depositor authorization.
-- Expiry and dispute management are agent-only.
template ConditionalEscrow
  with
    escrowId : ReferenceId
    -- ^ Unique identifier for this escrow arrangement.
    escrowAgent : Party
    -- ^ Independent escrow agent controlling release and refund.
    depositor : Party
    -- ^ Party depositing assets into escrow.
    beneficiary : Party
    -- ^ Intended recipient of assets if the release condition is met.
    currency : Currency
    -- ^ Currency of the escrowed amount.
    amount : Amount
    -- ^ Amount held in escrow.
    releaseCondition : Text
    -- ^ Human-readable description of the release condition.
    expiryTime : Time
    -- ^ Absolute ledger time after which the escrow expires.
    correlationId : CorrelationId
    -- ^ Correlation ID linking to the underlying transaction or agreement.
    status : EscrowStatus
    -- ^ Current lifecycle status of this escrow.
    disputeReason : Optional Text
    -- ^ Populated when status = EscrowDisputed.
    observers : [Party]
    -- ^ Additional observers (e.g. regulator, auditor).
    escrowedHoldingCid : Optional (ContractId HoldingV2.Holding)
    -- ^ The deposit, while the escrow holds it: the depositor's cash
    --   position, locked to the escrow agent.
    beneficiaryAccountId : Optional AccountId
    -- ^ The beneficiary's account at the bank, where a released deposit is
    --   delivered. Needed before the depositor can deposit.
  where
    signatory escrowAgent, depositor
    observer beneficiary :: observers

    ensure amount > 0.0

    -- | Depositor deposits the escrowed amount: `amount` of its cash position
    -- `holdingCid`, in `accountId` at the bank whose transfer factory is
    -- `factoryCid`, is locked to the escrow agent, and the escrow holds it.
    choice DepositIntoEscrow : EscrowDeposited
      with
        factoryCid : ContractId PositionTransferFactory
        holdingCid : ContractId HoldingV2.Holding
        accountId : AccountId
      controller depositor
      do
        require (status == EscrowAwaitingDeposit) "Escrow must be AwaitingDeposit to deposit"
        require (isSome beneficiaryAccountId)
          "Escrow deposit: name the beneficiary's account (beneficiaryAccountId) first"
        locked <- exercise factoryCid LockPosition with
          owner = depositor; holdingCid; accountId = unAccountId accountId; instrumentId = currency
          amount; holder = escrowAgent; reference = "Escrow " <> escrowId
        escrowCid <- create this with status = EscrowHeld; escrowedHoldingCid = Some locked.lockedCid
        pure EscrowDeposited with escrowCid; changeCid = locked.changeCid

    -- | Release escrowed assets to beneficiary (both agent and beneficiary must agree).
    -- A deposit the escrow holds is delivered to the beneficiary's account.
    choice ReleaseEscrow : ContractId ConditionalEscrow
      controller escrowAgent, beneficiary
      do
        require (status == EscrowHeld)
          "Escrow must be Held to release"
        case (escrowedHoldingCid, beneficiaryAccountId) of
          (Some cid, Some (AccountId account)) -> do
            _ <- deliverLocked cid beneficiary account
            pure ()
          (Some _, None) -> abort "Escrow release: the beneficiary's account is not named"
          (None, _) -> pure ()
        create this with status = EscrowReleased; escrowedHoldingCid = None

    -- | Refund escrowed assets to depositor (both agent and depositor must agree).
    -- Also valid when escrow is in Expired state. A deposit the escrow holds
    -- is unlocked for the depositor.
    choice RefundEscrow : ContractId ConditionalEscrow
      controller escrowAgent, depositor
      do
        require (status == EscrowHeld || status == EscrowExpired)
          "Escrow must be Held or Expired to refund"
        refundDeposit escrowedHoldingCid
        create this with status = EscrowRefunded; escrowedHoldingCid = None

    -- | Expire the escrow after the expiry time has passed.
    -- Can only be triggered by the escrow agent once ledger time exceeds expiryTime.
    -- An escrow still awaiting its deposit can expire too.
    choice ExpireEscrow : ContractId ConditionalEscrow
      controller escrowAgent
      do
        require (status == EscrowHeld || status == EscrowAwaitingDeposit)
          "Escrow must be Held or AwaitingDeposit to expire"
        now <- getTime
        require (now >= expiryTime)
          "Escrow expiry time has not yet passed"
        create this with status = EscrowExpired

    -- | Raise a dispute on this escrow (freezes it pending agent resolution).
    -- Used when either party contests the release condition outcome.
    choice DisputeEscrow : ContractId ConditionalEscrow
      with
        reason : Text
      controller escrowAgent
      do
        require (status == EscrowHeld)
          "Escrow must be Held to raise a dispute"
        requireNonEmpty reason "reason"
        create this with
          status = EscrowDisputed
          disputeReason = Some reason

    -- | Escrow agent resolves an active dispute, deciding whether to release
    -- or refund, or dismissing it (EscrowHeld). A deposit the escrow holds is
    -- unlocked for the depositor on a refund; it can only be released with the
    -- beneficiary, so the agent dismisses the dispute and releases it with
    -- ReleaseEscrow.
    choice ResolveDispute : ContractId ConditionalEscrow
      with
        resolutionStatus : EscrowStatus
      controller escrowAgent
      do
        require (status == EscrowDisputed)
          "Escrow must be Disputed to resolve"
        require
          (resolutionStatus `elem` [EscrowReleased, EscrowRefunded, EscrowHeld])
          "Resolution must be Released, Refunded, or Held"
        require (not (resolutionStatus == EscrowReleased && isSome escrowedHoldingCid))
          "Escrow release: a deposit is released with the beneficiary; resolve the dispute to Held, then ReleaseEscrow"
        when (resolutionStatus == EscrowRefunded) (refundDeposit escrowedHoldingCid)
        create this with
          status = resolutionStatus
          disputeReason = None
          escrowedHoldingCid = if resolutionStatus == EscrowHeld then escrowedHoldingCid else None

    -- | Add an observer to this escrow (e.g. regulator, auditor).
    choice AddEscrowObserver : ContractId ConditionalEscrow
      with
        newObserver : Party
      controller escrowAgent
      do
        require (newObserver `notElem` observers) "Party is already an observer"
        create this with observers = newObserver :: observers

    -- | Nonconsuming query: has this escrow reached a terminal state?
    nonconsuming choice IsEscrowTerminal : Bool
      controller escrowAgent
      do
        pure (status `notElem` [EscrowHeld, EscrowDisputed, EscrowAwaitingDeposit])

-- | Unlock a deposit the escrow holds for the depositor. Needs the escrow
-- agent's authority, as the lock holder.
refundDeposit : Optional (ContractId HoldingV2.Holding) -> Update ()
refundDeposit None = pure ()
refundDeposit (Some cid) = do
  _ <- unencumber cid
  pure ()

