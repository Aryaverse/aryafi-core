-- | Institutional Asset & Fund Redemption Contract for AryaFi core.
--
-- Supports open-ended fund, private credit, and tokenized vehicle redemptions:
--   - Redemption request with LP unit accounting
--   - Official NAV pricing and net payout calculation with redemption fee deduction
--   - Liquidity gate mechanisms (e.g. fund-level capacity gates or suspension)
--   - Custodian execution of cash redemption payout
--   - Multi-party oversight (GP, LP, Custodian, Administrator, Regulators)
--
-- A redemption with the ISIN of the fund's units (unitIsin) settles on the
-- ledger. The fund manager pays the net payout with a token-standard transfer
-- of cash to the investor, and the custodian, which keeps the fund's units,
-- settles it with SettleRedemption: the redeemed units are burnt from the
-- investor's unit holdings and the investor receives the cash, in one
-- transaction. ExecuteRedemptionSettlement records a payout made elsewhere.
module AryaFi.Contracts.Redemption where

import qualified Splice.Api.Token.HoldingV2 as HoldingV2
import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Splice.Api.Token.TransferInstructionV2 (TransferInstruction)
import AryaFi.Common.Types (Amount, Currency)
import AryaFi.Common.Identifiers (ISIN(..), ReferenceId, CorrelationId)
import AryaFi.Common.Errors (require, requirePositive, requireNonEmpty)
import AryaFi.Contracts.FinancingLegs (acceptIncoming, incomingTransfer)
import AryaFi.Finance.TokenRegistry
import DA.Action (when)
import DA.Foldable (mapA_)
import DA.Optional (fromSome)
import qualified DA.List as List

-- | Redemption status states.
data RedemptionStatus
  = RedemptionRequested
    -- ^ Investor submitted redemption request for specified units.
  | RedemptionApproved Amount
    -- ^ Fund manager approved request at struck NAV per unit.
  | RedemptionGated Text
    -- ^ Liquidity gate applied by fund manager with stated reason.
  | RedemptionSettled with
      paymentReference : ReferenceId
      -- ^ Payment reference of the cash payout.
      netPayout : Amount
      -- ^ Net amount paid to the investor.
    -- ^ Cash redemption payout settled by custodian with payment reference and net amount.
  | RedemptionRejected Text
    -- ^ Rejected by fund manager with stated reason.
  | RedemptionCancelled Text
    -- ^ Cancelled by investor prior to approval.
  deriving (Eq, Show)

-- | Fund or asset redemption request contract.
template AssetRedemption
  with
    redemptionId : ReferenceId
    -- ^ Unique identifier for this redemption request.
    fundManager : Party
    -- ^ Fund manager / General Partner.
    investor : Party
    -- ^ Redeeming institutional investor / Limited Partner.
    custodian : Party
    -- ^ Fund custodian / paying agent bank.
    fundId : ReferenceId
    -- ^ Target fund or vehicle identifier.
    fundName : Text
    -- ^ Name of the investment fund.
    unitsToRedeem : Amount
    -- ^ Number of units / shares being redeemed.
    currency : Currency
    -- ^ Payout settlement currency.
    struckNavPerUnit : Optional Amount
    -- ^ Official NAV per unit applied upon approval.
    settlementPayout : Optional Amount
    -- ^ Net monetary payout owed after fee deduction.
    redemptionFeeRate : Amount
    -- ^ Contractual redemption / early-exit fee rate (e.g. 0.01 for 1%).
    requestDate : Time
    -- ^ Inception timestamp of redemption request.
    settlementDate : Optional Time
    -- ^ Date when payout was settled.
    status : RedemptionStatus
    -- ^ Current lifecycle status.
    correlationId : CorrelationId
    -- ^ Cross-system correlation identifier.
    observers : [Party]
    -- ^ Authorized observers (e.g. fund administrator, transfer agent, regulators).
    unitIsin : Optional ISIN
    -- ^ The ISIN of the fund's units, which the custodian keeps. With it, the
    --   redemption settles on the ledger (SettleRedemption).
  where
    signatory fundManager, investor
    observer (List.dedup (custodian :: observers))

    ensure
      unitsToRedeem > 0.0 &&
      redemptionFeeRate >= 0.0 && redemptionFeeRate < 1.0 &&
      redemptionId /= ""

    -- | Fund Manager approves redemption request and strikes official NAV pricing.
    choice ApproveRedemption : ContractId AssetRedemption
      with
        officialNav : Amount
      controller fundManager
      do
        require (status == RedemptionRequested) "Only requested redemptions can be approved"
        requirePositive officialNav "officialNav"

        let grossPayout = unitsToRedeem * officialNav
        let feeAmount = grossPayout * redemptionFeeRate
        let netPayout = grossPayout - feeAmount

        create this with
          struckNavPerUnit = Some officialNav
          settlementPayout = Some netPayout
          status = RedemptionApproved officialNav

    -- | Fund Manager applies liquidity gate to redemption request.
    choice ApplyLiquidityGate : ContractId AssetRedemption
      with
        gateReason : Text
      controller fundManager
      do
        require (status == RedemptionRequested) "Only requested redemptions can be gated"
        requireNonEmpty gateReason "gateReason"
        create this with
          status = RedemptionGated gateReason

    -- | Fund Manager releases liquidity gate, returning request to active evaluation.
    choice ReleaseLiquidityGate : ContractId AssetRedemption
      controller fundManager
      do
        require (isGated status) "Redemption must be Gated to release"
        create this with
          status = RedemptionRequested

    -- | Fund Manager rejects redemption request.
    choice RejectRedemption : ContractId AssetRedemption
      with
        reason : Text
      controller fundManager
      do
        require (status == RedemptionRequested || isGated status)
          "Can only reject requested or gated redemptions"
        requireNonEmpty reason "reason"
        create this with
          status = RedemptionRejected reason

    -- | Custodian executes cash payout and finalizes redemption settlement.
    -- The settlement date is the current ledger time.
    choice ExecuteRedemptionSettlement : ContractId AssetRedemption
      with
        paymentRef : ReferenceId
      controller custodian
      do
        require (isApproved status) "Redemption must be Approved to execute settlement"
        requireNonEmpty paymentRef "paymentRef"
        let payout = fromSome settlementPayout
        now <- getTime

        create this with
          settlementDate = Some now
          status = RedemptionSettled with paymentReference = paymentRef; netPayout = payout

    -- | Custodian settles an approved redemption on the ledger: the investor
    -- accepts the fund manager's pending token-standard transfer of the net
    -- payout, and the redeemed units are burnt from the investor's unit
    -- holdings `unitHoldingCids`, with any rest returned to the investor, in
    -- one transaction. If the cash registry refuses the transfer on
    -- acceptance, no units are burnt and the redemption is unchanged.
    choice SettleRedemption : ContractId AssetRedemption
      with
        paymentRef : ReferenceId
        instructionCid : ContractId TransferInstruction
        extraArgs : ExtraArgs
        unitHoldingCids : [ContractId HoldingV2.Holding]
      controller custodian
      do
        require (isApproved status) "Redemption must be Approved to execute settlement"
        requireNonEmpty paymentRef "paymentRef"
        isin <- case unitIsin of
          Some isin -> pure isin
          None -> abort "Redemption: the redemption has no unit ISIN to burn"
        let payout = fromSome settlementPayout
        transfer <- incomingTransfer "Redemption payout" instructionCid fundManager investor currency
        require (transfer.amount == payout)
          ("Redemption payout: " <> show transfer.amount <> " is not the net payout of " <> show payout)
        received <- acceptIncoming instructionCid investor extraArgs
        if not received then create this else do
          burnUnits this isin unitHoldingCids
          now <- getTime
          create this with
            settlementDate = Some now
            status = RedemptionSettled with paymentReference = paymentRef; netPayout = payout

    -- | Investor cancels redemption request prior to manager approval.
    choice CancelRedemption : ContractId AssetRedemption
      with
        reason : Text
      controller investor
      do
        require (status == RedemptionRequested || isGated status)
          "Can only cancel pending or gated redemption"
        requireNonEmpty reason "reason"
        create this with
          status = RedemptionCancelled reason

    -- | Add authorized observer (e.g. transfer agent).
    choice AddRedemptionObserver : ContractId AssetRedemption
      with
        newObserver : Party
      controller fundManager
      do
        require (not (newObserver `elem` observers)) "Observer already registered"
        create this with
          observers = newObserver :: observers

    -- | Nonconsuming query to check if redemption is settled.
    nonconsuming choice IsRedemptionSettled : Bool
      controller fundManager
      do
        case status of
          RedemptionSettled{} -> return True
          _ -> return False

-- | Helper to test if status is approved.
isApproved : RedemptionStatus -> Bool
isApproved (RedemptionApproved _) = True
isApproved _ = False

-- | Helper to test if status is gated.
isGated : RedemptionStatus -> Bool
isGated (RedemptionGated _) = True
isGated _ = False


-- | Burn the redeemed units from the investor's unit holdings at the
-- custodian, returning any rest to the investor. Needs the authority of the
-- custodian and the investor.
burnUnits : AssetRedemption -> ISIN -> [ContractId HoldingV2.Holding] -> Update ()
burnUnits r isin cids = do
  first <- case cids of
    cid :: _ -> positionView <$> fetchPosition cid
    [] -> abort "Redemption: name the unit holdings to redeem"
  require (first.account.owner == Some r.investor) "Redemption: the unit holdings are not the investor's"
  require (first.instrumentId == HoldingV2.InstrumentId with admin = r.custodian; id = unISIN isin)
    "Redemption: the holdings are not the fund's units at the custodian"
  (like, rest) <- fundingPositions first.account first.instrumentId cids
  let positions = like :: rest
      total = sum [(positionView p).amount | p <- positions]
  require (total >= r.unitsToRedeem)
    ("Redemption: the unit holdings total " <> show total <> ", less than " <> show r.unitsToRedeem)
  mapA_ archivePosition positions
  when (total > r.unitsToRedeem) do
    _ <- createPosition like r.investor first.account.id (total - r.unitsToRedeem) None
      (positionObservers like)
    pure ()
