module AryaFi.Contracts.ReverseRepo where

import AryaFi.Contracts.Repo (RepoAgreement)

-- | Reverse Repo wrapper / counterparty composition interface.
template ReverseRepoPosition
  with
    buyer : Party
    seller : Party
    repoContractId : ContractId RepoAgreement
  where
    signatory buyer
    observer seller
