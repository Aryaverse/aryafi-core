-- | Institutional Securities Lending Contract Interface.
--
-- Implements institutional stock loan and bond borrowing workflows:
--   - Borrow fee accrual agreed by both counterparties, payment confirmed by lender
--   - Collateralization with Cash or AssetPledge linkage
--   - Full or partial recall options with contractual deadline
--   - Return of securities; collateral released at most pro rata
--   - Mark-to-market collateral revaluation
--
-- Signatory model: lender + borrower + custodian tri-party agreement.
-- Authorization principle: the borrower can never reduce its own obligations
-- (fees are confirmed paid by the lender; collateral release is capped pro rata).
--
-- Delivery and returns can settle on the ledger as token-standard DvPs, with
-- the custodian as settlement agent (see AryaFi.Contracts.FinancingLegs). An
-- agreement created as LendingPendingDelivery is delivered with the
-- securities going to the borrower against its cash collateral going to the
-- lender, and becomes Active as they move. A return delivers securities back
-- against the release of cash collateral, within the pro-rata cap. An
-- agreement created Active, and ReturnSecurities, record movements settled
-- elsewhere.
module AryaFi.Contracts.SecuritiesLending where

import AryaFi.Common.Types (Amount, Currency, Rate)
import AryaFi.Common.Identifiers (ISIN(..), AccountId(..), ReferenceId, CorrelationId, TradeId(..))
import AryaFi.Common.Errors (require, requirePositive, requireNonEmpty)
import AryaFi.Contracts.FinancingLegs
import AryaFi.Finance.TokenDvp (RegistryBatch, TokenDvpAllocationRequest, TokenDvpInstruction(..))
import qualified DA.Text as Text
import qualified DA.List as List

-- | Lifecycle states of a Securities Lending arrangement.
data SecLendingStatus
  = LendingActive
    -- ^ Loan active and operational; securities delivered to borrower.
  | LendingRecallIssued with
      recallQuantity : Amount
      -- ^ Quantity still to be returned under the recall.
      recallDeadline : Time
      -- ^ Contractual deadline for returning the recalled quantity.
    -- ^ Lender has issued a recall for specified quantity with cutoff deadline.
  | LendingClosed
    -- ^ All borrowed securities returned and collateral released.
  | LendingDefaulted Text
    -- ^ Default declared (e.g. failure to return recalled securities).
  | LendingPendingDelivery
    -- ^ Agreed; awaiting delivery of the securities against the collateral
    --   (RequestDelivery, SettleDelivery).
  deriving (Eq, Show)

-- | Institutional Securities Lending Agreement.
template SecuritiesLendingAgreement
  with
    lendingId : ReferenceId
    -- ^ Unique identifier for this securities lending agreement.
    lender : Party
    -- ^ Beneficial owner / lender of securities.
    borrower : Party
    -- ^ Broker-dealer / borrower of securities.
    custodian : Party
    -- ^ Custodian safekeeping the lent securities and collateral.
    isin : ISIN
    -- ^ ISIN of the lent security.
    borrowedQuantity : Amount
    -- ^ Quantity of securities currently on loan (zero once fully returned).
    borrowAccountId : AccountId
    -- ^ Account where securities are delivered.
    lendingFeeRate : Rate
    -- ^ Annual borrow fee rate (e.g. 0.0075 for 75 bps).
    rebateRate : Rate
    -- ^ Annual rebate rate paid back to borrower on cash collateral.
    collateralCurrency : Currency
    -- ^ Denominated currency of the collateral.
    collateralAmount : Amount
    -- ^ Current posted collateral amount.
    collateralPledgeRef : Optional ReferenceId
    -- ^ Optional link to AssetPledge contract for non-cash collateral.
    accruedLendingFee : Amount
    -- ^ Unpaid accrued lending fee balance.
    startDate : Time
    -- ^ Trade inception date.
    status : SecLendingStatus
    -- ^ Current lifecycle status.
    correlationId : CorrelationId
    -- ^ Cross-system correlation identifier.
    observers : [Party]
    -- ^ Authorized observers (e.g. agent lenders, regulators).
  where
    signatory lender, borrower, custodian
    observer (List.dedup observers)

    -- An open agreement always has securities on loan or fees outstanding;
    -- quantities are never padded to satisfy the invariant.
    ensure
      borrowedQuantity >= 0.0 &&
      collateralAmount >= 0.0 &&
      lendingFeeRate >= 0.0 &&
      rebateRate >= 0.0 &&
      accruedLendingFee >= 0.0 &&
      (not (isOpen status) || borrowedQuantity > 0.0 || accruedLendingFee > 0.0) &&
      lendingId /= ""

    -- | Record borrow fees for an elapsed period. Both counterparties must agree
    -- the amount, so neither can unilaterally change what the borrower owes.
    choice AccrueLendingFee : ContractId SecuritiesLendingAgreement
      with
        additionalFee : Amount
      controller lender, borrower
      do
        require (isOpen status)
          "Lending agreement must be Active or under Recall to accrue fees"
        requirePositive additionalFee "additionalFee"
        create this with
          accruedLendingFee = accruedLendingFee + additionalFee

    -- | Lender confirms receipt of a lending fee payment from the borrower.
    -- Closes the agreement if nothing remains on loan and no fees are owed.
    choice PayLendingFee : ContractId SecuritiesLendingAgreement
      with
        paymentAmount : Amount
      controller lender
      do
        require (isOpen status) "Agreement must be Active or under Recall to record fee payments"
        requirePositive paymentAmount "paymentAmount"
        require (paymentAmount <= accruedLendingFee) "Payment exceeds accrued fee balance"
        let newFee = accruedLendingFee - paymentAmount
        create this with
          accruedLendingFee = newFee
          status = if borrowedQuantity == 0.0 && newFee == 0.0 then LendingClosed else status

    -- | Lender issues a formal recall for partial or full lent securities.
    choice RecallSecurities : ContractId SecuritiesLendingAgreement
      with
        recallQuantity : Amount
        deadline : Time
      controller lender
      do
        require (status == LendingActive) "Agreement must be Active to issue recall"
        requirePositive recallQuantity "recallQuantity"
        require (recallQuantity <= borrowedQuantity) "Recall quantity exceeds borrowed balance"
        now <- getTime
        require (deadline > now) "Recall deadline must be in the future"
        create this with
          status = LendingRecallIssued with recallQuantity; recallDeadline = deadline

    -- | Borrower returns securities, releasing collateral.
    -- Collateral release is capped pro rata: the collateral left must still
    -- cover the securities left on loan at the current collateral ratio.
    -- A partial return under recall reduces the outstanding recall quantity;
    -- the recall stays in force until the recalled quantity is returned.
    -- Auto-transitions to LendingClosed if all borrowed securities and fees are discharged.
    choice ReturnSecurities : ContractId SecuritiesLendingAgreement
      with
        returnedQuantity : Amount
        collateralReleaseAmount : Amount
      controller borrower
      do
        checkReturn this returnedQuantity collateralReleaseAmount
        create (afterReturn this returnedQuantity collateralReleaseAmount)

    -- | Custodian asks for the delivery as a token-standard DvP: the borrowed
    -- securities from the lender to the borrower's borrowAccountId, against
    -- the cash collateral from the borrower to the lender at `bank`.
    nonconsuming choice RequestDelivery : LegRequested
      with
        bank : Party
        -- ^ The bank that keeps the cash collateral.
        accounts : ExchangeAccounts
        -- ^ The accounts; the borrower receives the securities in borrowAccountId.
        settleBefore : Time
      controller custodian
      do
        require (status == LendingPendingDelivery) "Agreement must be PendingDelivery to request delivery"
        require (accounts.receiverSecurities == unAccountId borrowAccountId)
          "The securities are delivered to the borrow account"
        requestExchange (deliveryExchange this) bank accounts settleBefore

    -- | Custodian settles the delivery's DvP, and the agreement becomes
    -- Active, in one transaction.
    choice SettleDelivery : ContractId SecuritiesLendingAgreement
      with
        dvpCid : ContractId TokenDvpInstruction
        batches : [RegistryBatch]
        openRequests : [ContractId TokenDvpAllocationRequest]
      controller custodian
      do
        require (status == LendingPendingDelivery) "Agreement must be PendingDelivery to settle delivery"
        _ <- settleExchange (deliveryExchange this) dvpCid batches openRequests
        create this with status = LendingActive

    -- | Custodian asks for a return as a token-standard DvP: `returnedQuantity`
    -- of the securities from the borrower to the lender, against
    -- `collateralReleaseAmount` of cash collateral from the lender back to the
    -- borrower at `bank`, within the pro-rata cap. `returnRef` names this
    -- return, so each return has its own settlement ID.
    nonconsuming choice RequestReturn : LegRequested
      with
        returnRef : Text
        returnedQuantity : Amount
        collateralReleaseAmount : Amount
        bank : Party
        accounts : ExchangeAccounts
        settleBefore : Time
      controller custodian
      do
        requireNonEmpty returnRef "returnRef"
        checkReturn this returnedQuantity collateralReleaseAmount
        require (collateralReleaseAmount > 0.0)
          "A return that releases no collateral is a plain transfer: record it with ReturnSecurities"
        requestExchange (returnExchange this returnRef returnedQuantity collateralReleaseAmount) bank accounts settleBefore

    -- | Custodian settles a return's DvP, and the agreement records the return
    -- as with ReturnSecurities, in one transaction.
    choice SettleReturn : ContractId SecuritiesLendingAgreement
      with
        dvpCid : ContractId TokenDvpInstruction
        batches : [RegistryBatch]
        openRequests : [ContractId TokenDvpAllocationRequest]
      controller custodian
      do
        dvp <- fetch dvpCid
        let prefix = returnTradeIdPrefix this
            TradeId tradeId = dvp.tradeId
            returnedQuantity = dvp.delivery.leg.amount
            collateralReleaseAmount = dvp.payment.leg.amount
        require (prefix `Text.isPrefixOf` tradeId) "The DvP is not a return of this agreement"
        checkReturn this returnedQuantity collateralReleaseAmount
        let returnRef = Text.drop (Text.length prefix) tradeId
        _ <- settleExchange (returnExchange this returnRef returnedQuantity collateralReleaseAmount)
          dvpCid batches openRequests
        create (afterReturn this returnedQuantity collateralReleaseAmount)

    -- | Mark-to-market collateral adjustment agreed between counterparties.
    choice RevalueCollateral : ContractId SecuritiesLendingAgreement
      with
        newCollateralAmount : Amount
      controller lender, borrower
      do
        require (isOpen status) "Agreement must be Active or under Recall to revalue collateral"
        requirePositive newCollateralAmount "newCollateralAmount"
        create this with
          collateralAmount = newCollateralAmount

    -- | Lender declares default upon failure to satisfy recall deadline.
    choice DeclareSecLendingDefault : ContractId SecuritiesLendingAgreement
      with
        reason : Text
      controller lender
      do
        require (isOpen status) "Can only declare default on an Active or Recalled agreement"
        requireNonEmpty reason "reason"
        create this with
          status = LendingDefaulted reason

    -- | Add authorized observer. Both counterparties must consent to disclosure.
    choice AddSecLendingObserver : ContractId SecuritiesLendingAgreement
      with
        newObserver : Party
      controller lender, borrower
      do
        require (not (newObserver `elem` observers)) "Observer already registered"
        create this with
          observers = newObserver :: observers

    -- | Nonconsuming query to check if agreement is active.
    nonconsuming choice IsLendingActive : Bool
      controller lender
      do
        return (status == LendingActive)

-- | Helper to check if agreement is in recall status.
isRecallIssued : SecLendingStatus -> Bool
isRecallIssued LendingRecallIssued{} = True
isRecallIssued _ = False

-- | Whether the agreement is open (Active or under Recall).
isOpen : SecLendingStatus -> Bool
isOpen s = s == LendingActive || isRecallIssued s


-- | Check a return of `returnedQuantity` releasing `collateralReleaseAmount`:
-- the agreement is open, the quantity is on loan, and the release is within
-- the posted collateral and the pro-rata share of the returned securities.
checkReturn : SecuritiesLendingAgreement -> Amount -> Amount -> Update ()
checkReturn this returnedQuantity collateralReleaseAmount = do
  require (isOpen this.status)
    "Agreement must be Active or under Recall to return securities"
  requirePositive returnedQuantity "returnedQuantity"
  require (returnedQuantity <= this.borrowedQuantity) "Return quantity exceeds borrowed quantity"
  require (collateralReleaseAmount >= 0.0) "Collateral release must be non-negative"
  require (collateralReleaseAmount <= this.collateralAmount) "Collateral release exceeds posted collateral"
  let newBorrowed = this.borrowedQuantity - returnedQuantity
      newCollateral = this.collateralAmount - collateralReleaseAmount
  require (newCollateral * this.borrowedQuantity >= this.collateralAmount * newBorrowed)
    "Collateral release exceeds the pro-rata share of the returned securities"

-- | The agreement after a return. A partial return under recall reduces the
-- outstanding recall quantity; nothing left on loan and no fees owed closes it.
afterReturn : SecuritiesLendingAgreement -> Amount -> Amount -> SecuritiesLendingAgreement
afterReturn this returnedQuantity collateralReleaseAmount =
  let newBorrowed = this.borrowedQuantity - returnedQuantity
      newStatus = case this.status of
        _ | newBorrowed == 0.0 && this.accruedLendingFee == 0.0 -> LendingClosed
        LendingRecallIssued{recallQuantity, recallDeadline}
          | recallQuantity > returnedQuantity && newBorrowed > 0.0 ->
              LendingRecallIssued with recallQuantity = recallQuantity - returnedQuantity; recallDeadline
        _ -> LendingActive
  in this with
       borrowedQuantity = newBorrowed
       collateralAmount = this.collateralAmount - collateralReleaseAmount
       status = newStatus

-- | The delivery: the borrowed securities from the lender to the borrower,
-- against the cash collateral.
deliveryExchange : SecuritiesLendingAgreement -> Exchange
deliveryExchange this = Exchange with
  agent = this.custodian
  tradeId = this.lendingId <> "-DELIVERY"
  deliverer = this.lender
  receiver = this.borrower
  custodian = this.custodian
  instrument = unISIN this.isin
  quantity = this.borrowedQuantity
  currency = this.collateralCurrency
  cashAmount = this.collateralAmount

-- | The settlement IDs of the agreement's returns start with this.
returnTradeIdPrefix : SecuritiesLendingAgreement -> Text
returnTradeIdPrefix this = this.lendingId <> "-RETURN-"

-- | A return: securities from the borrower to the lender, against the
-- release of cash collateral from the lender to the borrower.
returnExchange : SecuritiesLendingAgreement -> Text -> Amount -> Amount -> Exchange
returnExchange this returnRef returnedQuantity collateralReleaseAmount = Exchange with
  agent = this.custodian
  tradeId = returnTradeIdPrefix this <> returnRef
  deliverer = this.borrower
  receiver = this.lender
  custodian = this.custodian
  instrument = unISIN this.isin
  quantity = returnedQuantity
  currency = this.collateralCurrency
  cashAmount = collateralReleaseAmount
