-- | Institutional Fund Subscription and Capital Commitment Contract for AryaFi core.
--
-- Supports Private Credit, Private Equity, and Tokenized Fund capital lifecycles:
--   - LP Capital commitment tracking and approval
--   - Incremental capital calls issued by the General Partner (Fund Manager)
--   - Custodian-verified capital funding settlement and LP unit allocation
--   - Multi-party oversight (GP, LP, Custodian, Administrator, Regulator)
--
-- A subscription with the ISIN of the fund's units (unitIsin) settles its
-- capital calls on the ledger. The investor pays a call with a token-standard
-- transfer of cash to the fund manager, and the custodian, which keeps the
-- fund's units, settles it with SettleCapitalCall: the fund manager receives
-- the cash and the investor receives the units it buys at the unit price, in
-- one transaction. ConfirmCapitalFunding records a payment made elsewhere.
module AryaFi.Contracts.Subscription where

import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Splice.Api.Token.TransferInstructionV2 (TransferInstruction)
import AryaFi.Common.Types (Amount, Currency)
import AryaFi.Common.Identifiers (AccountId(..), ISIN, ReferenceId, CorrelationId)
import AryaFi.Common.Errors (require, requirePositive, requireNonEmpty)
import AryaFi.Contracts.FinancingLegs (acceptIncoming, incomingTransfer)
import AryaFi.Finance.Security (InstrumentType(..))
import AryaFi.Finance.TokenRegistry (InstrumentDetails(..), createFromDetails)
import qualified DA.List as List

-- | Lifecycle states of a fund / private credit subscription.
data SubscriptionStatus
  = SubscriptionRequested
    -- ^ Investor submitted subscription request; awaiting manager review.
  | SubscriptionApproved
    -- ^ Fund manager approved commitment; ready for capital calls.
  | SubscriptionPartiallyFunded
    -- ^ Partial capital call funded; remaining commitment remains callable.
  | SubscriptionFullyFunded
    -- ^ 100% of committed capital called and funded.
  | SubscriptionCancelled Text
    -- ^ Cancelled by investor prior to approval or by mutual agreement.
  | SubscriptionRejected Text
    -- ^ Rejected by fund manager with compliance or capacity reason.
  | SubscriptionClosed
    -- ^ Commitment period concluded or position closed.
  deriving (Eq, Show)

-- | Investor Subscription Agreement for institutional funds / private credit.
template FundSubscription
  with
    subscriptionId : ReferenceId
    -- ^ Unique identifier for this subscription arrangement.
    fundManager : Party
    -- ^ Fund manager / General Partner (GP).
    investor : Party
    -- ^ Institutional limited partner / investor (LP).
    custodian : Party
    -- ^ Fund custodian / depositary bank.
    fundId : ReferenceId
    -- ^ Unique identifier of the target fund or vehicle.
    fundName : Text
    -- ^ Name of the investment fund or vehicle.
    currency : Currency
    -- ^ Commitment denominated currency (e.g. "USD", "EUR").
    committedAmount : Amount
    -- ^ Total capital committed by investor.
    calledAmount : Amount
    -- ^ Cumulative capital called to date.
    fundedAmount : Amount
    -- ^ Cumulative capital funded and settled.
    unitsIssued : Amount
    -- ^ Fund units / LP shares issued to investor.
    unitPrice : Amount
    -- ^ Issue price per unit / NAV per share.
    status : SubscriptionStatus
    -- ^ Current lifecycle status.
    rejectionReason : Optional Text
    -- ^ Reason for rejection if applicable.
    correlationId : CorrelationId
    -- ^ Master correlation identifier across booking systems.
    observers : [Party]
    -- ^ Authorized observers (e.g. fund administrator, transfer agent, regulators).
    unitIsin : Optional ISIN
    -- ^ The ISIN of the fund's units, which the custodian keeps. With it,
    --   capital calls settle on the ledger (SettleCapitalCall).
  where
    signatory fundManager, investor
    observer (List.dedup (custodian :: observers))

    ensure
      committedAmount > 0.0 &&
      calledAmount >= 0.0 && calledAmount <= committedAmount &&
      fundedAmount >= 0.0 && fundedAmount <= calledAmount &&
      unitsIssued >= 0.0 &&
      unitPrice > 0.0 &&
      subscriptionId /= ""

    -- | Fund Manager approves investor subscription.
    choice ApproveSubscription : ContractId FundSubscription
      controller fundManager
      do
        require (status == SubscriptionRequested) "Only requested subscriptions can be approved"
        create this with
          status = SubscriptionApproved

    -- | Fund Manager rejects subscription with stated reason.
    choice RejectSubscription : ContractId FundSubscription
      with
        reason : Text
      controller fundManager
      do
        require (status == SubscriptionRequested) "Only requested subscriptions can be rejected"
        requireNonEmpty reason "reason"
        create this with
          status = SubscriptionRejected reason
          rejectionReason = Some reason

    -- | Fund Manager issues an incremental capital call against uncalled commitment.
    choice IssueCapitalCall : ContractId FundSubscription
      with
        callAmount : Amount
      controller fundManager
      do
        require (status == SubscriptionApproved || status == SubscriptionPartiallyFunded)
          "Subscription must be Approved or PartiallyFunded to call capital"
        requirePositive callAmount "callAmount"
        require (calledAmount + callAmount <= committedAmount)
          "Capital call exceeds uncalled commitment"
        create this with
          calledAmount = calledAmount + callAmount

    -- | Custodian confirms settlement of called capital and allocates units.
    choice ConfirmCapitalFunding : ContractId FundSubscription
      with
        paymentRef : ReferenceId
        fundedPaymentAmount : Amount
        newUnitsAllocated : Amount
      controller custodian
      do
        require (status == SubscriptionApproved || status == SubscriptionPartiallyFunded)
          "Subscription must be in callable state to confirm funding"
        requirePositive fundedPaymentAmount "fundedPaymentAmount"
        requireNonEmpty paymentRef "paymentRef"
        require (fundedAmount + fundedPaymentAmount <= calledAmount)
          "Funded amount cannot exceed called capital"

        let newFunded = fundedAmount + fundedPaymentAmount
        let newUnits = unitsIssued + newUnitsAllocated
        let newStatus = if newFunded == committedAmount
                          then SubscriptionFullyFunded
                          else SubscriptionPartiallyFunded

        create this with
          fundedAmount = newFunded
          unitsIssued = newUnits
          status = newStatus

    -- | Custodian settles a capital call payment on the ledger: it accepts the
    -- investor's pending token-standard transfer of cash to the fund manager,
    -- and issues the units the payment buys at the unit price to the
    -- investor's `unitsAccountId`, in one transaction. If the cash registry
    -- refuses the transfer on acceptance, nothing is issued and the
    -- subscription is unchanged.
    choice SettleCapitalCall : ContractId FundSubscription
      with
        instructionCid : ContractId TransferInstruction
        extraArgs : ExtraArgs
        unitsAccountId : AccountId
      controller custodian
      do
        require (status == SubscriptionApproved || status == SubscriptionPartiallyFunded)
          "Subscription must be in callable state to confirm funding"
        isin <- case unitIsin of
          Some isin -> pure isin
          None -> abort "Capital call: the subscription has no unit ISIN to issue"
        transfer <- incomingTransfer "Capital call payment" instructionCid investor fundManager currency
        require (fundedAmount + transfer.amount <= calledAmount)
          "Funded amount cannot exceed called capital"
        received <- acceptIncoming instructionCid fundManager extraArgs
        if not received then create this else do
          let units = transfer.amount / unitPrice
              newFunded = fundedAmount + transfer.amount
          _ <- createFromDetails custodian (fundUnits isin fundName) investor (unAccountId unitsAccountId) units
          create this with
            fundedAmount = newFunded
            unitsIssued = unitsIssued + units
            status = if newFunded == committedAmount then SubscriptionFullyFunded else SubscriptionPartiallyFunded

    -- | Investor cancels request prior to manager approval.
    choice CancelSubscription : ContractId FundSubscription
      with
        reason : Text
      controller investor
      do
        require (status == SubscriptionRequested) "Can only cancel pending subscription request"
        requireNonEmpty reason "reason"
        create this with
          status = SubscriptionCancelled reason

    -- | Fund Manager formally closes subscription upon end of fund commitment period.
    choice CloseSubscription : ContractId FundSubscription
      controller fundManager
      do
        require (status == SubscriptionFullyFunded || status == SubscriptionPartiallyFunded)
          "Can only close funded subscription"
        create this with
          status = SubscriptionClosed

    -- | Add authorized observer (e.g. transfer agent).
    choice AddSubscriptionObserver : ContractId FundSubscription
      with
        newObserver : Party
      controller fundManager
      do
        require (not (newObserver `elem` observers)) "Observer already registered"
        create this with
          observers = newObserver :: observers

    -- | Nonconsuming query to check if commitment remains active.
    nonconsuming choice IsSubscriptionActive : Bool
      controller fundManager
      do
        return (status == SubscriptionApproved || status == SubscriptionPartiallyFunded || status == SubscriptionFullyFunded)


-- | The instrument details of a fund's units, kept by its custodian.
fundUnits : ISIN -> Text -> InstrumentDetails
fundUnits isin fundName = SecurityDetails with
  isin
  cusip = None
  instrumentName = fundName
  instrumentType = FundUnit
  couponRate = None
  couponType = None
  dayCountConvention = None
  maturityDate = None
  seniority = None
