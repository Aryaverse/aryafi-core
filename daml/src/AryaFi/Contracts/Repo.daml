module AryaFi.Contracts.Repo where

import AryaFi.Common.Types (Amount, Currency, Rate, LifecycleStatus(..))
import AryaFi.Common.Identifiers (ISIN, ReferenceId)

-- | Institutional Repurchase Agreement (Repo) Contract Interface.
template RepoAgreement
  with
    repoId : ReferenceId
    seller : Party  -- Cash borrower / Security seller
    buyer : Party   -- Cash lender / Security buyer
    tripartyAgent : Optional Party
    isin : ISIN
    collateralQuantity : Amount
    currency : Currency
    purchasePrice : Amount
    repurchasePrice : Amount
    repoRate : Rate
    startDate : Time
    endDate : Time
    status : LifecycleStatus
  where
    signatory seller, buyer

    choice CloseoutRepo : ContractId RepoAgreement
      controller seller, buyer
      do
        create this with status = Closed

    choice DeclareRepoDefault : ContractId RepoAgreement
      with
        reason : Text
      controller buyer
      do
        create this with status = Defaulted
