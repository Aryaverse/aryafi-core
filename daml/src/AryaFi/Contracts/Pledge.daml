module AryaFi.Contracts.Pledge where

import AryaFi.Common.Types (Amount, LifecycleStatus(..))
import AryaFi.Common.Identifiers (AccountId, ReferenceId)

-- | Pledged asset / security interest contract.
template AssetPledge
  with
    pledgeId : ReferenceId
    pledgor : Party
    pledgee : Party
    custodian : Party
    accountId : AccountId
    assetId : ReferenceId
    quantity : Amount
    perfectionReference : Text
    status : LifecycleStatus
  where
    signatory pledgor, pledgee, custodian

    controller pledgee can
      ReleasePledge : ContractId AssetPledge
        do
          create this with status = Closed

      EnforcePledge : ContractId AssetPledge
        do
          create this with status = Defaulted
