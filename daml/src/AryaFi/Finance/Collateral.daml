-- | Collateral position and allocation model for AryaFi financing contracts.
-- CollateralPosition tracks an asset that has been allocated as collateral
-- against a specific financial obligation (repo, loan, margin requirement).
-- It maintains real-time valuation, haircut, and eligibility status,
-- and provides controlled choices for substitution, revaluation, and release.
--
-- Usage pattern:
--   1. Provider, receiver, and custodian create an Allocated CollateralPosition.
--   2. The provider locks its security position to the receiver with
--      LockCollateralHolding, which activates the collateral. (Without it, the
--      custodian activates the collateral with ActivateCollateral once the
--      asset is locked by other means, and the position is referenced only by
--      its lockReference.)
--   3. The financing contract references the CollateralPosition by contract ID.
--   4. Releasing the collateral unlocks the position for the provider;
--      liquidating it delivers the position to the receiver's account; a
--      substitution locks the new asset's position and unlocks the old one.
module AryaFi.Finance.Collateral where

import DA.Foldable (forA_, mapA_)
import qualified Splice.Api.Token.HoldingV2 as HoldingV2
import AryaFi.Common.Types (Amount, Rate, Currency, AssetClass)
import AryaFi.Common.Identifiers (AccountId(..), ISIN(..), ExternalRef)
import AryaFi.Common.Errors (require, requirePositive, requireNonNegative)
import AryaFi.Finance.Encumbrance
import AryaFi.Finance.TokenRegistry (deliverLocked)

-- ---------------------------------------------------------------------------
-- Collateral Status State Machine
-- ---------------------------------------------------------------------------

-- | Lifecycle state of a collateral position.
-- Transitions: Allocated → Active ⇄ Substituted ⇄ InDispute → Released | Liquidated
-- Active and Substituted are both "live" states (see isLiveCollateral).
data CollateralStatus
  = Allocated
    -- ^ Collateral has been designated but the underlying asset is not yet locked.
  | Active
    -- ^ Collateral is locked, valued, and fulfilling its obligation.
  | Substituted
    -- ^ Collateral is live and has been replaced at least once with a different
    --   eligible asset. Behaves like Active for all further lifecycle actions.
  | Released
    -- ^ Collateral has been released; the underlying asset is unlocked.
  | Liquidated
    -- ^ Collateral was liquidated following an event of default.
  | InDispute
    -- ^ A valuation dispute has been raised and is pending resolution.
  deriving (Eq, Ord, Show)

-- | Whether collateral in this status is live (securing an obligation and
-- open to revaluation, substitution, dispute, release, or liquidation).
isLiveCollateral : CollateralStatus -> Bool
isLiveCollateral s = s == Active || s == Substituted

-- | The result of locking a collateral asset.
data CollateralLocked = CollateralLocked
  with
    collateralCid : ContractId CollateralPosition
    -- ^ The collateral, now Active and holding the locked position.
    changeCid : Optional (ContractId HoldingV2.Holding)
    -- ^ What the holding held beyond the quantity, back with the provider.
  deriving (Eq, Show)

-- ---------------------------------------------------------------------------
-- CollateralPosition Template
-- ---------------------------------------------------------------------------

-- | Tracks an asset allocated as collateral against a financial obligation.
--
-- Tri-party signatory model: collateralProvider + collateralReceiver + custodian.
-- This ensures all three operational parties acknowledge the encumbrance.
--
-- Haircut model:
--   collateralValue = marketValue × (1 - haircut)
--   Required: collateralValue >= obligationAmount
--
-- Privacy: all three signatories see this contract.
-- Observers can be added for tri-party agents, regulators, or trade repositories.
template CollateralPosition
  with
    collateralProvider : Party
    -- ^ Party providing the collateral (e.g. borrower in a repo).
    collateralReceiver : Party
    -- ^ Party receiving and holding the benefit of the collateral (e.g. lender).
    custodian : Party
    -- ^ Custodian safekeeping the collateral asset.
    accountId : AccountId
    -- ^ Account where the collateral asset is held.
    assetClass : AssetClass
    -- ^ Asset class for eligibility and reporting categorization.
    isin : ISIN
    -- ^ ISIN of the underlying collateral asset.
    quantity : Amount
    -- ^ Quantity of the collateral asset (face value or units).
    marketValue : Amount
    -- ^ Current market value of the full quantity in settlement currency.
    haircut : Rate
    -- ^ Haircut rate as a decimal fraction (e.g. 0.02 = 2%). Applied to market value.
    settlementCurrency : Currency
    -- ^ Currency in which market value and collateral value are expressed.
    obligationRef : Text
    -- ^ Reference to the financing obligation this collateral secures
    --   (e.g. contract ID of the RepoAgreement or InstitutionalLoan).
    lockReference : Text
    -- ^ Lock reference on the underlying SecurityPosition or AssetHolding.
    status : CollateralStatus
    -- ^ Current lifecycle status of this collateral allocation.
    externalRef : Optional ExternalRef
    -- ^ Tri-party or CSD system reference for this collateral position.
    observers : [Party]
    -- ^ Observers with read access (e.g. tri-party agent, trade repository).
    lockedHoldingCid : Optional (ContractId HoldingV2.Holding)
    -- ^ The collateral asset's security position, locked to the receiver,
    --   once the provider has locked it (LockCollateralHolding).
  where
    signatory collateralProvider, collateralReceiver, custodian
    observer observers

    ensure quantity > 0.0
        && marketValue > 0.0
        && haircut >= 0.0 && haircut < 1.0

    -- | Compute the post-haircut collateral value.
    -- collateralValue = marketValue × (1 - haircut)
    nonconsuming choice GetCollateralValue : Amount
      controller custodian
      do
        pure (marketValue * (1.0 - haircut))

    -- | Revalue the collateral position to reflect current market prices.
    -- Used for daily mark-to-market and margin call triggers.
    -- Only the custodian (as the independent valuation agent) can revalue.
    choice RevalueCollateral : ContractId CollateralPosition
      with
        newMarketValue : Amount
        newQuantity : Amount
      controller custodian
      do
        require (status == Allocated || isLiveCollateral status)
          "Can only revalue Allocated, Active, or Substituted collateral"
        requirePositive newMarketValue "newMarketValue"
        requirePositive newQuantity "newQuantity"
        require (lockedHoldingCid == None || newQuantity == quantity)
          "The collateral holds a locked position: substitute it to change the quantity"
        create this with
          marketValue = newMarketValue
          quantity = newQuantity

    -- | Substitute the collateral with a different eligible asset.
    -- Both provider and receiver must authorize substitution to ensure the
    -- replacement asset satisfies eligibility criteria agreed in the schedule.
    -- Status transitions to Substituted to record the event; the position
    -- stays live and can be substituted, disputed, released, or liquidated again.
    choice SubstituteCollateral : ContractId CollateralPosition
      with
        newIsin : ISIN
        newQuantity : Amount
        newMarketValue : Amount
        newHaircut : Rate
        newAssetClass : AssetClass
        newLockReference : Text
        newHoldingCid : Optional (ContractId HoldingV2.Holding)
        -- ^ The new asset's position in the collateral account, of exactly
        --   newQuantity, to lock in place of the locked one.
      controller collateralProvider, collateralReceiver
      do
        require (isLiveCollateral status) "Substitution only allowed on Active or Substituted collateral"
        requirePositive newQuantity "newQuantity"
        requirePositive newMarketValue "newMarketValue"
        requireNonNegative newHaircut "newHaircut"
        require (newHaircut < 1.0) "Haircut must be less than 100%"
        require (lockedHoldingCid == None || newHoldingCid /= None)
          "The collateral holds a locked position: give the new asset's position to substitute it"
        let replaced = this with isin = newIsin; quantity = newQuantity; lockReference = newLockReference
        newLocked <- case newHoldingCid of
          None -> pure None
          Some cid -> do
            (lockedCid, changeCid) <- lockCollateral replaced cid
            require (changeCid == None) "The new asset's position must be exactly the new quantity"
            pure (Some lockedCid)
        mapA_ unencumber lockedHoldingCid
        create this with
          isin = newIsin
          quantity = newQuantity
          marketValue = newMarketValue
          haircut = newHaircut
          assetClass = newAssetClass
          lockReference = newLockReference
          status = Substituted
          lockedHoldingCid = newLocked

    -- | Provider locks the collateral asset to the receiver, which activates
    -- the collateral: `holdingCid` must be its unlocked security position of
    -- the ISIN in the collateral account at the custodian, of at least the
    -- quantity. The quantity is locked under lockReference, and any more goes
    -- back to the provider.
    choice LockCollateralHolding : CollateralLocked
      with
        holdingCid : ContractId HoldingV2.Holding
      controller collateralProvider
      do
        require (status == Allocated) "Can only lock the asset of Allocated collateral"
        require (lockReference /= "") "The collateral needs a lockReference to lock its asset under"
        (lockedCid, changeCid) <- lockCollateral this holdingCid
        collateralCid <- create this with
          status = Active
          lockedHoldingCid = Some lockedCid
        pure CollateralLocked with collateralCid; changeCid

    -- | Activate collateral after the underlying asset has been confirmed locked.
    -- Transitions from Allocated → Active.
    choice ActivateCollateral : ContractId CollateralPosition
      controller custodian
      do
        require (status == Allocated) "Can only activate Allocated collateral"
        create this with status = Active

    -- | Release this collateral position. Called when the secured obligation
    -- is discharged or the financing contract is terminated.
    -- Both provider and receiver must agree to release. A locked position is
    -- unlocked for the provider.
    choice ReleaseCollateral : ContractId CollateralPosition
      controller collateralProvider, collateralReceiver
      do
        require (isLiveCollateral status)
          "Can only release Active or Substituted collateral"
        mapA_ unencumber lockedHoldingCid
        create this with
          status = Released
          lockedHoldingCid = None

    -- | Liquidate collateral following an event of default.
    -- Only the collateral receiver can initiate liquidation. A locked position
    -- is delivered to the receiver's `liquidationAccountId` at the custodian.
    choice LiquidateCollateral : ContractId CollateralPosition
      with
        liquidationAccountId : Optional AccountId
        -- ^ The receiver's account for the locked position, if there is one.
      controller collateralReceiver
      do
        require (isLiveCollateral status)
          "Can only liquidate Active or Substituted collateral"
        forA_ lockedHoldingCid \cid -> case liquidationAccountId of
          Some (AccountId account) -> deliverLocked cid collateralReceiver account
          None -> abort "The collateral holds a locked position: name the receiver's account to deliver it to"
        create this with
          status = Liquidated
          lockedHoldingCid = None

    -- | Raise a valuation dispute on this collateral position.
    -- Raised by the collateral provider against the custodian's valuation.
    -- Moves status to InDispute.
    choice RaiseValuationDispute : ContractId CollateralPosition
      controller collateralProvider
      do
        require (isLiveCollateral status) "Can only raise dispute on Active or Substituted collateral"
        create this with status = InDispute

    -- | Resolve a valuation dispute and return collateral to Active with
    -- agreed market value.
    choice ResolveDispute : ContractId CollateralPosition
      with
        agreedMarketValue : Amount
      controller collateralProvider, collateralReceiver
      do
        require (status == InDispute) "Can only resolve InDispute collateral"
        requirePositive agreedMarketValue "agreedMarketValue"
        create this with
          marketValue = agreedMarketValue
          status = Active

    -- | Add an observer (e.g. tri-party agent, regulator, trade repository).
    choice AddCollateralObserver : ContractId CollateralPosition
      with
        newObserver : Party
      controller collateralProvider, collateralReceiver
      do
        require (newObserver `notElem` observers) "Party is already an observer"
        create this with observers = newObserver :: observers

-- | Lock the collateral's quantity of the provider's position `holdingCid` to
-- the receiver, and return the locked position and any change.
lockCollateral
  : CollateralPosition -> ContractId HoldingV2.Holding
  -> Update (ContractId HoldingV2.Holding, Optional (ContractId HoldingV2.Holding))
lockCollateral collateral = encumber Encumbrance with
  owner = collateral.collateralProvider
  keeper = collateral.custodian
  accountId = unAccountId collateral.accountId
  instrumentId = unISIN collateral.isin
  amount = collateral.quantity
  holder = collateral.collateralReceiver
  reference = collateral.lockReference
  label = "Collateral holding"
