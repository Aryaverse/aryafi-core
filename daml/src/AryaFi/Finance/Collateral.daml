module AryaFi.Finance.Collateral where

import AryaFi.Common.Types (Amount, Rate)
import AryaFi.Common.Identifiers (AccountId, ReferenceId)

-- | Status of pledged or allocated collateral.
data CollateralStatus
  = CollateralAllocated
  | CollateralPledged
  | CollateralSubstituted
  | CollateralReleased
  | CollateralLiquidated
  deriving (Eq, Show)

-- | Collateral allocation and valuation position.
template CollateralPosition
  with
    collateralProvider : Party
    collateralReceiver : Party
    custodian : Party
    accountId : AccountId
    assetId : ReferenceId
    quantity : Amount
    marketValue : Amount
    haircut : Rate
    status : CollateralStatus
  where
    signatory collateralProvider, collateralReceiver, custodian

    controller collateralProvider, collateralReceiver can
      ReleaseCollateral : ContractId CollateralPosition
        do
          create this with status = CollateralReleased

      SubstituteCollateral : ContractId CollateralPosition
        with
          newAssetId : ReferenceId
          newQuantity : Amount
          newMarketValue : Amount
        do
          create this with
            assetId = newAssetId
            quantity = newQuantity
            marketValue = newMarketValue
            status = CollateralSubstituted
