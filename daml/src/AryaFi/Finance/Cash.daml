-- | Tokenized cash position representing an institutional deposit, tokenized
-- fiat currency, or central bank money balance on the AryaFi platform.
--
-- CashPosition is the primary settlement currency primitive. It supports:
--   - Atomic split (one position → two positions, total preserved)
--   - Atomic merge (two positions → one, total preserved)
--   - Authorized transfer to a new owner / account (the receiver must authorize)
--   - Locking to a named lock holder (e.g. a DvP settlement agent), who alone
--     can release the lock or settle the position to a counterparty
--
-- All operations preserve the fundamental invariant:
--   ∀ op on position p: sum of resulting amounts == sum of inputs
--
-- Design note: CashPosition intentionally does NOT model bank ledger entries
-- or fractional reserve money. It models a specific on-ledger tokenized claim.
module AryaFi.Finance.Cash where

import AryaFi.Common.Identifiers (AccountId, CorrelationId)
import AryaFi.Common.Types (Amount, Currency)
import AryaFi.Common.Errors (require, requirePositive, requireNonEmpty)
import DA.Optional (fromOptional, optionalToList)

-- ---------------------------------------------------------------------------
-- CashPosition Template
-- ---------------------------------------------------------------------------

-- | Tokenized cash position held at an institutional bank or custody account.
--
-- Dual signatory model: bank (issuer and settlement authority) and owner.
-- The bank co-authorizes: locking and direct transfers.
-- The owner controls: split, merge, and observer management.
-- A lock holder, once named, alone controls release of the lock and
-- settlement of the locked position to a counterparty.
--
-- No contract key: a holding is fungible and an account may hold any number of
-- positions in the same currency (e.g. after SplitCash).
--
-- Privacy: bank, owner, and the current lock holder see this position.
-- Observers are cleared whenever ownership changes.
template CashPosition
  with
    bank : Party
    -- ^ The issuing bank or central bank acting as the tokenized cash authority.
    owner : Party
    -- ^ Beneficial owner of this cash position with withdrawal rights.
    accountId : AccountId
    -- ^ Account this position belongs to.
    currency : Currency
    -- ^ ISO 4217 currency code (e.g. "USD", "EUR", "GBP").
    amount : Amount
    -- ^ Cash amount in the smallest logical unit (e.g. dollars with decimal cents).
    isLocked : Bool
    -- ^ Whether this position is locked (encumbered for settlement or collateral).
    lockReference : Optional Text
    -- ^ Reference to the contract or instruction that holds this lock.
    lockHolder : Optional Party
    -- ^ Party holding the lock (e.g. the DvP settlement agent). Only this party
    --   can unlock the position or settle it to a counterparty while locked.
    observers : [Party]
    -- ^ Parties with read access (e.g. settlement agents, DvP counterparties).
  where
    signatory bank, owner
    observer observers, optionalToList lockHolder

    ensure amount > 0.0 && isLocked == (lockHolder /= None)

    -- | Split this position into two positions, preserving total amount.
    -- Used for: staging settlement legs, allocating margin amounts,
    -- separating specific payment tranches.
    -- The original position is archived; two new positions are created.
    -- Neither sub-position is locked; they inherit the currency and account.
    --
    -- Preconditions:
    --   - Position must not be locked.
    --   - splitAmount must be strictly positive and strictly less than total amount.
    choice SplitCash : (ContractId CashPosition, ContractId CashPosition)
      with
        splitAmount : Amount
      controller owner
      do
        require (not isLocked) "Cannot split a locked cash position"
        requirePositive splitAmount "splitAmount"
        require (splitAmount < amount)
          ("Split amount " <> show splitAmount <> " must be less than total " <> show amount)
        c1 <- create this with amount = splitAmount
        c2 <- create this with amount = amount - splitAmount
        pure (c1, c2)

    -- | Merge another cash position into this one, producing a single combined position.
    -- The other position is archived. The result inherits this position's account and currency.
    -- Both positions must have the same bank, owner, account, and currency.
    -- Neither position may be locked.
    choice MergeCash : ContractId CashPosition
      with
        otherCid : ContractId CashPosition
      controller owner
      do
        require (not isLocked) "Cannot merge: this position is locked"
        other <- fetch otherCid
        require (other.bank     == bank)     "Cannot merge: bank mismatch"
        require (other.owner    == owner)    "Cannot merge: owner mismatch"
        require (other.accountId == accountId) "Cannot merge: account mismatch"
        require (other.currency == currency)  "Cannot merge: currency mismatch"
        require (not other.isLocked) "Cannot merge: other position is locked"
        archive otherCid
        create this with amount = amount + other.amount

    -- | Transfer this cash position to a new owner and account at the same bank.
    -- The original position is archived; a new position is created for the receiver.
    -- Position must not be locked. Requires joint authorization of owner, bank,
    -- and the receiver (who becomes a signatory of the new position).
    -- Observers are cleared so the previous owner's viewers do not follow the cash.
    --
    -- For exchange against another asset, lock the position to a settlement
    -- agent and settle through DvpInstruction.
    choice TransferCash : ContractId CashPosition
      with
        newOwner : Party
        newAccountId : AccountId
        correlationId : CorrelationId
      controller owner, bank, newOwner
      do
        require (not isLocked) "Cannot transfer a locked cash position"
        require (newOwner /= owner) "New owner must be different from current owner"
        create this with
          owner = newOwner
          accountId = newAccountId
          observers = []

    -- | Lock this cash position to a lock holder, preventing split, merge, or transfer.
    -- Used when: staging a DvP, posting as margin, entering escrow.
    -- Requires joint authorization of owner and bank to prevent unilateral freezing.
    -- From this point only the lock holder can release or settle the position,
    -- so neither owner nor bank can withdraw it from an agreed settlement.
    choice LockCash : ContractId CashPosition
      with
        lockRef : Text
        -- ^ Reference to the contract or process holding this cash (e.g. DvP trade ID).
        holder : Party
        -- ^ Party that will hold the lock (e.g. the DvP settlement agent).
      controller owner, bank
      do
        require (not isLocked) "Cash position is already locked"
        requireNonEmpty lockRef "lockReference"
        create this with
          isLocked = True
          lockReference = Some lockRef
          lockHolder = Some holder

    -- | Release the lock. Only the lock holder can do this.
    choice UnlockCash : ContractId CashPosition
      controller fromOptional owner lockHolder
      do
        require isLocked "Cash position is not currently locked"
        create this with
          isLocked = False
          lockReference = None
          lockHolder = None

    -- | Deliver a locked position to a counterparty as part of a settlement
    -- (e.g. the cash leg of a DvP). Exercised by the lock holder together with
    -- the receiver; the bank and owner consented when they created the lock.
    -- The delivered position is unlocked and has no observers.
    choice SettleLockedCash : ContractId CashPosition
      with
        newOwner : Party
        newAccountId : AccountId
      controller fromOptional owner lockHolder, newOwner
      do
        require isLocked "Only a locked position can be settled by its lock holder"
        create this with
          owner = newOwner
          accountId = newAccountId
          isLocked = False
          lockReference = None
          lockHolder = None
          observers = []

    -- | Add an observer to this cash position.
    -- Used to grant visibility to settlement agents or DvP counterparties.
    choice AddCashObserver : ContractId CashPosition
      with
        newObserver : Party
      controller owner
      do
        require (newObserver `notElem` observers) "Party is already an observer"
        create this with observers = newObserver :: observers

    -- | Remove an observer from this cash position.
    choice RemoveCashObserver : ContractId CashPosition
      with
        observerToRemove : Party
      controller owner
      do
        require (observerToRemove `elem` observers) "Party is not an observer"
        create this with observers = filter (/= observerToRemove) observers

    -- | Nonconsuming check: verify if this position is available for movement.
    nonconsuming choice IsAvailable : Bool
      controller bank
      do
        pure (not isLocked)
