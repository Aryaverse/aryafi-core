-- | Delivery-versus-Payment (DvP) settlement engine.
-- DvpInstruction is the atomic settlement primitive that guarantees
-- simultaneous delivery of securities and payment of cash.
-- In financial markets, DvP eliminates principal risk — the risk that
-- one party delivers without receiving the corresponding consideration.
--
-- This template models a tri-party DvP:
--   - Seller: delivers securities from their custody account.
--   - Buyer: delivers cash from their bank account.
--   - Settlement Agent: executes the atomic swap on behalf of both parties.
--
-- Before execution, the seller locks the SecurityPosition and the buyer locks
-- the CashPosition, each naming the settlement agent as lock holder. From then
-- on neither leg can be withdrawn. ExecuteDvpSettlement validates both locked
-- positions against the instruction and, in one Daml transaction, delivers the
-- security to the buyer and the cash to the seller. Either both legs settle or
-- the whole transaction is rejected.
--
-- Settlement model: DVP Model 1 (simultaneous, gross, final). Models 2 and 3
-- (netted legs) are declared for reference data but are not executed here.
-- Reference: BIS CPSS/IOSCO Principles for Financial Market Infrastructures.
module AryaFi.Finance.Settlement where

import AryaFi.Common.Types (Amount, Currency, SettlementStatus(..))
import AryaFi.Common.Identifiers (AccountId, ISIN, CorrelationId, TradeId, IdempotencyKey)
import AryaFi.Common.Errors (require, requireNonEmpty)
import AryaFi.Finance.Cash (CashPosition, SettleLockedCash(..))
import AryaFi.Finance.Security (SecurityPosition, SettleLockedSecurity(..))

-- ---------------------------------------------------------------------------
-- DvP Settlement Type
-- ---------------------------------------------------------------------------

-- | DvP model variant — describes the settlement finality guarantee.
data DvpModel
  = DvpModel1
    -- ^ Simultaneous final settlement: securities and cash settle simultaneously,
    --   both legs are unconditional and irrevocable on execution.
  | DvpModel2
    -- ^ Securities settle on gross basis; cash settles on net basis at end of day.
  | DvpModel3
    -- ^ Both legs settle on a net basis at end of day.
  deriving (Eq, Show)

-- | Result of an executed DvP: the settled instruction and the two new positions.
data DvpSettlementResult = DvpSettlementResult
  with
    instructionCid : ContractId DvpInstruction
    -- ^ The instruction, now in Settled status.
    deliveredSecurityCid : ContractId SecurityPosition
    -- ^ The buyer's new SecurityPosition.
    paidCashCid : ContractId CashPosition
    -- ^ The seller's new CashPosition.
  deriving (Eq, Show)

-- ---------------------------------------------------------------------------
-- DvpInstruction Template
-- ---------------------------------------------------------------------------

-- | Atomic Delivery-versus-Payment instruction.
-- Seller, buyer, and settlement agent all sign the instruction, so the agent
-- can later execute it without further consent from either counterparty.
--
-- Pre-conditions (checked on-ledger by ExecuteDvpSettlement):
--   1. The seller's SecurityPosition is owned by the seller, held in
--      sellerSecurityAccount, matches isin and securityQuantity exactly, and is
--      locked to the settlement agent with lockReference = sellerSecurityLockRef.
--   2. The buyer's CashPosition is owned by the buyer, held in buyerCashAccount,
--      matches currency and cashAmount exactly, and is locked to the settlement
--      agent with lockReference = buyerCashLockRef.
--   3. Party and asset eligibility (KYC, sanctions, restrictions) is checked by
--      the settlement agent before execution.
--
-- Execution (ExecuteDvpSettlement), in a single transaction:
--   - Archives the locked SecurityPosition and creates the buyer's position
--     in buyerSecurityAccount.
--   - Archives the locked CashPosition and creates the seller's position
--     in sellerCashAccount.
--   - Records the instruction as Settled.
--
-- Status machine:
--   PendingSettlement → Settled | Failed Text | Cancelled Text
template DvpInstruction
  with
    settlementAgent : Party
    -- ^ Settlement agent responsible for executing the atomic swap.
    seller : Party
    -- ^ Party delivering securities and receiving cash.
    buyer : Party
    -- ^ Party delivering cash and receiving securities.
    tradeId : TradeId
    -- ^ Unique identifier for the underlying trade.
    isin : ISIN
    -- ^ ISIN of the security being delivered.
    securityQuantity : Amount
    -- ^ Quantity of the security (face value or units) being delivered.
    sellerSecurityAccount : AccountId
    -- ^ Account from which the seller delivers the security.
    buyerSecurityAccount : AccountId
    -- ^ Account into which the buyer receives the security.
    currency : Currency
    -- ^ Currency in which the cash leg is denominated.
    cashAmount : Amount
    -- ^ Cash consideration for the security quantity.
    sellerCashAccount : AccountId
    -- ^ Account into which the seller receives cash.
    buyerCashAccount : AccountId
    -- ^ Account from which the buyer delivers cash.
    dvpModel : DvpModel
    -- ^ Settlement model variant (typically Model 1 for institutional DvP).
    settlementDate : Time
    -- ^ Intended settlement date (T+0, T+1, T+2, etc.).
    correlationId : CorrelationId
    -- ^ Correlation ID linking to the originating trade or workflow.
    idempotencyKey : IdempotencyKey
    -- ^ Idempotency key to prevent duplicate settlement execution.
    sellerSecurityLockRef : Text
    -- ^ Lock reference on the seller's SecurityPosition (confirms pre-lock).
    buyerCashLockRef : Text
    -- ^ Lock reference on the buyer's CashPosition (confirms pre-lock).
    status : SettlementStatus
    -- ^ Current settlement status.
    failureReason : Optional Text
    -- ^ Populated when status is Failed (e.g. "INSUFFICIENT_SECURITY_BALANCE").
    observers : [Party]
    -- ^ Additional observers (e.g. CSD, trade repository, regulator).
  where
    signatory settlementAgent, seller, buyer
    observer observers

    ensure securityQuantity > 0.0 && cashAmount > 0.0

    -- | Execute the DvP settlement atomically: deliver the locked security to
    -- the buyer and the locked cash to the seller in one transaction.
    -- Every attribute of both legs is validated against this instruction first;
    -- any mismatch aborts the whole transaction and nothing moves.
    choice ExecuteDvpSettlement : DvpSettlementResult
      with
        sellerSecurityCid : ContractId SecurityPosition
        -- ^ The seller's SecurityPosition, locked to the settlement agent.
        buyerCashCid : ContractId CashPosition
        -- ^ The buyer's CashPosition, locked to the settlement agent.
      controller settlementAgent
      do
        require (status == PendingSettlement)
          "DvP can only be executed from PendingSettlement status"
        require (dvpModel == DvpModel1)
          "Only DvP Model 1 (gross, simultaneous) settlement is executed on-ledger"
        requireNonEmpty sellerSecurityLockRef "sellerSecurityLockRef"
        requireNonEmpty buyerCashLockRef "buyerCashLockRef"

        sec <- fetch sellerSecurityCid
        require (sec.owner == seller) "Security leg: position is not owned by the seller"
        require (sec.accountId == sellerSecurityAccount) "Security leg: position is not in the seller's security account"
        require (sec.isin == isin) "Security leg: ISIN does not match the instruction"
        require (sec.quantity == securityQuantity)
          ("Security leg: quantity " <> show sec.quantity <> " does not match instructed " <> show securityQuantity)
        require (sec.isLocked && sec.lockHolder == Some settlementAgent)
          "Security leg: position is not locked to the settlement agent"
        require (sec.lockReference == Some sellerSecurityLockRef)
          "Security leg: lock reference does not match the instruction"

        cash <- fetch buyerCashCid
        require (cash.owner == buyer) "Cash leg: position is not owned by the buyer"
        require (cash.accountId == buyerCashAccount) "Cash leg: position is not in the buyer's cash account"
        require (cash.currency == currency) "Cash leg: currency does not match the instruction"
        require (cash.amount == cashAmount)
          ("Cash leg: amount " <> show cash.amount <> " does not match instructed " <> show cashAmount)
        require (cash.isLocked && cash.lockHolder == Some settlementAgent)
          "Cash leg: position is not locked to the settlement agent"
        require (cash.lockReference == Some buyerCashLockRef)
          "Cash leg: lock reference does not match the instruction"

        deliveredSecurityCid <- exercise sellerSecurityCid SettleLockedSecurity with
          newOwner = buyer
          newAccountId = buyerSecurityAccount
        paidCashCid <- exercise buyerCashCid SettleLockedCash with
          newOwner = seller
          newAccountId = sellerCashAccount
        instructionCid <- create this with
          status = Settled
          failureReason = None
        pure DvpSettlementResult with instructionCid; deliveredSecurityCid; paidCashCid

    -- | Fail the settlement with a specific reason.
    -- Called when settlement cannot proceed (e.g. failed pre-checks,
    -- position not found, regulatory hold). Both legs stay locked to the
    -- settlement agent, who releases them with UnlockSecurity / UnlockCash
    -- unless the instruction is retried.
    choice FailDvpSettlement : ContractId DvpInstruction
      with
        reason : Text
      controller settlementAgent
      do
        require (status == PendingSettlement)
          "Can only fail a PendingSettlement instruction"
        requireNonEmpty reason "reason"
        create this with
          status = Failed reason
          failureReason = Some reason

    -- | Cancel the DvP instruction by mutual agreement.
    -- Requires authorization from both buyer and seller.
    -- Can only cancel a PendingSettlement instruction.
    choice CancelDvpSettlement : ContractId DvpInstruction
      with
        reason : Text
      controller seller, buyer
      do
        require (status == PendingSettlement)
          "Can only cancel a PendingSettlement instruction"
        requireNonEmpty reason "reason"
        create this with
          status = Cancelled reason
          failureReason = Some reason

    -- | Retry a failed settlement instruction.
    -- Resets status to PendingSettlement for re-execution.
    -- Requires all three parties to consent to the retry.
    choice RetrySettlement : ContractId DvpInstruction
      controller settlementAgent, seller, buyer
      do
        require (case status of { Failed _ -> True; _ -> False })
          "Can only retry a Failed settlement"
        create this with
          status = PendingSettlement
          failureReason = None

    -- | Add an observer to this DvP instruction.
    -- Used to grant visibility to CSDs, trade repositories, or regulators.
    choice AddDvpObserver : ContractId DvpInstruction
      with
        newObserver : Party
      controller settlementAgent
      do
        require (newObserver `notElem` observers) "Party is already an observer"
        create this with observers = newObserver :: observers

    -- | Nonconsuming query: has this instruction been finalized (settled, failed, or cancelled)?
    nonconsuming choice IsFinalized : Bool
      controller settlementAgent
      do
        pure (status /= PendingSettlement)
