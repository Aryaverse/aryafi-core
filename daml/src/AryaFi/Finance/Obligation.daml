module AryaFi.Finance.Obligation where

import AryaFi.Common.Types (Amount, Currency)

-- | Status of a financial obligation.
data ObligationStatus
  = ObligationPending
  | ObligationFulfilled
  | ObligationDefaulted
  | ObligationCancelled
  deriving (Eq, Show)

-- | Financial obligation representing a duty to deliver cash or securities.
template FinancialObligation
  with
    obligor : Party
    obligee : Party
    currency : Currency
    amount : Amount
    dueDate : Time
    status : ObligationStatus
    reference : Text
  where
    signatory obligor, obligee

    controller obligee can
      DischargeObligation : ContractId FinancialObligation
        do
          create this with status = ObligationFulfilled

      DeclareObligationDefault : ContractId FinancialObligation
        do
          create this with status = ObligationDefaulted
