module AryaFi.Finance.Account where

import AryaFi.Common.Identifiers (AccountId)

-- | Types of institutional custody / holding accounts.
data AccountType
  = OmnibusAccount
  | SegregatedCustody
  | ClearingAccount
  | SettlementAccount
  | MarginAccount
  deriving (Eq, Show)

-- | Institutional account contract holding assets with explicit custodian and owner signatories.
template Account
  with
    custodian : Party
    owner : Party
    accountId : AccountId
    accountType : AccountType
    description : Text
    isFrozen : Bool
    observers : [Party]
  where
    signatory custodian, owner
    observer observers

    key (custodian, accountId) : (Party, AccountId)
    maintainer key._1

    controller custodian can
      FreezeAccount : ContractId Account
        do
          create this with isFrozen = True

      UnfreezeAccount : ContractId Account
        do
          create this with isFrozen = False

    controller owner can
      AddObserver : ContractId Account
        with
          newObserver : Party
        do
          create this with observers = dedup (newObserver :: observers)
