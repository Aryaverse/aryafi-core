-- | Generic asset holding interface for all asset types in AryaFi.
-- AssetHolding is an abstract representation that can model any fungible
-- or non-fungible asset (equity, fund share, commodity, digital asset).
-- For institutional fixed-income and cash, use the specialized
-- SecurityPosition and CashPosition templates respectively.
module AryaFi.Finance.Asset where

import AryaFi.Common.Identifiers (AccountId, ExternalRef)
import AryaFi.Common.Types (Amount, AssetClass)
import AryaFi.Common.Errors (require, requireNonEmpty)
import DA.Optional (fromOptional, optionalToList)

-- ---------------------------------------------------------------------------
-- AssetHolding Template
-- ---------------------------------------------------------------------------

-- | Generic position record for any asset type.
-- Three-party signatory model: issuer (maintains asset integrity),
-- custodian (controls physical or ledger safekeeping),
-- and owner (beneficial owner with economic rights).
--
-- Authorization model:
--   - Transfer requires owner + custodian + receiving owner.
--   - Lock requires owner + custodian and names a locking party; only that
--     party can unlock the asset afterwards.
--   - Only custodian can update external references (CSD, core banking refs).
--
-- Privacy: issuer, custodian, and owner always see this contract.
-- Additional observers (e.g. collateral receiver, tri-party agent) can be added.
template AssetHolding
  with
    issuer : Party
    -- ^ Party that created or issued this asset (e.g. central bank for CBDCs,
    --   fund manager for fund shares, custodian as asset administrator).
    custodian : Party
    -- ^ Institution providing safekeeping (must be different from issuer in most cases).
    owner : Party
    -- ^ Beneficial owner of this asset with economic rights.
    accountId : AccountId
    -- ^ Account this holding belongs to. Must match an existing Account contract.
    assetClass : AssetClass
    -- ^ High-level classification for eligibility and reporting purposes.
    assetId : Text
    -- ^ Internal identifier for this specific asset or instrument.
    quantity : Amount
    -- ^ Quantity of the asset held (face value, units, lots, etc.).
    isLocked : Bool
    -- ^ Whether this asset is encumbered (e.g. pledged, in settlement, margined).
    lockReference : Optional Text
    -- ^ Reference to the contract or obligation that locked this asset.
    lockHolder : Optional Party
    -- ^ Party holding the lock; only this party can release it.
    externalRef : Optional ExternalRef
    -- ^ Reference to the holding in an external custody or CSD system.
    observers : [Party]
    -- ^ Additional parties with read access (e.g. collateral receiver, settlement agent).
  where
    signatory issuer, custodian, owner
    observer observers, optionalToList lockHolder

    ensure quantity > 0.0 && isLocked == (lockHolder /= None)

    -- | Lock this asset, preventing transfer or further encumbrance.
    -- Used for: pledging as collateral, initiating settlement, margin posting.
    -- Requires joint agreement of owner and custodian. The locking party
    -- becomes the lock holder and gains visibility of the holding.
    choice LockAsset : ContractId AssetHolding
      with
        lockRef : Text
        lockingParty : Party
      controller owner, custodian
      do
        require (not isLocked) "Asset is already locked"
        requireNonEmpty lockRef "lockReference"
        create this with
          isLocked = True
          lockReference = Some lockRef
          lockHolder = Some lockingParty

    -- | Unlock a previously locked asset, making it freely transferable again.
    -- Only the lock holder can release the lock.
    choice UnlockAsset : ContractId AssetHolding
      controller fromOptional owner lockHolder
      do
        require isLocked "Asset is not currently locked"
        create this with
          isLocked = False
          lockReference = None
          lockHolder = None

    -- | Transfer ownership of this asset to a new owner and account.
    -- Asset must not be locked before transfer.
    -- Requires joint authorization of current owner, custodian, and the
    -- receiver (who becomes a signatory). Observers are cleared on transfer.
    choice TransferAsset : ContractId AssetHolding
      with
        newOwner : Party
        newAccountId : AccountId
      controller owner, custodian, newOwner
      do
        require (not isLocked) "Cannot transfer a locked asset"
        require (newOwner /= owner) "New owner must be different from current owner"
        create this with
          owner = newOwner
          accountId = newAccountId
          observers = []

    -- | Update the external custody or CSD system reference.
    -- Only the custodian can update this reference.
    choice UpdateExternalRef : ContractId AssetHolding
      with
        newRef : ExternalRef
      controller custodian
      do
        create this with externalRef = Some newRef

    -- | Add an observer to this holding (e.g. collateral receiver, tri-party agent).
    choice AddObserver : ContractId AssetHolding
      with
        newObserver : Party
      controller owner
      do
        require (newObserver `notElem` observers) "Party is already an observer"
        create this with observers = newObserver :: observers

    -- | Nonconsuming check: verify if this asset can be freely transferred.
    nonconsuming choice IsTransferable : Bool
      controller custodian
      do
        pure (not isLocked)
