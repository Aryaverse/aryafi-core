-- | Canton Network Token Standard transfers (CIP-0112 `TransferInstructionV2`)
-- of AryaFi cash and security positions, so wallets and apps can move them
-- through the standard.
--
-- The bank (for cash) or custodian (for securities) is the registry. It
-- creates a `PositionTransferFactory` listing its clients. A client instructs
-- a transfer with the standard's `TransferFactory_Transfer` choice, naming the
-- holdings that fund it. The transfer takes two steps, because the receiver
-- signs every position it receives:
--
--   1. The sender instructs the transfer. The input holdings are archived,
--      any change goes back to the sender, and the transferred amount is
--      locked to the registry and shown to the receiver. The result is
--      `Pending`, with a `PositionTransferInstruction`.
--   2. The receiver accepts and receives the position, or rejects. The sender
--      can withdraw until then. A rejection or withdrawal unlocks the amount
--      for the sender.
--
-- The transfer completes in one step if the receiver instructs it together
-- with the sender, or if the sender moves the holding to another of its own
-- accounts.
--
-- By creating the factory, the registry agrees in advance to transfers between
-- its clients' accounts. `TransferCash` and `TransferSecurity` need its
-- signature on each transfer instead.
module AryaFi.Finance.TokenTransfer where

import qualified DA.Map as Map
import DA.Assert (assertDeadlineExceeded, assertWithinDeadline)
import DA.Foldable (mapA_)
import qualified Splice.Api.Token.HoldingV2 as HoldingV2
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.TransferInstructionV2
import AryaFi.Common.Errors (require, requirePositive)
import AryaFi.Finance.TokenRegistry

-- | Lock context shown on the amount of a pending transfer.
transferLockContext : Text
transferLockContext = "Token standard transfer"

-- ---------------------------------------------------------------------------
-- PositionTransferFactory Template
-- ---------------------------------------------------------------------------

-- | A registry's factory for token-standard transfers of the positions it
-- keeps. Its clients see it, so they can instruct transfers through it.
template PositionTransferFactory
  with
    admin : Party
    -- ^ The registry: the bank for cash, the custodian for securities.
    clients : [Party]
    -- ^ Account owners who can send and receive through this factory.
  where
    signatory admin
    observer clients

    interface instance TransferFactory for PositionTransferFactory where
      view = factoryView admin
      -- | Instruct a transfer between two clients' accounts (see instructTransfer).
      transferFactory_transferImpl _ arg = instructTransfer this arg
      -- | Return the factory's view: its admin.
      transferFactory_publicFetchImpl _ _ = pure (factoryView admin)
      transferFactory_transferExtraObservers _ = []

    -- | Let another account owner send and receive through this factory.
    choice AddTransferFactoryClient : ContractId PositionTransferFactory
      with
        client : Party
      controller admin
      do
        require (client `notElem` clients) "Party is already a client"
        create this with clients = client :: clients

    -- | Stop an account owner sending and receiving through this factory.
    -- Transfers already instructed are not affected.
    choice RemoveTransferFactoryClient : ContractId PositionTransferFactory
      with
        client : Party
      controller admin
      do
        require (client `elem` clients) "Party is not a client"
        create this with clients = filter (/= client) clients

factoryView : Party -> TransferFactoryView
factoryView admin = TransferFactoryView with admin; meta = emptyMetadata

-- | Instruct a transfer through `factory`: check it, fund it from the input
-- holdings, and either complete it or leave it pending for the receiver.
instructTransfer : PositionTransferFactory -> TransferFactory_Transfer -> Update TransferInstructionResult
instructTransfer factory arg = do
  let transfer = arg.transfer
      admin = factory.admin
  require (transfer.instrumentId.admin == admin) "Transfer: the instrument has a different admin"
  require (transfer.sender.provider == Some admin) "Transfer: the sender's account is kept by another provider"
  require (transfer.receiver.provider == Some admin) "Transfer: the receiver's account is kept by another provider"
  require (transfer.sender /= transfer.receiver) "Transfer: the sender and receiver accounts are the same"
  sender <- accountOwner "Sender" transfer.sender
  receiver <- accountOwner "Receiver" transfer.receiver
  require (sender `elem` arg.actors) "Transfer: only the sender can instruct it"
  require (sender `elem` factory.clients) "Transfer: the sender is not a client of the registry"
  require (receiver `elem` factory.clients) "Transfer: the receiver is not a client of the registry"
  requirePositive transfer.amount "amount"
  assertDeadlineExceeded "requestedAt" transfer.requestedAt
  assertWithinDeadline "executeBefore" transfer.executeBefore

  (first, rest) <- fundingPositions transfer.sender transfer.instrumentId transfer.inputHoldingCids
  let inputs = first :: rest
      total = sum [(positionView p).amount | p <- inputs]
  require (total >= transfer.amount)
    ("Transfer: the input holdings total " <> show total <> ", less than " <> show transfer.amount)
  mapA_ archivePosition inputs
  senderChangeCids <-
    if total > transfer.amount
    then do
      change <- createPosition first sender transfer.sender.id (total - transfer.amount) None
        (positionObservers first)
      pure [change]
    else pure []

  if receiver `elem` arg.actors || receiver == sender
  then do
    received <- createPosition first receiver transfer.receiver.id transfer.amount None []
    pure (transferResult (TransferInstructionResult_Completed [received]) senderChangeCids)
  else do
    lockedHoldingCid <- createPosition first sender transfer.sender.id transfer.amount
      (Some (admin, transferLockContext)) [receiver]
    instructionCid <- create PositionTransferInstruction with
      admin; sender; receiver; transfer; lockedHoldingCid
    pure (transferResult (TransferInstructionResult_Pending (toInterfaceContractId instructionCid)) senderChangeCids)

transferResult : TransferInstructionResult_Output -> [ContractId HoldingV2.Holding] -> TransferInstructionResult
transferResult output senderChangeCids = TransferInstructionResult with
  output
  senderChangeCids
  meta = emptyMetadata

-- ---------------------------------------------------------------------------
-- PositionTransferInstruction Template
-- ---------------------------------------------------------------------------

-- | A pending token-standard transfer: the amount is locked to the registry in
-- the sender's account until the receiver accepts or rejects it, or the
-- sender withdraws it.
template PositionTransferInstruction
  with
    admin : Party
    -- ^ The registry, which holds the lock.
    sender : Party
    -- ^ Owner of the sending account.
    receiver : Party
    -- ^ Owner of the receiving account.
    transfer : Transfer
    -- ^ The transfer as instructed.
    lockedHoldingCid : ContractId HoldingV2.Holding
    -- ^ The sender's position of the transferred amount, locked to the registry.
  where
    signatory admin, sender
    observer receiver

    interface instance TransferInstruction for PositionTransferInstruction where
      view = TransferInstructionView with
        originalInstructionCid = None
        transfer
        expiresAt = None
        availableActions = Map.fromList
          [ (TIA_Accept, [[receiver]])
          , (TIA_Reject, [[receiver]])
          , (TIA_Withdraw, [[sender]])
          ]
        meta = emptyMetadata

      -- | Deliver the locked amount to the receiver's account, before
      -- executeBefore. The lock holder (the registry) and the receiver
      -- authorize the delivery.
      transferInstruction_acceptImpl self arg = do
        require (receiver `elem` arg.actors) "Only the receiver can accept the transfer"
        assertWithinDeadline "executeBefore" transfer.executeBefore
        archive (fromInterfaceContractId @PositionTransferInstruction self)
        received <- deliverLocked lockedHoldingCid receiver transfer.receiver.id
        pure (transferResult (TransferInstructionResult_Completed [received]) [])

      -- | Refuse the transfer: the amount is unlocked for the sender.
      transferInstruction_rejectImpl self arg = do
        require (receiver `elem` arg.actors) "Only the receiver can reject the transfer"
        archive (fromInterfaceContractId @PositionTransferInstruction self)
        returned <- releaseLocked lockedHoldingCid
        pure (transferResult TransferInstructionResult_Failed [returned])

      -- | Take the transfer back: the amount is unlocked for the sender.
      transferInstruction_withdrawImpl self arg = do
        require (sender `elem` arg.actors) "Only the sender can withdraw the transfer"
        archive (fromInterfaceContractId @PositionTransferInstruction self)
        returned <- releaseLocked lockedHoldingCid
        pure (transferResult TransferInstructionResult_Failed [returned])

      transferInstruction_acceptExtraObservers _ = []
      transferInstruction_rejectExtraObservers _ = []
      transferInstruction_withdrawExtraObservers _ = []
