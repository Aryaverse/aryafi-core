module AryaFi.Compliance.KYC where

import AryaFi.Common.Identifiers (LEI)

-- | Institutional KYC verification status.
data KycStatus
  = KycPending
  | KycVerified
  | KycRejected Text
  | KycExpired
  deriving (Eq, Show)

-- | Institutional KYC Attestation holding verified status without personal PII.
template KycAttestation
  with
    authority : Party
    subjectParty : Party
    lei : Optional LEI
    status : KycStatus
    verificationTimestamp : Time
    expiryTimestamp : Time
    jurisdiction : Text
    riskTier : Text
  where
    signatory authority
    observer subjectParty

    key (authority, subjectParty) : (Party, Party)
    maintainer key._1

    choice UpdateKycStatus : ContractId KycAttestation
      with
        newStatus : KycStatus
        newExpiry : Time
      controller authority
      do
        create this with
          status = newStatus
          expiryTimestamp = newExpiry
