module AryaFi.Compliance.RegulatoryReporting where

import AryaFi.Common.Identifiers (CorrelationId)

-- | Regulatory reporting regimes.
data ReportingRegime
  = SEC_CAT
  | CFTC_Part43_45
  | EMIR_Refit
  | MiFIR
  | MAS_TradeReporting
  deriving (Eq, Show)

-- | Institutional regulatory reporting record for trade repository reporting.
template RegulatoryReportRecord
  with
    reportingParty : Party
    regulator : Party
    regime : ReportingRegime
    correlationId : CorrelationId
    reportPayload : Text
    submissionTimestamp : Time
    isAcknowledged : Bool
  where
    signatory reportingParty
    observer regulator

    choice AcknowledgeReport : ContractId RegulatoryReportRecord
      controller regulator
      do
        create this with isAcknowledged = True
