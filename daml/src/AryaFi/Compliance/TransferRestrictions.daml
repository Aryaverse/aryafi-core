-- | Transfer restriction rule definitions linked to tokenized securities.
-- TransferRestrictionRule encodes regulatory exemption categories (Reg D, Reg S, Rule 144A)
-- and enforces holding period lockups, whitelist requirements, and issuance restrictions.
-- The nonconsuming EvaluateTransfer choice enables compliance gating without
-- consuming the rule contract. It evaluates every configured restriction
-- (lockup, holding period, whitelist, regulatory category) and returns a
-- PolicyDecision listing every reason a transfer is rejected.
--
-- The category rules below are a configurable policy module, not legal advice:
-- institutions decide which category applies to each security.
module AryaFi.Compliance.TransferRestrictions where

import AryaFi.Common.Identifiers (ISIN(..))
import AryaFi.Common.Errors (require)
import AryaFi.Common.Policies (PolicyDecision(..), andDecision, toComplianceDecision)
import AryaFi.ComplianceApi.PolicyV1
import DA.Time (addRelTime, days, isLedgerTimeLT)

-- ---------------------------------------------------------------------------
-- Regulatory Category
-- ---------------------------------------------------------------------------

-- | Regulatory exemption types and categories.
data RegulatoryCategory
  = RegD_506c
    -- ^ Regulation D, Rule 506(c) — private placement to accredited investors.
  | RegS
    -- ^ Regulation S — offshore exemption for securities sold outside the US.
  | Rule144A
    -- ^ Rule 144A — private placement to Qualified Institutional Buyers (QIBs).
  | QualifiedPurchaserOnly
    -- ^ Section 3(c)(7) funds restricted to "Qualified Purchasers" only.
  | AccreditedInvestorOnly
    -- ^ General accredited investor restriction under Regulation D.
  | RetailUnrestricted
    -- ^ No transfer restrictions (fully registered securities).
  deriving (Eq, Show)

-- | Investor classification of the proposed transferee, as established by the
-- compliance officer's KYC / onboarding records.
data InvestorStatus = InvestorStatus
  with
    isAccredited : Bool
    -- ^ Accredited investor (Regulation D, Rule 501).
    isQualifiedInstitutionalBuyer : Bool
    -- ^ Qualified Institutional Buyer (Rule 144A).
    isQualifiedPurchaser : Bool
    -- ^ Qualified Purchaser (Investment Company Act §2(a)(51)).
    isUsPerson : Bool
    -- ^ U.S. person (Regulation S, Rule 902(k)).
  deriving (Eq, Show)

-- | Eligibility of an investor for a regulatory category.
categoryDecision : RegulatoryCategory -> InvestorStatus -> PolicyDecision
categoryDecision category investor = case category of
  RegD_506c -> requireFlag investor.isAccredited "RECEIVER_NOT_ACCREDITED"
  AccreditedInvestorOnly -> requireFlag investor.isAccredited "RECEIVER_NOT_ACCREDITED"
  Rule144A -> requireFlag investor.isQualifiedInstitutionalBuyer "RECEIVER_NOT_QIB"
  QualifiedPurchaserOnly -> requireFlag investor.isQualifiedPurchaser "RECEIVER_NOT_QUALIFIED_PURCHASER"
  RegS -> requireFlag (not investor.isUsPerson) "RECEIVER_IS_US_PERSON"
  RetailUnrestricted -> Approved
  where
    requireFlag ok reason = if ok then Approved else Rejected reason

-- ---------------------------------------------------------------------------
-- TransferRestrictionRule Template
-- ---------------------------------------------------------------------------

-- | Transfer restriction rule definition linked to an asset or security.
template TransferRestrictionRule
  with
    complianceOfficer : Party
    -- ^ Compliance officer managing this restriction rule.
    isin : ISIN
    -- ^ ISIN of the security subject to this transfer restriction.
    regulatoryCategory : RegulatoryCategory
    -- ^ Regulatory exemption category governing permitted transfers.
    holdingPeriodDays : Int
    -- ^ Mandatory holding period in calendar days (0 = no holding period).
    whitelistRequired : Bool
    -- ^ If True, transferees must appear in whitelist.
    whitelist : [Party]
    -- ^ Approved transferees (used when whitelistRequired is True).
    lockupExpiry : Optional Time
    -- ^ Optional absolute lockup expiry date. Transfers blocked before this time.
    isActive : Bool
    -- ^ Whether this restriction is currently enforceable.
  where
    signatory complianceOfficer

    -- Workflows evaluate the rule in their own transactions (see AryaFi.Compliance.Gate).
    interface instance CompliancePolicy for TransferRestrictionRule where
      view = CompliancePolicyView with
        owner = complianceOfficer
        kind = TransferRulePolicy
        subject = None
        instrumentId = Some (unISIN isin)
        jurisdiction = None
      evaluatePolicy request = toComplianceDecision <$> ruleDecision this request

    -- | Update the regulatory category and lockup configuration.
    choice UpdateRestriction : ContractId TransferRestrictionRule
      with
        newCategory : RegulatoryCategory
        newLockup : Optional Time
      controller complianceOfficer
      do
        create this with
          regulatoryCategory = newCategory
          lockupExpiry = newLockup

    -- | Activate this restriction rule.
    choice ActivateRule : ContractId TransferRestrictionRule
      controller complianceOfficer
      do
        require (not isActive) "Rule is already active"
        create this with isActive = True

    -- | Deactivate this restriction rule (e.g. after restriction period ends).
    choice DeactivateRule : ContractId TransferRestrictionRule
      controller complianceOfficer
      do
        require isActive "Rule is already inactive"
        create this with isActive = False

    -- | Update the holding period requirement.
    choice UpdateHoldingPeriod : ContractId TransferRestrictionRule
      with
        newDays : Int
      controller complianceOfficer
      do
        require (newDays >= 0) "Holding period must be non-negative"
        create this with holdingPeriodDays = newDays

    -- | Update the whitelist requirement.
    choice SetWhitelistRequired : ContractId TransferRestrictionRule
      with
        required : Bool
      controller complianceOfficer
      do
        create this with whitelistRequired = required

    -- | Add a party to the approved-transferee whitelist.
    choice AddToWhitelist : ContractId TransferRestrictionRule
      with
        approvedParty : Party
      controller complianceOfficer
      do
        require (approvedParty `notElem` whitelist) "Party is already whitelisted"
        create this with whitelist = approvedParty :: whitelist

    -- | Remove a party from the approved-transferee whitelist.
    choice RemoveFromWhitelist : ContractId TransferRestrictionRule
      with
        removedParty : Party
      controller complianceOfficer
      do
        require (removedParty `elem` whitelist) "Party is not whitelisted"
        create this with whitelist = filter (/= removedParty) whitelist

    -- | Nonconsuming evaluation of a proposed transfer at the current ledger time.
    -- An inactive rule restricts nothing and approves. An active rule checks:
    --   1. the absolute lockup has expired;
    --   2. the transferor has held the security for holdingPeriodDays;
    --   3. the receiver is whitelisted, when whitelistRequired;
    --   4. the receiver's investor status satisfies regulatoryCategory.
    -- Every failed check contributes its reason to the Rejected decision.
    nonconsuming choice EvaluateTransfer : PolicyDecision
      with
        receiver : Party
        -- ^ Proposed transferee.
        acquiredAt : Time
        -- ^ When the transferor acquired the security (start of holding period).
        receiverStatus : InvestorStatus
        -- ^ Investor classification of the receiver.
      controller complianceOfficer
      do
        now <- getTime
        let lockupCheck = case lockupExpiry of
              Some t | now < t -> Rejected ("LOCKUP_NOT_EXPIRED until " <> show t)
              _ -> Approved
            holdingCheck =
              if now >= addRelTime acquiredAt (days holdingPeriodDays) then Approved
              else Rejected ("HOLDING_PERIOD_NOT_MET: " <> show holdingPeriodDays <> " days required")
            whitelistCheck =
              if not whitelistRequired || receiver `elem` whitelist then Approved
              else Rejected "RECEIVER_NOT_WHITELISTED"
            categoryCheck = categoryDecision regulatoryCategory receiverStatus
        pure $ if not isActive then Approved
               else foldl andDecision Approved [lockupCheck, holdingCheck, whitelistCheck, categoryCheck]

-- | A transfer restriction rule's decision for a receiver, as a workflow
-- evaluates it. An inactive rule, or a party that only sends, is approved.
-- For an active rule:
--   * the lockup must have expired, and the receiver must be whitelisted when
--     the rule requires a whitelist;
--   * a rule that requires a whitelist treats whitelisted receivers as eligible
--     for its regulatory category; otherwise a restricted category needs the
--     receiver's investor status, which the ledger does not hold, so the
--     decision is manual review;
--   * a holding period needs the date the sender acquired the security, which
--     positions do not record, so it is manual review too.
-- Rejections take precedence over manual review.
ruleDecision : TransferRestrictionRule -> ComplianceRequest -> Update PolicyDecision
ruleDecision rule request
  | request.instrumentId /= unISIN rule.isin = pure (Rejected "TRANSFER_RULE_FOR_ANOTHER_SECURITY")
  | not rule.isActive || not request.receiving = pure Approved
  | otherwise = do
      lockedUp <- case rule.lockupExpiry of
        Some expiry -> isLedgerTimeLT expiry
        None -> pure False
      let whitelisted = request.party `elem` rule.whitelist
          lockup = if lockedUp then Rejected "LOCKUP_NOT_EXPIRED" else Approved
          whitelist = if rule.whitelistRequired && not whitelisted then Rejected "RECEIVER_NOT_WHITELISTED" else Approved
          category =
            if rule.regulatoryCategory == RetailUnrestricted || (rule.whitelistRequired && whitelisted) then Approved
            else RequiresManualReview ("INVESTOR_STATUS_REQUIRED: " <> show rule.regulatoryCategory)
          holdingPeriod =
            if rule.holdingPeriodDays == 0 then Approved
            else RequiresManualReview ("HOLDING_PERIOD_NOT_VERIFIABLE: " <> show rule.holdingPeriodDays <> " days")
      pure (foldl andDecision Approved [lockup, whitelist, category, holdingPeriod])
