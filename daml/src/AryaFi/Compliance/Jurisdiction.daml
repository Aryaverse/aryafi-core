-- | Cross-border legal jurisdiction profile for AryaFi participants.
-- JurisdictionProfile captures the regulatory framework and permitted asset classes
-- for an institution operating in a given jurisdiction. Regulators and institutions
-- co-sign the profile; only the regulator can modify it.
module AryaFi.Compliance.Jurisdiction where

import AryaFi.Common.Errors (require, requireNonEmpty)

-- | Cross-border legal jurisdiction profile.
template JurisdictionProfile
  with
    regulator : Party
    -- ^ Regulating authority for this jurisdiction (e.g. SEC, FCA, MAS, ADGM).
    institution : Party
    -- ^ Institution operating in this jurisdiction.
    countryCode : Text
    -- ^ ISO 3166-1 alpha-2 country code (e.g. "US", "GB", "CH", "SG", "AE").
    regulatoryFramework : Text
    -- ^ Name of the applicable framework (e.g. "SEC/FINRA", "FCA", "MAS").
    permittedAssetClasses : [Text]
    -- ^ Asset classes this institution is permitted to hold or trade in this jurisdiction.
    isActive : Bool
    -- ^ Whether this jurisdiction profile is currently active and enforceable.
  where
    signatory regulator, institution

    -- | Activate or deactivate this jurisdiction profile.
    choice SetJurisdictionActive : ContractId JurisdictionProfile
      with
        active : Bool
      controller regulator
      do
        create this with isActive = active

    -- | Add a permitted asset class to this profile.
    choice AddPermittedAssetClass : ContractId JurisdictionProfile
      with
        assetClass : Text
      controller regulator
      do
        requireNonEmpty assetClass "assetClass"
        require (assetClass `notElem` permittedAssetClasses)
          ("Asset class already permitted: " <> assetClass)
        create this with permittedAssetClasses = assetClass :: permittedAssetClasses

    -- | Remove a permitted asset class from this profile.
    choice RemovePermittedAssetClass : ContractId JurisdictionProfile
      with
        assetClass : Text
      controller regulator
      do
        require (assetClass `elem` permittedAssetClasses)
          ("Asset class not currently permitted: " <> assetClass)
        create this with
          permittedAssetClasses = filter (/= assetClass) permittedAssetClasses

    -- | Update the regulatory framework reference (e.g. after a regulatory change).
    choice UpdateRegulatoryFramework : ContractId JurisdictionProfile
      with
        newFramework : Text
      controller regulator
      do
        requireNonEmpty newFramework "regulatoryFramework"
        create this with regulatoryFramework = newFramework

    -- | Nonconsuming query: is the given asset class permitted in this active profile?
    nonconsuming choice IsAssetClassPermitted : Bool
      with
        assetClass : Text
      controller regulator
      do
        pure (isActive && assetClass `elem` permittedAssetClasses)

