module AryaFi.Compliance.Jurisdiction where

-- | Cross-border legal jurisdiction profile.
template JurisdictionProfile
  with
    regulator : Party
    institution : Party
    countryCode : Text  -- ISO 3166-1 alpha-2 (e.g., "US", "GB", "CH", "SG", "AE")
    regulatoryFramework : Text
    permittedAssetClasses : [Text]
    isActive : Bool
  where
    signatory regulator, institution

    controller regulator can
      SetJurisdictionActive : ContractId JurisdictionProfile
        with
          active : Bool
        do
          create this with isActive = active
