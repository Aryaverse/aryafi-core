-- | Institutional sanctions screening attestation for AryaFi participants.
-- SanctionsAttestation records the outcome of an OFAC/EU/UN sanctions screening
-- performed by an authorized screening authority against a subject institution.
--
-- Authorization model:
--   - screeningAuthority: issues, updates, blocks, and clears attestations.
--   - subjectParty: read-only observer — cannot control this contract.
--
-- One attestation per authority per subject is expected but not enforced on
-- the ledger (Daml 3 has no unique contract keys); the authority is
-- responsible for not issuing duplicates.
module AryaFi.Compliance.Sanctions where

import DA.Time (isLedgerTimeGE)
import AryaFi.Common.Identifiers (LEI, ExternalRef)
import AryaFi.Common.Errors (require, requireNonEmpty)
import AryaFi.Common.Policies (PolicyDecision(..), toComplianceDecision)
import AryaFi.ComplianceApi.PolicyV1

-- ---------------------------------------------------------------------------
-- Sanctions Status
-- ---------------------------------------------------------------------------

-- | Institutional sanctions clearance status.
data SanctionsStatus
  = SanctionsClear
    -- ^ Subject passed all applicable screening lists (OFAC SDN, EU, UN).
  | SanctionsFlagged Text
    -- ^ Subject was flagged for manual review. Text contains the screening list or alert code.
  | SanctionsBlocked Text
    -- ^ Subject is confirmed on a sanctions list and is blocked from all transactions.
  deriving (Eq, Show)

-- ---------------------------------------------------------------------------
-- SanctionsAttestation Template
-- ---------------------------------------------------------------------------

-- | Sanctions screening attestation issued by an authorized screening authority.
template SanctionsAttestation
  with
    screeningAuthority : Party
    -- ^ Authorized sanctions screening authority.
    subjectParty : Party
    -- ^ Institution being screened (observer only — cannot control this contract).
    lei : Optional LEI
    -- ^ ISO 17442 Legal Entity Identifier of the subject, if available.
    status : SanctionsStatus
    -- ^ Current sanctions screening status.
    screeningTimestamp : Time
    -- ^ Timestamp of the most recent screening run.
    expiryTimestamp : Time
    -- ^ Timestamp after which re-screening is required.
    screeningProviderRef : Text
    -- ^ Reference to the screening provider system (e.g. "ACME-AML-SCREEN-REF").
    providerRef : Optional ExternalRef
    -- ^ Typed external reference to the screening provider record.
    observers : [Party]
    -- ^ Additional observers (e.g. custodians, brokers, regulators).
  where
    signatory screeningAuthority
    observer subjectParty :: observers

    -- Workflows evaluate the attestation in their own transactions (see AryaFi.Compliance.Gate).
    interface instance CompliancePolicy for SanctionsAttestation where
      view = CompliancePolicyView with
        owner = screeningAuthority
        kind = SanctionsPolicy
        subject = Some subjectParty
        instrumentId = None
        jurisdiction = None
      evaluatePolicy request = toComplianceDecision <$> sanctionsDecision this request

    -- | Update the sanctions status and extend validity.
    -- The screening timestamp is the current ledger time (cannot be backdated).
    choice UpdateSanctionsStatus : ContractId SanctionsAttestation
      with
        newStatus : SanctionsStatus
        newExpiry : Time
      controller screeningAuthority
      do
        now <- getTime
        require (newExpiry > now) "Screening expiry must be in the future"
        create this with
          status = newStatus
          expiryTimestamp = newExpiry
          screeningTimestamp = now

    -- | Block a party following a confirmed sanctions hit.
    -- Sets status to SanctionsBlocked with the mandatory sanctions list reference.
    choice BlockParty : ContractId SanctionsAttestation
      with
        sanctionsListRef : Text
      controller screeningAuthority
      do
        requireNonEmpty sanctionsListRef "sanctionsListRef"
        now <- getTime
        create this with
          status = SanctionsBlocked sanctionsListRef
          screeningTimestamp = now

    -- | Clear a previously flagged or blocked party following compliance resolution.
    choice ClearParty : ContractId SanctionsAttestation
      with
        clearanceRef : Text
      controller screeningAuthority
      do
        requireNonEmpty clearanceRef "clearanceRef"
        require
          (case status of { SanctionsClear -> False; _ -> True })
          "Party is already clear"
        now <- getTime
        create this with
          status = SanctionsClear
          screeningTimestamp = now
          screeningProviderRef = clearanceRef

    -- | Add an observer (e.g. custodian, prime broker, regulator).
    choice AddSanctionsObserver : ContractId SanctionsAttestation
      with
        newObserver : Party
      controller screeningAuthority
      do
        require (newObserver `notElem` observers) "Party is already an observer"
        create this with observers = newObserver :: observers

    -- | Nonconsuming query: is this party currently sanctions-clear and within validity?
    -- Returns True only when status is SanctionsClear and attestation has not expired.
    nonconsuming choice IsSanctionsClear : Bool
      controller screeningAuthority
      do
        now <- getTime
        pure (status == SanctionsClear && now < expiryTimestamp)

-- | A sanctions attestation's decision for a party: rejected if the party is
-- blocked or the screening has expired, manual review if it is flagged, and
-- approved only for the screened party while clear.
sanctionsDecision : SanctionsAttestation -> ComplianceRequest -> Update PolicyDecision
sanctionsDecision screening request
  | request.party /= screening.subjectParty = pure (Rejected "SANCTIONS_ATTESTATION_FOR_ANOTHER_PARTY")
  | otherwise = do
      expired <- isLedgerTimeGE screening.expiryTimestamp
      pure $ case screening.status of
        SanctionsBlocked listRef -> Rejected ("SANCTIONED: " <> listRef)
        _ | expired -> Rejected "SANCTIONS_SCREENING_EXPIRED"
        SanctionsFlagged alert -> RequiresManualReview ("SANCTIONS_FLAGGED: " <> alert)
        SanctionsClear -> Approved
