-- | Ownership concentration restrictions for regulated securities.
-- OwnershipRestriction enforces maximum holding caps, quantity limits,
-- and jurisdiction exclusions to comply with regulatory ownership thresholds.
-- The nonconsuming CheckOwnershipLimit choice enables compliance gating in
-- transfer workflows without consuming the rule contract, and workflows
-- evaluate the restriction in their own transactions through
-- `CompliancePolicy` (see AryaFi.Compliance.Gate).
module AryaFi.Compliance.OwnershipRestrictions where

import AryaFi.Common.Types (Amount)
import AryaFi.Common.Identifiers (ISIN(..))
import AryaFi.Common.Errors (require, requireNonEmpty)
import AryaFi.Common.Policies (PolicyDecision(..), andDecision, toComplianceDecision)
import AryaFi.ComplianceApi.PolicyV1

-- | Maximum holding cap and investor concentration restrictions.
template OwnershipRestriction
  with
    regulator : Party
    -- ^ Regulatory authority enforcing this restriction.
    isin : ISIN
    -- ^ ISIN of the security subject to ownership restrictions.
    maxOwnershipPercentage : Decimal
    -- ^ Maximum ownership as a decimal percentage (e.g. 5.0 = 5%). 0.0 = no limit.
    maxHoldingQuantity : Amount
    -- ^ Maximum absolute quantity allowed per holder. 0.0 = no limit.
    disallowedJurisdictions : [Text]
    -- ^ ISO country codes prohibited from holding this security.
    isActive : Bool
    -- ^ Whether this restriction is currently enforceable.
  where
    signatory regulator

    -- Workflows evaluate the restriction in their own transactions (see AryaFi.Compliance.Gate).
    interface instance CompliancePolicy for OwnershipRestriction where
      view = CompliancePolicyView with
        owner = regulator
        kind = OwnershipPolicy
        subject = None
        instrumentId = Some (unISIN isin)
        jurisdiction = None
      evaluatePolicy request = pure (toComplianceDecision (restrictionDecision this request))

    -- | Update the ownership caps.
    choice UpdateCaps : ContractId OwnershipRestriction
      with
        newMaxPercentage : Decimal
        newMaxQuantity : Amount
      controller regulator
      do
        require (newMaxPercentage >= 0.0) "maxOwnershipPercentage must be non-negative"
        require (newMaxQuantity >= 0.0) "maxHoldingQuantity must be non-negative"
        create this with
          maxOwnershipPercentage = newMaxPercentage
          maxHoldingQuantity = newMaxQuantity

    -- | Add a jurisdiction to the disallowed list.
    choice AddDisallowedJurisdiction : ContractId OwnershipRestriction
      with
        jurisdiction : Text
      controller regulator
      do
        requireNonEmpty jurisdiction "jurisdiction"
        require (jurisdiction `notElem` disallowedJurisdictions)
          ("Jurisdiction already disallowed: " <> jurisdiction)
        create this with
          disallowedJurisdictions = jurisdiction :: disallowedJurisdictions

    -- | Remove a jurisdiction from the disallowed list.
    choice RemoveDisallowedJurisdiction : ContractId OwnershipRestriction
      with
        jurisdiction : Text
      controller regulator
      do
        require (jurisdiction `elem` disallowedJurisdictions)
          ("Jurisdiction not in disallowed list: " <> jurisdiction)
        create this with
          disallowedJurisdictions = filter (/= jurisdiction) disallowedJurisdictions

    -- | Activate or deactivate this restriction.
    choice SetRestrictionActive : ContractId OwnershipRestriction
      with
        active : Bool
      controller regulator
      do
        create this with isActive = active

    -- | Nonconsuming query: does the proposed holding violate this restriction?
    -- Returns Approved if within all limits, Rejected with reason if any limit is exceeded.
    nonconsuming choice CheckOwnershipLimit : PolicyDecision
      with
        proposedQuantity : Amount
        proposedPercentage : Decimal
        holderJurisdiction : Text
      controller regulator
      do
        if not isActive then
          pure Approved
        else if holderJurisdiction `elem` disallowedJurisdictions then
          pure (Rejected ("Jurisdiction not permitted to hold this security: " <> holderJurisdiction))
        else if maxHoldingQuantity > 0.0 && proposedQuantity > maxHoldingQuantity then
          pure (Rejected ("Proposed quantity " <> show proposedQuantity
                         <> " exceeds maximum allowed " <> show maxHoldingQuantity))
        else if maxOwnershipPercentage > 0.0 && proposedPercentage > maxOwnershipPercentage then
          pure (Rejected ("Proposed ownership " <> show proposedPercentage
                         <> "% exceeds maximum " <> show maxOwnershipPercentage <> "%"))
        else
          pure Approved


-- | An ownership restriction's decision for a receiver, as a workflow
-- evaluates it. An inactive restriction, or a party that only sends, is
-- approved. For an active one:
--   * the receiver's jurisdiction, from its KYC attestation, must not be
--     disallowed; if it is unknown and some are disallowed, the decision is
--     manual review;
--   * the transferred amount must not exceed the holding limit. What the
--     receiver already holds is not counted, because positions are not
--     aggregated on the ledger, and the percentage limit is not checked,
--     because the ledger does not hold the issue size.
restrictionDecision : OwnershipRestriction -> ComplianceRequest -> PolicyDecision
restrictionDecision restriction request
  | request.instrumentId /= unISIN restriction.isin = Rejected "OWNERSHIP_RESTRICTION_FOR_ANOTHER_SECURITY"
  | not restriction.isActive || not request.receiving = Approved
  | otherwise = andDecision jurisdictionCheck holdingCheck
  where
    jurisdictionCheck = case request.jurisdiction of
      Some j | j `elem` restriction.disallowedJurisdictions -> Rejected ("JURISDICTION_NOT_PERMITTED: " <> j)
      None | not (null restriction.disallowedJurisdictions) -> RequiresManualReview "RECEIVER_JURISDICTION_UNKNOWN"
      _ -> Approved
    holdingCheck =
      if restriction.maxHoldingQuantity > 0.0 && request.amount > restriction.maxHoldingQuantity
      then Rejected ("HOLDING_LIMIT_EXCEEDED: " <> show request.amount <> " over " <> show restriction.maxHoldingQuantity)
      else Approved
