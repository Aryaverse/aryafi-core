-- | End-to-end DvP settlement scenario and negative test suite.
-- Tests the full lifecycle of a Delivery-versus-Payment instruction:
--   Setup → Lock both legs to the agent → Create DvP → Execute → Verify ownership
-- Also covers: leg validation, lock integrity, failure, retry, cancellation,
-- authorization, privacy, and boundary cases.
module AryaFi.Test.Scenarios.DvpSettlementTest where

import Daml.Script
import AryaFi.Finance.Settlement
import AryaFi.Finance.Security
import AryaFi.Finance.Cash
import AryaFi.Common.Identifiers
import AryaFi.Common.Types

-- ---------------------------------------------------------------------------
-- Constants
-- ---------------------------------------------------------------------------

bondIsin : ISIN
bondIsin = ISIN "US912828ZM50"

bondQuantity : Amount
bondQuantity = 5000000.0

cashConsideration : Amount
cashConsideration = 4975000.0

sellerSecAcc, buyerSecAcc, sellerCashAcc, buyerCashAcc : AccountId
sellerSecAcc = AccountId "ACC-SELLER-SEC-001"
buyerSecAcc = AccountId "ACC-BUYER-SEC-001"
sellerCashAcc = AccountId "ACC-SELLER-CASH-001"
buyerCashAcc = AccountId "ACC-BUYER-CASH-001"

-- ---------------------------------------------------------------------------
-- Helpers
-- ---------------------------------------------------------------------------

setupSecurityPosition
  : Party -> Party -> AccountId -> Amount
  -> Script (ContractId SecurityPosition)
setupSecurityPosition custodian owner accId qty =
  submitMulti [custodian, owner] [] do
    createCmd SecurityPosition with
      custodian = custodian
      owner = owner
      accountId = accId
      isin = bondIsin
      cusip = Some (CUSIP "912828ZM5")
      instrumentName = "US Treasury 4.25% Nov 2026"
      instrumentType = GovernmentBond
      quantity = qty
      couponRate = Some 0.0425
      couponType = Some FixedCoupon
      dayCountConvention = Some ActActISDA
      maturityDate = None
      seniority = Some Senior
      isLocked = False
      lockReference = None
      lockHolder = None
      csdRef = None
      observers = []

setupCashPosition
  : Party -> Party -> AccountId -> Amount
  -> Script (ContractId CashPosition)
setupCashPosition bank owner accId amt =
  submitMulti [bank, owner] [] do
    createCmd CashPosition with
      bank = bank
      owner = owner
      accountId = accId
      currency = "USD"
      amount = amt
      isLocked = False
      lockReference = None
      lockHolder = None
      observers = []

mkDvp
  : Party -> Party -> Party -> Text -> Text
  -> Script (ContractId DvpInstruction)
mkDvp agent seller buyer secLockRef cashLockRef = do
  now <- getTime
  submitMulti [agent, seller, buyer] [] do
    createCmd DvpInstruction with
      settlementAgent = agent
      seller = seller
      buyer = buyer
      tradeId = TradeId "TRD-US-TREAS-2026-001"
      isin = bondIsin
      securityQuantity = bondQuantity
      sellerSecurityAccount = sellerSecAcc
      buyerSecurityAccount = buyerSecAcc
      currency = "USD"
      cashAmount = cashConsideration
      sellerCashAccount = sellerCashAcc
      buyerCashAccount = buyerCashAcc
      dvpModel = DvpModel1
      settlementDate = now
      correlationId = CorrelationId "CORR-DVP-TREAS-001"
      idempotencyKey = IdempotencyKey "IKEY-DVP-001"
      sellerSecurityLockRef = secLockRef
      buyerCashLockRef = cashLockRef
      status = PendingSettlement
      failureReason = None
      observers = []

-- | Everything needed to settle one DvP: parties, locked legs, and the instruction.
data DvpFixture = DvpFixture
  with
    agent : Party
    seller : Party
    buyer : Party
    custodian : Party
    bank : Party
    lockedSecCid : ContractId SecurityPosition
    lockedCashCid : ContractId CashPosition
    dvpCid : ContractId DvpInstruction

-- | Seller holds the bond, buyer holds exactly the consideration; both legs are
-- locked to the settlement agent under the trade reference; all three parties
-- sign the instruction.
stageDvp : Text -> Script DvpFixture
stageDvp lockRef = do
  custodian <- allocateParty "GlobalCustodian"
  bank      <- allocateParty "CashSettlementBank"
  seller    <- allocateParty "DealerBankA"
  buyer     <- allocateParty "DealerBankB"
  agent     <- allocateParty "SettlementAgent"
  secCid  <- setupSecurityPosition custodian seller sellerSecAcc bondQuantity
  cashCid <- setupCashPosition bank buyer buyerCashAcc cashConsideration
  lockedSecCid <- submitMulti [seller, custodian] [] do
    exerciseCmd secCid LockSecurity with lockRef; holder = agent
  lockedCashCid <- submitMulti [buyer, bank] [] do
    exerciseCmd cashCid LockCash with lockRef; holder = agent
  dvpCid <- mkDvp agent seller buyer lockRef lockRef
  pure DvpFixture with ..

execute : DvpFixture -> ContractId DvpInstruction -> Script DvpSettlementResult
execute f cid = submit f.agent do
  exerciseCmd cid ExecuteDvpSettlement with
    sellerSecurityCid = f.lockedSecCid
    buyerCashCid = f.lockedCashCid

-- ---------------------------------------------------------------------------
-- Full DvP Lifecycle Scenario
-- ---------------------------------------------------------------------------

testDvpFullLifecycle : Script ()
testDvpFullLifecycle = script do
  custodian <- allocateParty "GlobalCustodian"
  bank      <- allocateParty "CashSettlementBank"
  seller    <- allocateParty "DealerBankA"
  buyer     <- allocateParty "DealerBankB"
  agent     <- allocateParty "SettlementAgent"
  csd       <- allocateParty "CentralSecuritiesDepository"

  -- Step 1: Seller holds the bond; buyer holds 5M cash
  secCid <- setupSecurityPosition custodian seller sellerSecAcc bondQuantity
  cashCid <- setupCashPosition bank buyer buyerCashAcc 5000000.0

  -- Step 2: Buyer carves out exactly the consideration (4,975,000)
  (considerationCid, remainderCid) <- submit buyer do
    exerciseCmd cashCid SplitCash with splitAmount = cashConsideration

  -- Step 3: Both legs are locked to the settlement agent (pre-condition for DvP)
  let lockRef = "DVP-TRD-US-TREAS-2026-001"
  lockedSecCid <- submitMulti [seller, custodian] [] do
    exerciseCmd secCid LockSecurity with lockRef; holder = agent
  lockedCashCid <- submitMulti [buyer, bank] [] do
    exerciseCmd considerationCid LockCash with lockRef; holder = agent

  -- The agent can see both locked legs
  agentSecView <- queryContractId agent lockedSecCid
  agentCashView <- queryContractId agent lockedCashCid
  assertMsg "Agent sees the locked security leg" (agentSecView /= None)
  assertMsg "Agent sees the locked cash leg" (agentCashView /= None)

  -- Step 4: Create DvP instruction (all three parties sign)
  dvpCid <- mkDvp agent seller buyer lockRef lockRef

  -- Step 5: Agent adds CSD as observer
  dvpWithCsdCid <- submit agent do
    exerciseCmd dvpCid AddDvpObserver with newObserver = csd
  csdView <- queryContractId csd dvpWithCsdCid
  assertMsg "CSD can see DvP instruction" (csdView /= None)

  -- Step 6: Execute settlement — both legs move in one transaction
  result <- submit agent do
    exerciseCmd dvpWithCsdCid ExecuteDvpSettlement with
      sellerSecurityCid = lockedSecCid
      buyerCashCid = lockedCashCid

  -- Step 7: Verify the instruction
  Some dvp <- queryContractId seller result.instructionCid
  assertMsg "Status Settled" (dvp.status == Settled)
  assertMsg "No failure reason" (dvp.failureReason == None)

  -- Step 8: Verify ownership actually changed
  Some delivered <- queryContractId buyer result.deliveredSecurityCid
  assertMsg "Buyer owns the bond" (delivered.owner == buyer)
  assertMsg "Bond is in the buyer's security account" (delivered.accountId == buyerSecAcc)
  assertMsg "Full quantity delivered" (delivered.quantity == bondQuantity)
  assertMsg "Delivered bond is unlocked" (not delivered.isLocked && delivered.lockHolder == None)

  Some paid <- queryContractId seller result.paidCashCid
  assertMsg "Seller owns the cash" (paid.owner == seller)
  assertMsg "Cash is in the seller's cash account" (paid.accountId == sellerCashAcc)
  assertMsg "Full consideration paid" (paid.amount == cashConsideration)
  assertMsg "Paid cash is unlocked" (not paid.isLocked)

  -- Step 9: The old positions are gone; balances are conserved
  oldSec <- queryContractId custodian lockedSecCid
  oldCash <- queryContractId bank lockedCashCid
  assertMsg "Seller's bond position archived" (oldSec == None)
  assertMsg "Buyer's locked cash archived" (oldCash == None)
  sellerBonds <- query @SecurityPosition seller
  assertMsg "Seller no longer holds any bond" (null sellerBonds)
  Some remainder <- queryContractId buyer remainderCid
  assertMsg "Buyer keeps the 25,000 remainder" (remainder.amount == 25000.0)

  -- Step 10: Privacy after settlement — the seller cannot see the buyer's bond,
  -- the buyer cannot see the seller's cash
  sellerSeesBond <- queryContractId seller result.deliveredSecurityCid
  buyerSeesCash <- queryContractId buyer result.paidCashCid
  assertMsg "Seller cannot see buyer's new bond" (sellerSeesBond == None)
  assertMsg "Buyer cannot see seller's new cash" (buyerSeesCash == None)

-- ---------------------------------------------------------------------------
-- Lock Integrity
-- ---------------------------------------------------------------------------

-- | Once locked to the agent, neither owner nor custodian/bank can pull a leg
-- out of the settlement — the exploit where a seller unlocked mid-settlement.
testLockedLegsCannotBeWithdrawn : Script ()
testLockedLegsCannotBeWithdrawn = script do
  f <- stageDvp "DVP-LOCK-INTEGRITY"
  submitMultiMustFail [f.seller, f.custodian] [] do
    exerciseCmd f.lockedSecCid UnlockSecurity
  submitMultiMustFail [f.buyer, f.bank] [] do
    exerciseCmd f.lockedCashCid UnlockCash
  submitMultiMustFail [f.seller, f.custodian] [] do
    exerciseCmd f.lockedSecCid TransferSecurity with
      newOwner = f.agent
      newAccountId = AccountId "ELSEWHERE"
      correlationId = CorrelationId "X"
  -- The seller cannot settle the leg to itself either
  submitMultiMustFail [f.seller] [] do
    exerciseCmd f.lockedSecCid SettleLockedSecurity with
      newOwner = f.seller
      newAccountId = AccountId "ELSEWHERE"
  -- Settlement still succeeds
  result <- execute f f.dvpCid
  Some dvp <- queryContractId f.agent result.instructionCid
  assertMsg "Settled despite withdrawal attempts" (dvp.status == Settled)

-- ---------------------------------------------------------------------------
-- Leg Validation
-- ---------------------------------------------------------------------------

-- | Legs that do not match the instruction are rejected and nothing moves.
testDvpRejectsMismatchedLegs : Script ()
testDvpRejectsMismatchedLegs = script do
  f <- stageDvp "DVP-MISMATCH"

  -- A bond position of the wrong quantity, correctly locked
  shortSecCid <- setupSecurityPosition f.custodian f.seller sellerSecAcc 4000000.0
  shortLockedCid <- submitMulti [f.seller, f.custodian] [] do
    exerciseCmd shortSecCid LockSecurity with lockRef = "DVP-MISMATCH"; holder = f.agent
  submitMustFail f.agent do
    exerciseCmd f.dvpCid ExecuteDvpSettlement with
      sellerSecurityCid = shortLockedCid
      buyerCashCid = f.lockedCashCid

  -- Cash locked to someone other than the agent
  otherCashCid <- setupCashPosition f.bank f.buyer buyerCashAcc cashConsideration
  wrongHolderCid <- submitMulti [f.buyer, f.bank] [] do
    exerciseCmd otherCashCid LockCash with lockRef = "DVP-MISMATCH"; holder = f.bank
  submitMustFail f.agent do
    exerciseCmd f.dvpCid ExecuteDvpSettlement with
      sellerSecurityCid = f.lockedSecCid
      buyerCashCid = wrongHolderCid

  -- Cash locked under a different trade reference
  thirdCashCid <- setupCashPosition f.bank f.buyer buyerCashAcc cashConsideration
  wrongRefCid <- submitMulti [f.buyer, f.bank] [] do
    exerciseCmd thirdCashCid LockCash with lockRef = "SOME-OTHER-TRADE"; holder = f.agent
  submitMustFail f.agent do
    exerciseCmd f.dvpCid ExecuteDvpSettlement with
      sellerSecurityCid = f.lockedSecCid
      buyerCashCid = wrongRefCid

  -- Nothing moved: the original legs are still locked with their owners
  Some sec <- queryContractId f.seller f.lockedSecCid
  Some cash <- queryContractId f.buyer f.lockedCashCid
  assertMsg "Bond still with seller" (sec.owner == f.seller && sec.isLocked)
  assertMsg "Cash still with buyer" (cash.owner == f.buyer && cash.isLocked)

-- ---------------------------------------------------------------------------
-- Failure and Retry Scenario
-- ---------------------------------------------------------------------------

testDvpFailureAndRetry : Script ()
testDvpFailureAndRetry = script do
  f <- stageDvp "DVP-RETRY"

  -- Agent fails the settlement (e.g. a regulatory hold)
  failedCid <- submit f.agent do
    exerciseCmd f.dvpCid FailDvpSettlement with
      reason = "REGULATORY_HOLD_PENDING_REVIEW"

  Some failed <- queryContractId f.seller failedCid
  case failed.status of
    Failed r -> assertMsg "Failure reason" (r == "REGULATORY_HOLD_PENDING_REVIEW")
    _        -> abort "Expected Failed status"
  assertMsg "failureReason field set" (failed.failureReason == Some "REGULATORY_HOLD_PENDING_REVIEW")

  -- A failed instruction cannot be executed
  submitMustFail f.agent do
    exerciseCmd failedCid ExecuteDvpSettlement with
      sellerSecurityCid = f.lockedSecCid
      buyerCashCid = f.lockedCashCid

  -- All three parties agree to retry
  retriedCid <- submitMulti [f.agent, f.seller, f.buyer] [] do
    exerciseCmd failedCid RetrySettlement

  Some retried <- queryContractId f.buyer retriedCid
  assertMsg "Status back to PendingSettlement" (retried.status == PendingSettlement)
  assertMsg "failureReason cleared" (retried.failureReason == None)

  -- Now execute successfully with the still-locked legs
  result <- execute f retriedCid
  Some settled <- queryContractId f.agent result.instructionCid
  assertMsg "Status Settled after retry" (settled.status == Settled)

-- ---------------------------------------------------------------------------
-- Cancellation Scenario
-- ---------------------------------------------------------------------------

testDvpCancellation : Script ()
testDvpCancellation = script do
  f <- stageDvp "DVP-CANCEL"

  -- Buyer and seller agree to cancel (e.g. trade error)
  cancelledCid <- submitMulti [f.seller, f.buyer] [] do
    exerciseCmd f.dvpCid CancelDvpSettlement with
      reason = "TRADE_ERROR_INCORRECT_ISIN"

  Some cancelled <- queryContractId f.agent cancelledCid
  case cancelled.status of
    Cancelled r -> assertMsg "Cancellation reason" (r == "TRADE_ERROR_INCORRECT_ISIN")
    _           -> abort "Expected Cancelled status"

  -- The agent releases both locks back to their owners
  releasedSecCid <- submit f.agent do exerciseCmd f.lockedSecCid UnlockSecurity
  releasedCashCid <- submit f.agent do exerciseCmd f.lockedCashCid UnlockCash
  Some sec <- queryContractId f.seller releasedSecCid
  Some cash <- queryContractId f.buyer releasedCashCid
  assertMsg "Bond released to the seller" (sec.owner == f.seller && not sec.isLocked)
  assertMsg "Cash released to the buyer" (cash.owner == f.buyer && not cash.isLocked)
  agentView <- queryContractId f.agent releasedSecCid
  assertMsg "Agent loses visibility once the lock is released" (agentView == None)

-- ---------------------------------------------------------------------------
-- Privacy Tests
-- ---------------------------------------------------------------------------

testDvpPrivacy : Script ()
testDvpPrivacy = script do
  f <- stageDvp "DVP-PRIVACY"
  outsider <- allocateParty "OutsiderCorp"

  outsiderView <- queryContractId outsider f.dvpCid
  assertMsg "Outsider cannot see DvP instruction" (outsiderView == None)
  outsiderSec <- queryContractId outsider f.lockedSecCid
  assertMsg "Outsider cannot see the locked bond" (outsiderSec == None)

  sellerView <- queryContractId f.seller f.dvpCid
  assertMsg "Seller sees DvP instruction" (sellerView /= None)
  buyerView <- queryContractId f.buyer f.dvpCid
  assertMsg "Buyer sees DvP instruction" (buyerView /= None)

  -- Counterparties do not see each other's legs before settlement
  buyerSeesBond <- queryContractId f.buyer f.lockedSecCid
  sellerSeesCash <- queryContractId f.seller f.lockedCashCid
  assertMsg "Buyer cannot see seller's bond position" (buyerSeesBond == None)
  assertMsg "Seller cannot see buyer's cash position" (sellerSeesCash == None)

-- ---------------------------------------------------------------------------
-- Negative Tests
-- ---------------------------------------------------------------------------

-- Negative: only settlement agent can execute DvP
testOnlyAgentCanExecuteDvp : Script ()
testOnlyAgentCanExecuteDvp = script do
  f <- stageDvp "DVP-AUTH"
  submitMustFail f.seller do
    exerciseCmd f.dvpCid ExecuteDvpSettlement with
      sellerSecurityCid = f.lockedSecCid
      buyerCashCid = f.lockedCashCid

-- Negative: cannot execute an already-settled DvP (its legs are consumed)
testCannotReExecuteSettledDvp : Script ()
testCannotReExecuteSettledDvp = script do
  f <- stageDvp "DVP-REEXEC"
  result <- execute f f.dvpCid
  submitMustFail f.agent do
    exerciseCmd result.instructionCid ExecuteDvpSettlement with
      sellerSecurityCid = f.lockedSecCid
      buyerCashCid = f.lockedCashCid

-- Negative: settlement agent cannot unilaterally cancel (needs seller + buyer)
testAgentCannotCancelAlone : Script ()
testAgentCannotCancelAlone = script do
  f <- stageDvp "DVP-AGENT-CANCEL"
  submitMustFail f.agent do
    exerciseCmd f.dvpCid CancelDvpSettlement with reason = "Agent unilateral cancel"

-- Negative: cannot retry a settled instruction
testCannotRetrySettledDvp : Script ()
testCannotRetrySettledDvp = script do
  f <- stageDvp "DVP-RETRY-SETTLED"
  result <- execute f f.dvpCid
  submitMultiMustFail [f.agent, f.seller, f.buyer] [] do
    exerciseCmd result.instructionCid RetrySettlement

-- Negative: cannot cancel a settled DvP
testCannotCancelSettledDvp : Script ()
testCannotCancelSettledDvp = script do
  f <- stageDvp "DVP-CANCEL-SETTLED"
  result <- execute f f.dvpCid
  submitMultiMustFail [f.seller, f.buyer] [] do
    exerciseCmd result.instructionCid CancelDvpSettlement with reason = "Late cancel attempt"

-- Negative: netted models (2 and 3) are not executed on-ledger
testNettedDvpModelNotExecuted : Script ()
testNettedDvpModelNotExecuted = script do
  f <- stageDvp "DVP-MODEL2"
  now <- getTime
  model2Cid <- submitMulti [f.agent, f.seller, f.buyer] [] do
    createCmd DvpInstruction with
      settlementAgent = f.agent
      seller = f.seller
      buyer = f.buyer
      tradeId = TradeId "TRD-MODEL2-001"
      isin = bondIsin
      securityQuantity = bondQuantity
      sellerSecurityAccount = sellerSecAcc
      buyerSecurityAccount = buyerSecAcc
      currency = "USD"
      cashAmount = cashConsideration
      sellerCashAccount = sellerCashAcc
      buyerCashAccount = buyerCashAcc
      dvpModel = DvpModel2
      settlementDate = now
      correlationId = CorrelationId "CORR-MODEL2-001"
      idempotencyKey = IdempotencyKey "IKEY-MODEL2-001"
      sellerSecurityLockRef = "DVP-MODEL2"
      buyerCashLockRef = "DVP-MODEL2"
      status = PendingSettlement
      failureReason = None
      observers = []
  submitMustFail f.agent do
    exerciseCmd model2Cid ExecuteDvpSettlement with
      sellerSecurityCid = f.lockedSecCid
      buyerCashCid = f.lockedCashCid

-- Negative: ensure rejects zero security quantity
testDvpEnsurePositiveSecurityQuantity : Script ()
testDvpEnsurePositiveSecurityQuantity = script do
  agent  <- allocateParty "SettlementAgent"
  seller <- allocateParty "DealerBankA"
  buyer  <- allocateParty "DealerBankB"
  now <- getTime

  submitMultiMustFail [agent, seller, buyer] [] do
    createCmd DvpInstruction with
      settlementAgent = agent
      seller = seller
      buyer = buyer
      tradeId = TradeId "TRD-ZERO-001"
      isin = bondIsin
      securityQuantity = 0.0    -- invalid: ensure rejects
      sellerSecurityAccount = AccountId "ACC-SEL-SEC-001"
      buyerSecurityAccount = AccountId "ACC-BUY-SEC-001"
      currency = "USD"
      cashAmount = 1000000.0
      sellerCashAccount = AccountId "ACC-SEL-CASH-001"
      buyerCashAccount = AccountId "ACC-BUY-CASH-001"
      dvpModel = DvpModel1
      settlementDate = now
      correlationId = CorrelationId "CORR-ZERO-001"
      idempotencyKey = IdempotencyKey "IKEY-ZERO-001"
      sellerSecurityLockRef = "LOCK-001"
      buyerCashLockRef = "LOCK-002"
      status = PendingSettlement
      failureReason = None
      observers = []

-- Negative: ensure rejects zero cash amount
testDvpEnsurePositiveCashAmount : Script ()
testDvpEnsurePositiveCashAmount = script do
  agent  <- allocateParty "SettlementAgent"
  seller <- allocateParty "DealerBankA"
  buyer  <- allocateParty "DealerBankB"
  now <- getTime

  submitMultiMustFail [agent, seller, buyer] [] do
    createCmd DvpInstruction with
      settlementAgent = agent
      seller = seller
      buyer = buyer
      tradeId = TradeId "TRD-ZEROCASH-001"
      isin = bondIsin
      securityQuantity = 1000000.0
      sellerSecurityAccount = AccountId "ACC-SEL-SEC-001"
      buyerSecurityAccount = AccountId "ACC-BUY-SEC-001"
      currency = "USD"
      cashAmount = 0.0          -- invalid: ensure rejects
      sellerCashAccount = AccountId "ACC-SEL-CASH-001"
      buyerCashAccount = AccountId "ACC-BUY-CASH-001"
      dvpModel = DvpModel1
      settlementDate = now
      correlationId = CorrelationId "CORR-ZEROCASH-001"
      idempotencyKey = IdempotencyKey "IKEY-ZEROCASH-001"
      sellerSecurityLockRef = "LOCK-001"
      buyerCashLockRef = "LOCK-002"
      status = PendingSettlement
      failureReason = None
      observers = []

-- ---------------------------------------------------------------------------
-- Entry Point
-- ---------------------------------------------------------------------------

runDvpSettlementTests : Script ()
runDvpSettlementTests = script do
  testDvpFullLifecycle
  testLockedLegsCannotBeWithdrawn
  testDvpRejectsMismatchedLegs
  testDvpFailureAndRetry
  testDvpCancellation
  testDvpPrivacy
  testOnlyAgentCanExecuteDvp
  testCannotReExecuteSettledDvp
  testAgentCannotCancelAlone
  testCannotRetrySettledDvp
  testCannotCancelSettledDvp
  testNettedDvpModelNotExecuted
  testDvpEnsurePositiveSecurityQuantity
  testDvpEnsurePositiveCashAmount
