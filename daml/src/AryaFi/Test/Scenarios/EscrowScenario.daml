-- | End-to-end escrow and pledge scenario and negative test suite.
-- Tests the full lifecycle of ConditionalEscrow and AssetPledge contracts:
--   Escrow: release, refund, dispute/resolution, expiry, privacy, and negative cases.
--   Pledge: release, enforce, substitution, observer management, and negative cases.
module AryaFi.Test.Scenarios.EscrowScenario where

import Daml.Script
import AryaFi.Contracts.Escrow
import AryaFi.Contracts.Pledge
import AryaFi.Common.Identifiers
import AryaFi.Common.Types
import DA.Time (addRelTime, days)

-- ---------------------------------------------------------------------------
-- Escrow Helpers
-- ---------------------------------------------------------------------------

mkEscrow
  : Party -> Party -> Party -> Time
  -> Script (ContractId ConditionalEscrow)
mkEscrow agent depositor beneficiary expiry = do
  _now <- getTime
  submitMulti [agent, depositor] [] do
    createCmd ConditionalEscrow with
      escrowId = "ESC-SPA-2026-001"
      escrowAgent = agent
      depositor = depositor
      beneficiary = beneficiary
      currency = "USD"
      amount = 10000000.0
      releaseCondition = "Condition Precedent: Regulatory Approval Obtained"
      expiryTime = expiry
      correlationId = CorrelationId "CORR-ESC-SPA-2026-001"
      status = EscrowHeld
      disputeReason = None
      observers = []

-- ---------------------------------------------------------------------------
-- Escrow Release Scenario
-- ---------------------------------------------------------------------------

testEscrowRelease : Script ()
testEscrowRelease = script do
  agent       <- allocateParty "EscrowAgent"
  depositor   <- allocateParty "BuyerCorp"
  beneficiary <- allocateParty "SellerCorp"
  regulator   <- allocateParty "Regulator"
  now         <- getTime
  let futureExpiry = addRelTime now (days 30)

  -- Create escrow
  escrowCid <- mkEscrow agent depositor beneficiary futureExpiry

  -- Beneficiary can see it (is observer)
  benView <- queryContractId beneficiary escrowCid
  assertMsg "Beneficiary sees escrow" (benView /= None)

  -- Add regulator as observer
  escrowWithRegCid <- submit agent do
    exerciseCmd escrowCid AddEscrowObserver with newObserver = regulator

  regView <- queryContractId regulator escrowWithRegCid
  assertMsg "Regulator sees escrow after being added" (regView /= None)

  -- Release: agent + beneficiary agree condition is met
  releasedCid <- submitMulti [agent, beneficiary] [] do
    exerciseCmd escrowWithRegCid ReleaseEscrow

  releasedData <- queryContractId depositor releasedCid
  case releasedData of
    None  -> abort "Released escrow not visible to depositor"
    Some e -> assertMsg "Status Released" (e.status == EscrowReleased)

  -- Verify terminal state
  isTerminal <- submit agent do
    exerciseCmd releasedCid IsEscrowTerminal

  assertMsg "Released escrow is terminal" isTerminal

-- ---------------------------------------------------------------------------
-- Escrow Refund Scenario
-- ---------------------------------------------------------------------------

testEscrowRefund : Script ()
testEscrowRefund = script do
  agent       <- allocateParty "EscrowAgent"
  depositor   <- allocateParty "BuyerCorp"
  beneficiary <- allocateParty "SellerCorp"
  now         <- getTime
  let futureExpiry = addRelTime now (days 30)

  escrowCid <- mkEscrow agent depositor beneficiary futureExpiry

  -- Regulatory approval not obtained; agent + depositor agree to refund
  refundedCid <- submitMulti [agent, depositor] [] do
    exerciseCmd escrowCid RefundEscrow

  refundedData <- queryContractId agent refundedCid
  case refundedData of
    None  -> abort "Refunded escrow not found"
    Some e -> assertMsg "Status Refunded" (e.status == EscrowRefunded)

-- ---------------------------------------------------------------------------
-- Escrow Dispute and Resolution Scenario
-- ---------------------------------------------------------------------------

testEscrowDisputeAndResolution : Script ()
testEscrowDisputeAndResolution = script do
  agent       <- allocateParty "EscrowAgent"
  depositor   <- allocateParty "BuyerCorp"
  beneficiary <- allocateParty "SellerCorp"
  now         <- getTime
  let futureExpiry = addRelTime now (days 30)

  escrowCid <- mkEscrow agent depositor beneficiary futureExpiry

  -- Agent raises dispute (parties disagree on condition satisfaction)
  disputedCid <- submit agent do
    exerciseCmd escrowCid DisputeEscrow with
      reason = "BENEFICIARY_DISPUTES_CONDITION_SATISFACTION"

  disputedData <- queryContractId agent disputedCid
  case disputedData of
    None  -> abort "Disputed escrow not found"
    Some e -> do
      assertMsg "Status Disputed" (e.status == EscrowDisputed)
      assertMsg "Dispute reason set"
        (e.disputeReason == Some "BENEFICIARY_DISPUTES_CONDITION_SATISFACTION")

  -- Escrow is not terminal while disputed
  isTerminal <- submit agent do
    exerciseCmd disputedCid IsEscrowTerminal

  assertMsg "Disputed escrow is NOT terminal" (not isTerminal)

  -- Agent resolves dispute in favor of depositor (refund)
  resolvedCid <- submit agent do
    exerciseCmd disputedCid ResolveDispute with
      resolutionStatus = EscrowRefunded

  resolvedData <- queryContractId depositor resolvedCid
  case resolvedData of
    None  -> abort "Resolved escrow not visible to depositor"
    Some e -> do
      assertMsg "Resolution status is Refunded" (e.status == EscrowRefunded)
      assertMsg "Dispute reason cleared" (e.disputeReason == None)

-- ---------------------------------------------------------------------------
-- Pledge Lifecycle Scenario
-- ---------------------------------------------------------------------------

mkPledge
  : Party -> Party -> Party
  -> Script (ContractId AssetPledge)
mkPledge pledgor pledgee custodian = do
  submitMulti [pledgor, pledgee, custodian] [] do
    createCmd AssetPledge with
      pledgeId = "PLEDGE-REPO-2026-001"
      pledgor = pledgor
      pledgee = pledgee
      custodian = custodian
      accountId = AccountId "ACC-PLEDGOR-SEC-001"
      assetId = "ASSET-US-TREAS-4P25-NOV26"
      quantity = 5000000.0
      perfectionReference = "UCC-1-FILING-2026-NYC-001"
      correlationId = CorrelationId "CORR-REPO-2026-001"
      status = Active
      enforceTimestamp = None
      observers = []

testPledgeRelease : Script ()
testPledgeRelease = script do
  pledgor   <- allocateParty "BorrowerBank"
  pledgee   <- allocateParty "LenderBank"
  custodian <- allocateParty "GlobalCustodian"

  pledgeCid <- mkPledge pledgor pledgee custodian

  -- Verify pledge is active
  isActive <- submit pledgee do
    exerciseCmd pledgeCid IsPledgeActive

  assertMsg "New pledge is active" isActive

  -- Pledgee releases the pledge (loan repaid)
  releasedCid <- submit pledgee do
    exerciseCmd pledgeCid ReleasePledge

  releasedData <- queryContractId pledgor releasedCid
  case releasedData of
    None  -> abort "Released pledge not visible to pledgor"
    Some p -> assertMsg "Pledge status is Closed" (p.status == Closed)

testPledgeEnforce : Script ()
testPledgeEnforce = script do
  pledgor   <- allocateParty "BorrowerBank"
  pledgee   <- allocateParty "LenderBank"
  custodian <- allocateParty "GlobalCustodian"
  now       <- getTime

  pledgeCid <- mkPledge pledgor pledgee custodian

  -- Pledgee enforces following default
  enforcedCid <- submit pledgee do
    exerciseCmd pledgeCid EnforcePledge

  enforcedData <- queryContractId pledgor enforcedCid
  case enforcedData of
    None  -> abort "Enforced pledge not visible to pledgor"
    Some p -> do
      assertMsg "Pledge status is Defaulted"        (p.status == Defaulted)
      assertMsg "Enforce timestamp set"             (p.enforceTimestamp == Some now)

testPledgeSubstitution : Script ()
testPledgeSubstitution = script do
  pledgor   <- allocateParty "BorrowerBank"
  pledgee   <- allocateParty "LenderBank"
  custodian <- allocateParty "GlobalCustodian"

  pledgeCid <- mkPledge pledgor pledgee custodian

  -- All three parties agree to substitute the pledged asset
  substitutedCid <- submitMulti [pledgor, pledgee, custodian] [] do
    exerciseCmd pledgeCid SubstitutePledge with
      newAssetId = "ASSET-US-TREAS-3P875-FEB27"
      newAccountId = AccountId "ACC-PLEDGOR-SEC-002"
      newQuantity = 5000000.0
      newPerfectionRef = "UCC-1-AMENDMENT-2026-NYC-001"

  substitutedData <- queryContractId pledgee substitutedCid
  case substitutedData of
    None  -> abort "Substituted pledge not visible to pledgee"
    Some p -> do
      assertMsg "New asset ID set"         (p.assetId == "ASSET-US-TREAS-3P875-FEB27")
      assertMsg "New perfection ref set"   (p.perfectionReference == "UCC-1-AMENDMENT-2026-NYC-001")
      assertMsg "Status still Active"      (p.status == Active)

testPledgeUpdatePerfectionRef : Script ()
testPledgeUpdatePerfectionRef = script do
  pledgor   <- allocateParty "BorrowerBank"
  pledgee   <- allocateParty "LenderBank"
  custodian <- allocateParty "GlobalCustodian"

  pledgeCid <- mkPledge pledgor pledgee custodian

  updatedCid <- submit custodian do
    exerciseCmd pledgeCid UpdatePerfectionRef with
      newRef = "UCC-1-AMENDMENT-2026-NYC-002"

  updatedData <- queryContractId pledgee updatedCid
  case updatedData of
    None  -> abort "Updated pledge not found"
    Some p -> assertMsg "Perfection ref updated"
      (p.perfectionReference == "UCC-1-AMENDMENT-2026-NYC-002")

testPledgeAddObserver : Script ()
testPledgeAddObserver = script do
  pledgor   <- allocateParty "BorrowerBank"
  pledgee   <- allocateParty "LenderBank"
  custodian <- allocateParty "GlobalCustodian"
  triAgent  <- allocateParty "TriPartyAgent"

  pledgeCid <- mkPledge pledgor pledgee custodian

  -- Pledgee alone cannot disclose the pledge
  submitMustFail pledgee do
    exerciseCmd pledgeCid AddPledgeObserver with newObserver = triAgent

  pledgeWithAgentCid <- submitMulti [pledgor, pledgee] [] do
    exerciseCmd pledgeCid AddPledgeObserver with newObserver = triAgent

  agentView <- queryContractId triAgent pledgeWithAgentCid
  assertMsg "Tri-party agent sees pledge after being added" (agentView /= None)

-- ---------------------------------------------------------------------------
-- Negative Tests
-- ---------------------------------------------------------------------------

-- Negative: cannot release a non-active pledge
testCannotReleaseClosedPledge : Script ()
testCannotReleaseClosedPledge = script do
  pledgor   <- allocateParty "BorrowerBank"
  pledgee   <- allocateParty "LenderBank"
  custodian <- allocateParty "GlobalCustodian"

  pledgeCid <- mkPledge pledgor pledgee custodian

  releasedCid <- submit pledgee do
    exerciseCmd pledgeCid ReleasePledge

  submitMustFail pledgee do
    exerciseCmd releasedCid ReleasePledge

-- Negative: only beneficiary and agent together can release escrow
testOnlyAgentAndBeneficiaryCanRelease : Script ()
testOnlyAgentAndBeneficiaryCanRelease = script do
  agent       <- allocateParty "EscrowAgent"
  depositor   <- allocateParty "BuyerCorp"
  beneficiary <- allocateParty "SellerCorp"
  now         <- getTime
  let futureExpiry = addRelTime now (days 30)

  escrowCid <- mkEscrow agent depositor beneficiary futureExpiry

  -- Depositor alone cannot release
  submitMustFail depositor do
    exerciseCmd escrowCid ReleaseEscrow

  -- Agent alone cannot release  
  submitMustFail agent do
    exerciseCmd escrowCid ReleaseEscrow

-- Negative: cannot refund a released escrow
testCannotRefundReleasedEscrow : Script ()
testCannotRefundReleasedEscrow = script do
  agent       <- allocateParty "EscrowAgent"
  depositor   <- allocateParty "BuyerCorp"
  beneficiary <- allocateParty "SellerCorp"
  now         <- getTime
  let futureExpiry = addRelTime now (days 30)

  escrowCid <- mkEscrow agent depositor beneficiary futureExpiry

  releasedCid <- submitMulti [agent, beneficiary] [] do
    exerciseCmd escrowCid ReleaseEscrow

  submitMultiMustFail [agent, depositor] [] do
    exerciseCmd releasedCid RefundEscrow

-- Negative: ensure rejects zero escrow amount
testEscrowEnsurePositiveAmount : Script ()
testEscrowEnsurePositiveAmount = script do
  agent       <- allocateParty "EscrowAgent"
  depositor   <- allocateParty "BuyerCorp"
  beneficiary <- allocateParty "SellerCorp"
  now         <- getTime

  submitMultiMustFail [agent, depositor] [] do
    createCmd ConditionalEscrow with
      escrowId = "ESC-ZERO-001"
      escrowAgent = agent
      depositor = depositor
      beneficiary = beneficiary
      currency = "USD"
      amount = 0.0    -- invalid: ensure rejects
      releaseCondition = "Any condition"
      expiryTime = addRelTime now (days 30)
      correlationId = CorrelationId "CORR-ZERO-001"
      status = EscrowHeld
      disputeReason = None
      observers = []

-- ---------------------------------------------------------------------------
-- Entry Point
-- ---------------------------------------------------------------------------

runEscrowScenarioTests : Script ()
runEscrowScenarioTests = script do
  -- Escrow tests
  testEscrowRelease
  testEscrowRefund
  testEscrowDisputeAndResolution
  -- Pledge tests
  testPledgeRelease
  testPledgeEnforce
  testPledgeSubstitution
  testPledgeUpdatePerfectionRef
  testPledgeAddObserver
  -- Negative tests
  testCannotReleaseClosedPledge
  testOnlyAgentAndBeneficiaryCanRelease
  testCannotRefundReleasedEscrow
  testEscrowEnsurePositiveAmount
