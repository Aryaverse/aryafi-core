-- | Institutional Treasury Management and Cash Mobility Reference Application.
--
-- Demonstrates enterprise multi-currency liquidity pooling, concentration sweeps,
-- intercompany payment clearing, and privacy across distributed ledger accounts:
--
-- Participants:
--   - TreasuryHQ:   Corporate Global Treasury Center
--   - SubUS:        US Operating Subsidiary
--   - SubEU:        European Operating Subsidiary
--   - GlobalBank:   Cash Custody & Transaction Bank (also the payment settlement agent)
--   - Regulator:    Supervisory Authority
--
-- Lifecycle Workflow:
--   Phase 1 — Account Setup & Initial Position Funding
--     1. SubUS funded with 25M USD operating cash
--     2. SubEU funded with 20M EUR operating cash
--     3. TreasuryHQ funded with 10M USD base concentration cash
--   Phase 2 — End-of-Day Concentration Sweeping
--     4. SubUS splits 15M USD surplus from working capital
--     5. SubUS transfers 15M USD to TreasuryHQ (HQ, SubUS, and bank all authorize)
--     6. TreasuryHQ merges swept 15M with existing 10M into 25M concentration pool
--   Phase 3 — Intercompany Payment Clearing
--     7. HQ, SubUS, and GlobalBank agree an 8M USD PaymentInstruction
--     8. TreasuryHQ splits 8M and locks it to GlobalBank for the payment
--     9. GlobalBank delivers the locked cash to SubUS and confirms settlement
--   Phase 4 — Privacy Verification
--    10. SubUS cannot view SubEU's EUR position or HQ's remaining pool
module AryaFi.Test.Scenarios.TreasuryCashScenario where

import Daml.Script
import AryaFi.Finance.Cash
import AryaFi.Finance.Payment
import AryaFi.Common.Types
import AryaFi.Common.Identifiers
import DA.Date (date, Month(..))
import DA.Time (time)

testInstitutionalTreasuryCashMobility : Script ()
testInstitutionalTreasuryCashMobility = script do

  -- =========================================================================
  -- Party Allocation
  -- =========================================================================
  treasuryHQ <- allocateParty "GlobalTreasuryHQ"
  subUS <- allocateParty "USSubsidiary"
  subEU <- allocateParty "EUSubsidiary"
  globalBank <- allocateParty "TransactionBank"
  regulator <- allocateParty "SupervisoryAuthority"

  let now = time (date 2026 Sep 1) 9 0 0
  setTime now

  let hqAccount = AccountId "ACC-HQ-CONCENTRATION-01"
  let usAccount = AccountId "ACC-SUB-US-01"
  let euAccount = AccountId "ACC-SUB-EU-01"

  -- =========================================================================
  -- Phase 1: Account Setup & Initial Position Funding
  -- =========================================================================
  -- 1. SubUS funded with 25M USD
  subUsCashCid <- submitMulti [globalBank, subUS] [] do
    createCmd CashPosition with
      bank = globalBank
      accountId = usAccount
      owner = subUS
      currency = "USD"
      amount = 25000000.0
      isLocked = False
      lockReference = None
      lockHolder = None
      observers = [treasuryHQ, regulator]

  -- 2. SubEU funded with 20M EUR
  subEuCashCid <- submitMulti [globalBank, subEU] [] do
    createCmd CashPosition with
      bank = globalBank
      accountId = euAccount
      owner = subEU
      currency = "EUR"
      amount = 20000000.0
      isLocked = False
      lockReference = None
      lockHolder = None
      observers = [treasuryHQ, regulator]

  -- 3. TreasuryHQ funded with 10M USD
  hqCashCid <- submitMulti [globalBank, treasuryHQ] [] do
    createCmd CashPosition with
      bank = globalBank
      accountId = hqAccount
      owner = treasuryHQ
      currency = "USD"
      amount = 10000000.0
      isLocked = False
      lockReference = None
      lockHolder = None
      observers = [regulator]

  -- =========================================================================
  -- Phase 2: End-of-Day Concentration Sweeping
  -- =========================================================================
  -- 4. SubUS splits the 15M USD surplus from working capital.
  --    SplitCash returns (split amount, remainder).
  (subUsSweepCid, subUsWorkingCid) <- submit subUS do
    exerciseCmd subUsCashCid SplitCash with
      splitAmount = 15000000.0

  Some usWorking <- queryContractId subUS subUsWorkingCid
  assertMsg "SubUS working capital must be 10M" (usWorking.amount == 10000000.0)

  Some usSweep <- queryContractId subUS subUsSweepCid
  assertMsg "SubUS sweep position must be 15M" (usSweep.amount == 15000000.0)

  -- 5. Concentration sweep to TreasuryHQ: sender, bank, and receiver all authorize
  sweptHqCid <- submitMulti [subUS, globalBank, treasuryHQ] [] do
    exerciseCmd subUsSweepCid TransferCash with
      newOwner = treasuryHQ
      newAccountId = hqAccount
      correlationId = CorrelationId "SWEEP-US-TO-HQ-001"

  Some sweptHq <- queryContractId treasuryHQ sweptHqCid
  assertMsg "Swept cash owner must be TreasuryHQ" (sweptHq.owner == treasuryHQ)
  assertMsg "Swept amount must be 15M" (sweptHq.amount == 15000000.0)
  assertMsg "SubUS's observers do not follow the cash" (sweptHq.observers == [])

  -- 6. TreasuryHQ merges swept 15M with existing 10M into 25M unified pool
  mergedHqCid <- submit treasuryHQ do
    exerciseCmd hqCashCid MergeCash with
      otherCid = sweptHqCid

  Some unifiedPool <- queryContractId treasuryHQ mergedHqCid
  assertMsg "Unified concentration pool must equal 25M USD" (unifiedPool.amount == 25000000.0)

  -- =========================================================================
  -- Phase 3: Intercompany Payment Clearing
  -- =========================================================================
  -- 7. Payer, payee, and settlement agent agree the 8M USD payment instruction
  paymentInstructionCid <- submitMulti [treasuryHQ, subUS, globalBank] [] do
    createCmd PaymentInstruction with
      payer = treasuryHQ
      payee = subUS
      settlementAgent = globalBank
      payerAccountId = hqAccount
      payeeAccountId = usAccount
      currency = "USD"
      amount = 8000000.0
      purpose = GeneralPayment "Intercompany supplier funding"
      obligationRef = None
      correlationId = CorrelationId "CORR-PAY-001"
      idempotencyKey = IdempotencyKey "IDEMP-PAY-INTERCOMPANY-001"
      networkRef = None
      status = PendingSettlement
      observers = [regulator]

  -- 8. TreasuryHQ splits 8M from the pool and locks it to GlobalBank
  (hqPaymentCashCid, hqRemainingCid) <- submit treasuryHQ do
    exerciseCmd mergedHqCid SplitCash with
      splitAmount = 8000000.0

  Some hqRemaining <- queryContractId treasuryHQ hqRemainingCid
  assertMsg "HQ remaining pool must be 17M" (hqRemaining.amount == 17000000.0)

  lockedPaymentCashCid <- submitMulti [treasuryHQ, globalBank] [] do
    exerciseCmd hqPaymentCashCid LockCash with
      lockRef = "LOCK-PAY-INTERCOMPANY-001"
      holder = globalBank

  Some lockedCash <- queryContractId treasuryHQ lockedPaymentCashCid
  assertMsg "Cash position must be locked" lockedCash.isLocked
  assertMsg "Lock reference must match" (lockedCash.lockReference == Some "LOCK-PAY-INTERCOMPANY-001")
  assertMsg "Lock is held by the settlement bank" (lockedCash.lockHolder == Some globalBank)

  -- The payer can no longer withdraw the earmarked cash
  submitMustFail treasuryHQ do
    exerciseCmd lockedPaymentCashCid UnlockCash

  -- 9. GlobalBank delivers the locked cash to SubUS, then confirms settlement
  paidToSubUsCid <- submitMulti [globalBank, subUS] [] do
    exerciseCmd lockedPaymentCashCid SettleLockedCash with
      newOwner = subUS
      newAccountId = usAccount

  settledPaymentCid <- submit globalBank do
    exerciseCmd paymentInstructionCid ConfirmPaymentSettlement

  Some settledPayment <- queryContractId globalBank settledPaymentCid
  assertMsg "Payment status must be Settled" (settledPayment.status == Settled)

  Some subUsFinalCash <- queryContractId subUS paidToSubUsCid
  assertMsg "SubUS received 8M USD payment" (subUsFinalCash.amount == 8000000.0)
  assertMsg "Delivered cash is unlocked" (not subUsFinalCash.isLocked)

  -- =========================================================================
  -- Phase 4: Privacy Verification
  -- =========================================================================
  -- 10. SubUS sees neither SubEU's EUR position nor HQ's remaining pool
  euFromUs <- queryContractId subUS subEuCashCid
  assertMsg "SubUS cannot see SubEU's EUR position" (euFromUs == None)
  hqFromUs <- queryContractId subUS hqRemainingCid
  assertMsg "SubUS cannot see HQ's remaining pool" (hqFromUs == None)
  euFromRegulator <- queryContractId regulator subEuCashCid
  assertMsg "Regulator sees SubEU's EUR position" (euFromRegulator /= None)
  pure ()
