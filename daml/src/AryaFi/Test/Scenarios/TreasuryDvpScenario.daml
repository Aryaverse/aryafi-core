-- | Tokenized Treasury DvP Reference Application.
--
-- This scenario demonstrates the complete AryaFi platform workflow for an
-- institutional Delivery-versus-Payment (DvP) settlement of US Treasury securities.
--
-- Participants:
--   - FederalReserveBank: Cash custodian (issues and holds USD cash positions)
--   - GlobalCustodian:    Securities custodian (holds US Treasury positions)
--   - KycAuthority:       Regulates KYC attestations for both dealers
--   - ScreeningAuthority: Sanctions screening provider
--   - ComplianceOfficer:  Reviews and approves asset transfers
--   - Regulator (SEC):    Receives and acknowledges regulatory reports
--   - DTCCSettlementAgent:  Settlement agent for DvP execution
--   - DealerBankA (Seller): Institution selling US Treasury bonds
--   - DealerBankB (Buyer):  Institution buying US Treasury bonds
--
-- Workflow:
--   Phase 1 — Onboarding & Compliance Setup
--     1.  KYC attestation issued for both dealers
--     2.  Sanctions screening attestation issued for both dealers
--     3.  Eligibility policy created for US Treasury collateral
--   Phase 2 — Position Setup
--     4.  Seller creates US Treasury position (5M face value)
--     5.  Buyer creates USD cash position (5M)
--   Phase 3 — DvP Settlement
--     6.  Seller locks the security (pre-condition for DvP)
--     7.  Buyer locks the cash (pre-condition for DvP)
--     8.  DvP instruction created (all three parties sign)
--     9.  Settlement agent executes DvP atomically
--     10. Settled state verified by both parties
--   Phase 4 — Regulatory Reporting
--     11. DealerBankA submits a regulatory report to SEC
--     12. SEC acknowledges the report
--
module AryaFi.Test.Scenarios.TreasuryDvpScenario where

import Daml.Script
import AryaFi.Compliance.KYC
import AryaFi.Compliance.Sanctions
import AryaFi.Compliance.Eligibility
import AryaFi.Compliance.RegulatoryReporting
import AryaFi.Finance.Security
import AryaFi.Finance.Cash
import AryaFi.Finance.Settlement
import AryaFi.Common.Identifiers
import AryaFi.Common.Types
import AryaFi.Common.Policies (PolicyDecision(..))

-- ---------------------------------------------------------------------------
-- Reference Application: Full Tokenized Treasury DvP
-- ---------------------------------------------------------------------------

testTokenizedTreasuryDvp : Script ()
testTokenizedTreasuryDvp = script do

  -- =========================================================================
  -- Party Allocation
  -- =========================================================================
  fedReserve    <- allocateParty "FederalReserveBank"
  custodian     <- allocateParty "GlobalCustodian"
  kycAuthority  <- allocateParty "KycAuthority"
  screening     <- allocateParty "ScreeningAuthority"
  compliance    <- allocateParty "ComplianceOfficer"
  sec           <- allocateParty "SECRegulator"
  dtcc          <- allocateParty "DTCCSettlementAgent"
  seller        <- allocateParty "DealerBankA"
  buyer         <- allocateParty "DealerBankB"
  csd           <- allocateParty "DTC"

  now          <- getTime
  let futureKyc       = addRelTime now (days 365)
  let futureSanctions = addRelTime now (days 90)
  let futureSettlement = addRelTime now (days 2)  -- T+2

  -- =========================================================================
  -- Phase 1: Compliance Onboarding
  -- =========================================================================

  -- Step 1a: KYC attestation for Seller (DealerBankA)
  sellerKycCid <- submit kycAuthority do
    createCmd KycAttestation with
      authority = kycAuthority
      subjectParty = seller
      lei = Some (LEI "5493001KJTIIGC8Y1R12")
      status = KycVerified
      verificationTimestamp = now
      expiryTimestamp = futureKyc
      jurisdiction = "US"
      riskTier = "STANDARD"
      providerRef = None
      observers = [compliance, dtcc]

  -- Verify seller KYC is valid
  sellerKycValid <- submit kycAuthority do
    exerciseCmd sellerKycCid IsKycValid

  assertMsg "Seller KYC is valid" sellerKycValid

  -- Step 1b: KYC attestation for Buyer (DealerBankB)
  buyerKycCid <- submit kycAuthority do
    createCmd KycAttestation with
      authority = kycAuthority
      subjectParty = buyer
      lei = Some (LEI "529900T8BM49AURSDO55")
      status = KycVerified
      verificationTimestamp = now
      expiryTimestamp = futureKyc
      jurisdiction = "US"
      riskTier = "STANDARD"
      providerRef = None
      observers = [compliance, dtcc]

  buyerKycValid <- submit kycAuthority do
    exerciseCmd buyerKycCid IsKycValid

  assertMsg "Buyer KYC is valid" buyerKycValid

  -- Step 2a: Sanctions attestation for Seller
  sellerSanCid <- submit screening do
    createCmd SanctionsAttestation with
      screeningAuthority = screening
      subjectParty = seller
      lei = Some (LEI "5493001KJTIIGC8Y1R12")
      status = SanctionsClear
      screeningTimestamp = now
      expiryTimestamp = futureSanctions
      screeningProviderRef = "WORLD-CHECK-2026-DEALER-A"
      providerRef = None
      observers = [compliance, dtcc]

  sellerSansClear <- submit screening do
    exerciseCmd sellerSanCid IsSanctionsClear

  assertMsg "Seller is sanctions clear" sellerSansClear

  -- Step 2b: Sanctions attestation for Buyer
  buyerSanCid <- submit screening do
    createCmd SanctionsAttestation with
      screeningAuthority = screening
      subjectParty = buyer
      lei = Some (LEI "529900T8BM49AURSDO55")
      status = SanctionsClear
      screeningTimestamp = now
      expiryTimestamp = futureSanctions
      screeningProviderRef = "WORLD-CHECK-2026-DEALER-B"
      providerRef = None
      observers = [compliance, dtcc]

  buyerSansClear <- submit screening do
    exerciseCmd buyerSanCid IsSanctionsClear

  assertMsg "Buyer is sanctions clear" buyerSansClear

  -- Step 3: Eligibility policy for US Treasuries
  eligibilityCid <- submit dtcc do
    createCmd EligibilityPolicy with
      policyManager = dtcc
      policyName = "DTCC-US-Treasury-Eligible-Collateral"
      allowedJurisdictions = ["US", "GB", "DE", "CH", "SG", "JP"]
      allowedAssetClasses = ["GovernmentSecurity", "AgencySecurity"]
      minCreditRating = "AA-"
      isActive = True

  -- Check seller's security is eligible
  sellerEligibility <- submit dtcc do
    exerciseCmd eligibilityCid EvaluateEligibility with
      targetJurisdiction = "US"
      targetAssetClass = "GovernmentSecurity"

  assertMsg "US Treasury is eligible for DvP" (sellerEligibility == Approved)

  -- =========================================================================
  -- Phase 2: Position Setup
  -- =========================================================================

  -- Step 4: Seller creates US Treasury 4.25% Nov 2026 position (5M face value)
  let securityAccId = AccountId "ACC-SELLER-SEC-001"
  sellerSecCid <- submitMulti [custodian, seller] [] do
    createCmd SecurityPosition with
      custodian = custodian
      owner = seller
      accountId = securityAccId
      isin = ISIN "US912828ZM24"
      cusip = Some (CUSIP "912828ZM2")
      instrumentName = "US Treasury 4.25% Nov 2026"
      instrumentType = GovernmentBond
      quantity = 5000000.0
      couponRate = Some 0.0425
      couponType = Some FixedCoupon
      dayCountConvention = Some ActActISDA
      maturityDate = None
      seniority = Some Senior
      isLocked = False
      lockReference = None
      csdRef = None
      observers = []

  -- Step 5: Buyer creates USD cash position (5M) at Federal Reserve
  let cashAccId = AccountId "ACC-BUYER-CASH-001"
  buyerCashCid <- submitMulti [fedReserve, buyer] [] do
    createCmd CashPosition with
      bank = fedReserve
      owner = buyer
      accountId = cashAccId
      currency = "USD"
      amount = 5000000.0
      isLocked = False
      lockReference = None
      observers = []

  -- Verify positions
  sellerSecData <- queryContractId seller sellerSecCid
  assertMsg "Seller has security position" (sellerSecData /= None)

  buyerCashData <- queryContractId buyer buyerCashCid
  assertMsg "Buyer has cash position" (buyerCashData /= None)

  -- =========================================================================
  -- Phase 3: DvP Settlement
  -- =========================================================================

  -- Step 6: Seller locks the security position (pre-DvP condition)
  let dvpLockRef = "DVP-TRD-US-TREAS-4P25-NOV26-001"
  lockedSecCid <- submitMulti [seller, custodian] [] do
    exerciseCmd sellerSecCid LockSecurity with lockRef = dvpLockRef

  -- Verify security is locked
  lockedSecData <- queryContractId seller lockedSecCid
  case lockedSecData of
    None  -> abort "Locked security not visible to seller"
    Some s -> do
      assertMsg "Security is locked"          s.isLocked
      assertMsg "Lock reference set"          (s.lockReference == Some dvpLockRef)

  -- Step 7: Buyer locks the cash position (pre-DvP condition)
  lockedCashCid <- submitMulti [buyer, fedReserve] [] do
    exerciseCmd buyerCashCid LockCash with lockRef = dvpLockRef

  lockedCashData <- queryContractId buyer lockedCashCid
  case lockedCashData of
    None  -> abort "Locked cash not visible to buyer"
    Some c -> do
      assertMsg "Cash is locked"              c.isLocked
      assertMsg "Cash lock reference set"     (c.lockReference == Some dvpLockRef)

  -- Step 8: Create DvP instruction (all three parties sign)
  -- Cash consideration: 5M face × 99.5% = 4,975,000 USD (discount to par)
  dvpCid <- submitMulti [dtcc, seller, buyer] [] do
    createCmd DvpInstruction with
      settlementAgent = dtcc
      seller = seller
      buyer = buyer
      tradeId = TradeId "TRD-US-TREAS-4P25-NOV26-001"
      isin = ISIN "US912828ZM24"
      securityQuantity = 5000000.0
      sellerSecurityAccount = securityAccId
      buyerSecurityAccount = AccountId "ACC-BUYER-SEC-001"
      currency = "USD"
      cashAmount = 4975000.0
      sellerCashAccount = AccountId "ACC-SELLER-CASH-001"
      buyerCashAccount = cashAccId
      dvpModel = DvpModel1
      settlementDate = futureSettlement
      correlationId = CorrelationId "CORR-DVP-US-TREAS-001"
      idempotencyKey = IdempotencyKey "IKEY-DVP-US-TREAS-001"
      sellerSecurityLockRef = dvpLockRef
      buyerCashLockRef = dvpLockRef
      status = PendingSettlement
      failureReason = None
      observers = []

  -- Step 8b: Settlement agent adds CSD and regulator as observers
  dvpWithObsCid <- submit dtcc do
    exerciseCmd dvpCid AddDvpObserver with newObserver = csd

  -- CSD can see the DvP instruction
  csdView <- queryContractId csd dvpWithObsCid
  assertMsg "CSD can see DvP instruction" (csdView /= None)

  -- Step 9: Settlement agent executes the DvP atomically
  settledCid <- submit dtcc do
    exerciseCmd dvpWithObsCid ExecuteDvpSettlement

  -- Step 10: Verify settled state
  settledSellerView <- queryContractId seller settledCid
  case settledSellerView of
    None  -> abort "Settled DvP not visible to seller"
    Some dvp -> do
      assertMsg "Status is Settled"            (dvp.status == Settled)
      assertMsg "No failure reason"            (dvp.failureReason == None)
      assertMsg "Security quantity matches"    (dvp.securityQuantity == 5000000.0)
      assertMsg "Cash amount matches"          (dvp.cashAmount == 4975000.0)
      assertMsg "ISIN matches"                 (dvp.isin == ISIN "US912828ZM24")

  settledBuyerView <- queryContractId buyer settledCid
  assertMsg "Buyer sees settled DvP" (settledBuyerView /= None)

  settledCsdView <- queryContractId csd settledCid
  assertMsg "CSD sees settled DvP" (settledCsdView /= None)

  -- Verify DvP is finalized
  isFinalized <- submit dtcc do
    exerciseCmd settledCid IsFinalized

  assertMsg "Settled DvP is finalized" isFinalized

  -- =========================================================================
  -- Phase 4: Regulatory Reporting
  -- =========================================================================

  -- Step 11: DealerBankA submits CAT report to SEC
  catReportCid <- submit seller do
    createCmd RegulatoryReportRecord with
      reportingParty = seller
      regulator = sec
      regime = SEC_CAT
      correlationId = CorrelationId "CORR-DVP-US-TREAS-001"
      reportPayload = "{\"eventType\":\"NEW_ORDER\",\"tradeId\":\"TRD-US-TREAS-4P25-NOV26-001\",\"securityType\":\"UST\",\"isin\":\"US912828ZM24\",\"quantity\":5000000,\"price\":99.5,\"currency\":\"USD\"}"
      submissionTimestamp = now
      isAcknowledged = False
      isRejected = False
      rejectionReason = None
      amendmentCount = 0

  -- Step 12: SEC acknowledges the report
  ackedReportCid <- submit sec do
    exerciseCmd catReportCid AcknowledgeReport

  ackedReportData <- queryContractId seller ackedReportCid
  case ackedReportData of
    None  -> abort "Acknowledged report not visible to reporter"
    Some r -> do
      assertMsg "Report acknowledged"           r.isAcknowledged
      assertMsg "Regime is SEC CAT"             (r.regime == SEC_CAT)
      assertMsg "No rejection"                  (not r.isRejected)
      assertMsg "Amendment count is 0"          (r.amendmentCount == 0)

-- ---------------------------------------------------------------------------
-- Multi-Dealer Parallel DvP Scenario
-- ---------------------------------------------------------------------------
-- Tests that two independent DvP instructions can be created and settled
-- simultaneously without interfering with each other.

testParallelDvpInstructions : Script ()
testParallelDvpInstructions = script do
  dtcc      <- allocateParty "DTCCSettlementAgent"
  sellerA   <- allocateParty "DealerBankA"
  buyerA    <- allocateParty "DealerBankB"
  sellerB   <- allocateParty "DealerBankC"
  buyerB    <- allocateParty "DealerBankD"
  now       <- getTime

  let mkDvpFor s b tradeRef ikey secLock cashLock =
        submitMulti [dtcc, s, b] [] do
          createCmd DvpInstruction with
            settlementAgent = dtcc
            seller = s
            buyer = b
            tradeId = TradeId tradeRef
            isin = ISIN "US912828ZM24"
            securityQuantity = 2000000.0
            sellerSecurityAccount = AccountId ("ACC-" <> tradeRef <> "-SEC")
            buyerSecurityAccount = AccountId ("ACC-" <> tradeRef <> "-BUY-SEC")
            currency = "USD"
            cashAmount = 1990000.0
            sellerCashAccount = AccountId ("ACC-" <> tradeRef <> "-SELL-CASH")
            buyerCashAccount = AccountId ("ACC-" <> tradeRef <> "-BUY-CASH")
            dvpModel = DvpModel1
            settlementDate = now
            correlationId = CorrelationId ("CORR-" <> tradeRef)
            idempotencyKey = IdempotencyKey ikey
            sellerSecurityLockRef = secLock
            buyerCashLockRef = cashLock
            status = PendingSettlement
            failureReason = None
            observers = []

  dvpACid <- mkDvpFor sellerA buyerA "TRD-DVP-PARALLEL-001" "IKEY-PAR-001" "SEC-LOCK-A" "CASH-LOCK-A"
  dvpBCid <- mkDvpFor sellerB buyerB "TRD-DVP-PARALLEL-002" "IKEY-PAR-002" "SEC-LOCK-B" "CASH-LOCK-B"

  -- Execute both independently
  settledACid <- submit dtcc do exerciseCmd dvpACid ExecuteDvpSettlement
  settledBCid <- submit dtcc do exerciseCmd dvpBCid ExecuteDvpSettlement

  -- Verify A settled
  viewA <- queryContractId sellerA settledACid
  case viewA of
    None  -> abort "DvP A not settled"
    Some d -> assertMsg "DvP A settled" (d.status == Settled)

  -- Verify B settled
  viewB <- queryContractId sellerB settledBCid
  case viewB of
    None  -> abort "DvP B not settled"
    Some d -> assertMsg "DvP B settled" (d.status == Settled)

  -- DealerBankA cannot see DealerBankC's DvP (privacy)
  privacyView <- queryContractId sellerA settledBCid
  assertMsg "DealerBankA cannot see DealerBankC's DvP" (privacyView == None)

-- ---------------------------------------------------------------------------
-- Entry Point
-- ---------------------------------------------------------------------------

runTreasuryDvpScenario : Script ()
runTreasuryDvpScenario = script do
  testTokenizedTreasuryDvp
  testParallelDvpInstructions
