-- | Multi-signatory authorization test suite.
--
-- Verifies that multi-party co-signature requirements are enforced
-- across all contract types that require bilateral or tri-party authorization:
--   1. Obligation: single-party creation fails, bilateral succeeds
--   2. Cash: transfer requires owner+bank, single-party transfer fails
--   3. Security: transfer requires owner+custodian, single-party fails
--   4. Repo: creation requires seller+buyer+custodian, pairwise fails
--   5. Loan: amendment/cancellation via bilateral choices
--   6. Margin: dispute resolution requires caller+payer joint authorization
module AryaFi.Test.Authorization.MultiSignatoryTest where

import Daml.Script
import DA.Time (time)
import DA.Date (date, Month(..))
import AryaFi.Finance.Obligation
import AryaFi.Finance.Cash
import AryaFi.Finance.Security
import AryaFi.Contracts.Repo
import AryaFi.Contracts.Margin
import AryaFi.Common.Types
import AryaFi.Common.Identifiers

-- ---------------------------------------------------------------------------
-- 1. Obligation: bilateral signatory enforcement
-- ---------------------------------------------------------------------------

multiSignatoryObligationTest : Script ()
multiSignatoryObligationTest = script do
  obligorParty <- allocateParty "ObligorBank"
  obligeeParty <- allocateParty "ObligeeBank"

  -- Single party creation must fail because both parties are signatories
  submitMustFail obligorParty do
    createCmd FinancialObligation with
      obligor = obligorParty
      obligee = obligeeParty
      currency = "USD"
      amount = 5000000.0
      dueDate = time (date 2026 Jun 30) 12 0 0
      status = Pending
      obligationRef = "OBL-2026-001"
      correlationId = CorrelationId "CORR-OBL-001"
      description = "Loan principal repayment tranche 1"
      agentObserver = None
      externalRef = None

  -- Multi-party submission succeeds
  oblCid <- submitMulti [obligorParty, obligeeParty] [] do
    createCmd FinancialObligation with
      obligor = obligorParty
      obligee = obligeeParty
      currency = "USD"
      amount = 5000000.0
      dueDate = time (date 2026 Jun 30) 12 0 0
      status = Pending
      obligationRef = "OBL-2026-001"
      correlationId = CorrelationId "CORR-OBL-001"
      description = "Loan principal repayment tranche 1"
      agentObserver = None
      externalRef = None

  -- Discharge obligation by obligee
  _dischargedCid <- submit obligeeParty do
    exerciseCmd oblCid DischargeObligation

  pure ()

-- ---------------------------------------------------------------------------
-- 2. Obligation: cancellation requires bilateral consent
-- ---------------------------------------------------------------------------

multiSignatoryObligationCancellation : Script ()
multiSignatoryObligationCancellation = script do
  obligor <- allocateParty "ObligorCorp"
  obligee <- allocateParty "ObligeeBank"

  oblCid <- submitMulti [obligor, obligee] [] do
    createCmd FinancialObligation with
      obligor = obligor
      obligee = obligee
      currency = "EUR"
      amount = 2500000.0
      dueDate = time (date 2026 Dec 31) 16 0 0
      status = Pending
      obligationRef = "OBL-EUR-001"
      correlationId = CorrelationId "CORR-OBL-EUR-001"
      description = "Cross-border payment obligation"
      agentObserver = None
      externalRef = None

  -- Obligor alone cannot cancel (requires both parties)
  submitMustFail obligor do
    exerciseCmd oblCid CancelObligation with
      cancellationReason = "Unilateral cancel attempt"

  -- Obligee alone cannot cancel either
  submitMustFail obligee do
    exerciseCmd oblCid CancelObligation with
      cancellationReason = "Unilateral cancel attempt"

  -- Both parties together can cancel
  _cancelledCid <- submitMulti [obligor, obligee] [] do
    exerciseCmd oblCid CancelObligation with
      cancellationReason = "Mutual agreement to cancel trade"

  pure ()

-- ---------------------------------------------------------------------------
-- 3. Cash: transfer requires owner+bank bilateral
-- ---------------------------------------------------------------------------

multiSignatoryCashTransfer : Script ()
multiSignatoryCashTransfer = script do
  bank <- allocateParty "CustodyBank"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  let acc = AccountId "ACC-ALICE-USD-AUTH"

  cashCid <- submitMulti [bank, alice] [] do
    createCmd CashPosition with
      bank = bank
      owner = alice
      accountId = acc
      currency = "USD"
      amount = 1000000.0
      isLocked = False
      lockReference = None
      lockHolder = None
      observers = []

  -- Owner alone cannot transfer (requires bank co-auth)
  submitMustFail alice do
    exerciseCmd cashCid TransferCash with
      newOwner = bob
      newAccountId = AccountId "ACC-BOB-USD"
      correlationId = CorrelationId "CORR-XFR-001"

  -- Bank alone cannot transfer either
  submitMustFail bank do
    exerciseCmd cashCid TransferCash with
      newOwner = bob
      newAccountId = AccountId "ACC-BOB-USD"
      correlationId = CorrelationId "CORR-XFR-001"

  -- Owner and bank cannot impose a position on the receiver without its consent
  submitMultiMustFail [alice, bank] [] do
    exerciseCmd cashCid TransferCash with
      newOwner = bob
      newAccountId = AccountId "ACC-BOB-USD"
      correlationId = CorrelationId "CORR-XFR-001"

  -- Owner, bank, and receiver together succeed
  _transferredCid <- submitMulti [alice, bank, bob] [] do
    exerciseCmd cashCid TransferCash with
      newOwner = bob
      newAccountId = AccountId "ACC-BOB-USD"
      correlationId = CorrelationId "CORR-XFR-001"

  pure ()

-- ---------------------------------------------------------------------------
-- 4. Security: lock requires owner+custodian bilateral
-- ---------------------------------------------------------------------------

multiSignatorySecurityLock : Script ()
multiSignatorySecurityLock = script do
  custodian <- allocateParty "CustodianBNY"
  alice <- allocateParty "AliceFund"
  let acc = AccountId "ACC-ALICE-GOV-AUTH"

  secCid <- submitMulti [custodian, alice] [] do
    createCmd SecurityPosition with
      custodian = custodian
      owner = alice
      accountId = acc
      isin = ISIN "US912828ZM50"
      cusip = None
      instrumentName = "US Treasury 4.25% Nov 2026"
      instrumentType = GovernmentBond
      quantity = 5000000.0
      couponRate = Some 0.0425
      couponType = Some FixedCoupon
      dayCountConvention = Some Act360
      maturityDate = Some (time (date 2026 Nov 15) 0 0 0)
      seniority = Some Senior
      isLocked = False
      lockReference = None
      lockHolder = None
      csdRef = None
      observers = []

  -- Owner alone cannot lock
  submitMustFail alice do
    exerciseCmd secCid LockSecurity with lockRef = "REPO-COLL-001"; holder = custodian

  -- Custodian alone cannot lock
  submitMustFail custodian do
    exerciseCmd secCid LockSecurity with lockRef = "REPO-COLL-001"; holder = custodian

  -- Both together can lock
  lockedCid <- submitMulti [alice, custodian] [] do
    exerciseCmd secCid LockSecurity with lockRef = "REPO-COLL-001"; holder = custodian

  -- Owner alone cannot unlock
  submitMustFail alice do
    exerciseCmd lockedCid UnlockSecurity

  -- Both together can unlock
  _unlockedCid <- submitMulti [alice, custodian] [] do
    exerciseCmd lockedCid UnlockSecurity

  pure ()

-- ---------------------------------------------------------------------------
-- 5. Repo: tri-party creation requires seller+buyer+custodian
-- ---------------------------------------------------------------------------

multiSignatoryRepoCreation : Script ()
multiSignatoryRepoCreation = script do
  seller <- allocateParty "SellerDealer"
  buyer <- allocateParty "BuyerFund"
  custodian <- allocateParty "CustodianBNY"

  let now = time (date 2026 Sep 1) 0 0 0
  let maturity = time (date 2026 Sep 15) 0 0 0

  let repoFields = RepoAgreement with
        repoId = "REPO-AUTH-001"
        seller = seller
        buyer = buyer
        tripartyAgent = None
        custodian = custodian
        isin = ISIN "US912828ZM50"
        collateralQuantity = 5000000.0
        collateralAccountId = AccountId "ACC-TRI-AUTH"
        haircut = 0.02
        currency = "USD"
        purchasePrice = 4900000.0
        repurchasePrice = 4910000.0
        repoRate = 0.053
        dayCountConvention = Act360
        startDate = now
        endDate = maturity
        status = RepoPendingOpening
        openingSettlementRef = None
        closingSettlementRef = None
        correlationId = CorrelationId "CORR-REPO-AUTH"
        observers = []

  -- Seller+Buyer only (no custodian) must fail
  submitMultiMustFail [seller, buyer] [] do createCmd repoFields

  -- Seller+Custodian only (no buyer) must fail
  submitMultiMustFail [seller, custodian] [] do createCmd repoFields

  -- All three together succeed
  _repoCid <- submitMulti [seller, buyer, custodian] [] do
    createCmd repoFields

  pure ()

-- ---------------------------------------------------------------------------
-- 6. Repo: collateral substitution requires seller+buyer bilateral
-- ---------------------------------------------------------------------------

multiSignatoryRepoSubstitution : Script ()
multiSignatoryRepoSubstitution = script do
  seller <- allocateParty "SellerDealer"
  buyer <- allocateParty "BuyerFund"
  custodian <- allocateParty "CustodianBNY"

  let now = time (date 2026 Sep 1) 0 0 0
  let maturity = time (date 2026 Sep 15) 0 0 0

  repoCid <- submitMulti [seller, buyer, custodian] [] do
    createCmd RepoAgreement with
      repoId = "REPO-AUTH-002"
      seller = seller
      buyer = buyer
      tripartyAgent = None
      custodian = custodian
      isin = ISIN "US912828ZM50"
      collateralQuantity = 10000000.0
      collateralAccountId = AccountId "ACC-TRI-AUTH-002"
      haircut = 0.02
      currency = "USD"
      purchasePrice = 9800000.0
      repurchasePrice = 9820000.0
      repoRate = 0.053
      dayCountConvention = Act360
      startDate = now
      endDate = maturity
      status = RepoActive
      openingSettlementRef = Some "SETTLE-OPEN-001"
      closingSettlementRef = None
      correlationId = CorrelationId "CORR-REPO-AUTH-002"
      observers = []

  -- Seller alone cannot substitute collateral
  submitMustFail seller do
    exerciseCmd repoCid SubstituteCollateral with
      newIsin = ISIN "US912828XG01"
      newQuantity = 10200000.0
      newHaircut = 0.025

  -- Both seller+buyer together succeed
  _substitutedCid <- submitMulti [seller, buyer] [] do
    exerciseCmd repoCid SubstituteCollateral with
      newIsin = ISIN "US912828XG01"
      newQuantity = 10200000.0
      newHaircut = 0.025

  pure ()

-- ---------------------------------------------------------------------------
-- 7. Margin: dispute resolution requires caller+payer bilateral
-- ---------------------------------------------------------------------------

multiSignatoryMarginResolution : Script ()
multiSignatoryMarginResolution = script do
  caller <- allocateParty "BuyerMarginCaller"
  payer <- allocateParty "SellerMarginPayer"
  custodian <- allocateParty "Custodian"

  let deadline = time (date 2026 Sep 15) 16 0 0

  marginCid <- submitMulti [caller, payer] [] do
    createCmd MarginCall with
      marginCallId = "MC-AUTH-001"
      caller = caller
      payer = payer
      custodian = custodian
      marginType = VariationMargin
      relatedAgreementRef = "REPO-AUTH-002"
      currency = "USD"
      requiredAmount = 500000.0
      deadline = deadline
      status = MarginCallIssued
      correlationId = CorrelationId "CORR-MC-AUTH"
      observers = []

  -- Payer disputes the margin call
  disputedCid <- submit payer do
    exerciseCmd marginCid DisputeMarginCall with
      disputeReason = "Incorrect collateral valuation"

  -- Caller alone cannot resolve dispute (requires bilateral)
  submitMustFail caller do
    exerciseCmd disputedCid ResolveMarginDispute with adjustedAmount = 350000.0

  -- Payer alone cannot resolve dispute (requires bilateral)
  submitMustFail payer do
    exerciseCmd disputedCid ResolveMarginDispute with adjustedAmount = 350000.0

  -- Both together can resolve
  _resolvedCid <- submitMulti [caller, payer] [] do
    exerciseCmd disputedCid ResolveMarginDispute with adjustedAmount = 350000.0

  pure ()
