-- | Privacy and observer visibility test suite.
--
-- Verifies Canton's sub-transaction privacy model across multiple contract types:
--   1. Account: non-observer cannot query, observer can after explicit grant
--   2. Cash: isolated visibility, observer management (add/remove)
--   3. Security: bilateral custodian-owner privacy, third-party blindness
--   4. Loan: observer visibility scoping for regulators and agent banks
--   5. Repo: tri-party privacy boundaries, regulator observer add
--   6. KYC: subject party observes own attestation, third party is blind
--
-- These tests prove that only parties with explicit signatory, observer,
-- or controller roles can access contract state — foundational for
-- institutional confidentiality between counterparties.
module AryaFi.Test.Privacy.ObserverPrivacyTest where

import Daml.Script
import DA.Time (time)
import DA.Date (date, Month(..))
import AryaFi.Finance.Account
import AryaFi.Finance.Cash
import AryaFi.Finance.Security
import AryaFi.Contracts.Loan
import AryaFi.Compliance.KYC
import AryaFi.Common.Identifiers
import AryaFi.Common.Types

-- ---------------------------------------------------------------------------
-- 1. Account: non-observer blindness and explicit observer grant
-- ---------------------------------------------------------------------------

observerPrivacyVerification : Script ()
observerPrivacyVerification = script do
  custodian <- allocateParty "BankCustodian"
  alice <- allocateParty "AliceCorp"
  bob <- allocateParty "BobCorp"
  auditor <- allocateParty "RegulatoryAuditor"

  let aliceAcc = AccountId "ACC-ALICE-SEC"

  accCid <- submitMulti [custodian, alice] [] do
    createCmd Account with
      custodian = custodian
      owner = alice
      accountId = aliceAcc
      accountType = SegregatedCustody
      description = "Alice Segregated Account"
      isFrozen = False
      observers = []

  -- Bob should NOT be able to see Alice's account
  bobQuery <- submit bob do
    queryContractId bob accCid

  assert (bobQuery == None)

  -- Alice adds Auditor as observer
  updatedAccCid <- submit alice do
    exerciseCmd accCid AddObserver with newObserver = auditor

  -- Auditor can now query the contract
  auditorQuery <- submit auditor do
    queryContractId auditor updatedAccCid

  assert (auditorQuery /= None)
  pure ()

-- ---------------------------------------------------------------------------
-- 2. Cash Position: bilateral privacy — third party is blind
-- ---------------------------------------------------------------------------

cashPositionPrivacy : Script ()
cashPositionPrivacy = script do
  bank <- allocateParty "CustodyBank"
  alice <- allocateParty "AliceCorp"
  bob <- allocateParty "BobCorp"
  settlementAgent <- allocateParty "SettlementAgent"

  let acc = AccountId "ACC-ALICE-USD-01"

  cashCid <- submitMulti [bank, alice] [] do
    createCmd CashPosition with
      bank = bank
      owner = alice
      accountId = acc
      currency = "USD"
      amount = 5000000.0
      isLocked = False
      lockReference = None
      observers = []

  -- Bob cannot see Alice's cash position
  bobCashQuery <- submit bob do
    queryContractId bob cashCid
  assert (bobCashQuery == None)

  -- Bank can see it (signatory)
  bankCashQuery <- submit bank do
    queryContractId bank cashCid
  assert (bankCashQuery /= None)

  -- Alice adds settlement agent as observer for DvP coordination
  cashCidWithObserver <- submit alice do
    exerciseCmd cashCid AddCashObserver with newObserver = settlementAgent

  -- Settlement agent can now see the cash position
  agentQuery <- submit settlementAgent do
    queryContractId settlementAgent cashCidWithObserver
  assert (agentQuery /= None)

  -- Bob is still blind
  bobStillBlind <- submit bob do
    queryContractId bob cashCidWithObserver
  assert (bobStillBlind == None)

  -- Alice removes settlement agent's visibility
  cashCidNoObserver <- submit alice do
    exerciseCmd cashCidWithObserver RemoveCashObserver with
      observerToRemove = settlementAgent

  -- Settlement agent can no longer see it
  agentGone <- submit settlementAgent do
    queryContractId settlementAgent cashCidNoObserver
  assert (agentGone == None)

  pure ()

-- ---------------------------------------------------------------------------
-- 3. Security Position: custodian-owner bilateral privacy
-- ---------------------------------------------------------------------------

securityPositionPrivacy : Script ()
securityPositionPrivacy = script do
  custodian <- allocateParty "CustodianBNY"
  alice <- allocateParty "AliceFund"
  bob <- allocateParty "BobDealer"
  tripartyAgent <- allocateParty "TriPartyAgent"

  let acc = AccountId "ACC-ALICE-GOV-01"

  secCid <- submitMulti [custodian, alice] [] do
    createCmd SecurityPosition with
      custodian = custodian
      owner = alice
      accountId = acc
      isin = "US912828ZM24"
      cusip = Some "912828ZM2"
      instrumentName = "US Treasury 4.25% Nov 2026"
      instrumentType = GovernmentBond
      quantity = 10000000.0
      couponRate = Some 0.0425
      couponType = Some FixedCoupon
      dayCountConvention = Some Act360
      maturityDate = Some (time (date 2026 Nov 15) 0 0 0)
      seniority = Some Senior
      isLocked = False
      lockReference = None
      csdRef = None
      observers = []

  -- Bob (counterparty) cannot see Alice's security position
  bobSecQuery <- submit bob do
    queryContractId bob secCid
  assert (bobSecQuery == None)

  -- Alice adds tri-party agent as observer for repo collateral coordination
  secCidWithAgent <- submit alice do
    exerciseCmd secCid AddSecurityObserver with newObserver = tripartyAgent

  -- Tri-party agent can now see it
  agentSecQuery <- submit tripartyAgent do
    queryContractId tripartyAgent secCidWithAgent
  assert (agentSecQuery /= None)

  -- Bob is still blind to Alice's security holdings
  bobStillBlind <- submit bob do
    queryContractId bob secCidWithAgent
  assert (bobStillBlind == None)

  pure ()

-- ---------------------------------------------------------------------------
-- 4. Institutional Loan: observer scoping for regulators
-- ---------------------------------------------------------------------------

loanObserverPrivacy : Script ()
loanObserverPrivacy = script do
  lender <- allocateParty "LenderBank"
  borrower <- allocateParty "BorrowerCorp"
  regulator <- allocateParty "Regulator"
  thirdParty <- allocateParty "UnrelatedBank"

  let now = time (date 2026 Sep 1) 0 0 0
  let maturity = time (date 2027 Sep 1) 0 0 0

  loanCid <- submitMulti [lender, borrower] [] do
    createCmd InstitutionalLoan with
      loanId = "LOAN-PRIV-001"
      lender = lender
      borrower = borrower
      agentBank = None
      currency = "USD"
      facilityLimit = 50000000.0
      drawnPrincipal = 20000000.0
      accruedInterest = 125000.0
      interestRate = 0.065
      dayCountConvention = Act360
      startDate = now
      maturityDate = maturity
      collateralPledgeRef = None
      status = Active
      defaultReason = None
      correlationId = CorrelationId "CORR-LOAN-PRIV"
      observers = []

  -- Unrelated bank cannot see loan contract
  thirdPartyQuery <- submit thirdParty do
    queryContractId thirdParty loanCid
  assert (thirdPartyQuery == None)

  -- Regulator also cannot see loan before being added as observer
  regQuery <- submit regulator do
    queryContractId regulator loanCid
  assert (regQuery == None)

  -- Lender adds regulator as observer
  loanCidWithReg <- submit lender do
    exerciseCmd loanCid AddLoanObserver with newObserver = regulator

  -- Regulator can now see the loan
  regAfterAdd <- submit regulator do
    queryContractId regulator loanCidWithReg
  assert (regAfterAdd /= None)

  -- Unrelated bank is still blind
  thirdPartyStillBlind <- submit thirdParty do
    queryContractId thirdParty loanCidWithReg
  assert (thirdPartyStillBlind == None)

  pure ()

-- ---------------------------------------------------------------------------
-- 5. KYC Attestation: subject observes own status, third party is blind
-- ---------------------------------------------------------------------------

kycAttestationPrivacy : Script ()
kycAttestationPrivacy = script do
  authority <- allocateParty "KYCAuthority"
  subject <- allocateParty "SubjectBank"
  competitor <- allocateParty "CompetitorBank"
  custodian <- allocateParty "Custodian"

  let now = time (date 2026 Sep 10) 10 0 0
  let expiry = time (date 2027 Sep 10) 10 0 0

  kycCid <- submit authority do
    createCmd KycAttestation with
      authority = authority
      subjectParty = subject
      lei = Some "SUBJ12345678901234"
      status = KycVerified
      verificationTimestamp = now
      expiryTimestamp = expiry
      jurisdiction = "US"
      riskTier = "STANDARD"
      providerRef = None
      observers = []

  -- Subject can see own KYC attestation (observer via subjectParty)
  subjectQuery <- submit subject do
    queryContractId subject kycCid
  assert (subjectQuery /= None)

  -- Competitor cannot see subject's KYC status
  competitorQuery <- submit competitor do
    queryContractId competitor kycCid
  assert (competitorQuery == None)

  -- Authority adds custodian as observer for compliance gating
  kycCidWithCustodian <- submit authority do
    exerciseCmd kycCid AddKycObserver with newObserver = custodian

  -- Custodian can now see the KYC attestation
  custodianQuery <- submit custodian do
    queryContractId custodian kycCidWithCustodian
  assert (custodianQuery /= None)

  -- Competitor remains blind
  competitorStillBlind <- submit competitor do
    queryContractId competitor kycCidWithCustodian
  assert (competitorStillBlind == None)

  pure ()

-- ---------------------------------------------------------------------------
-- 6. Cash: ensure observer cannot perform unauthorized actions
-- ---------------------------------------------------------------------------

cashObserverCannotControl : Script ()
cashObserverCannotControl = script do
  bank <- allocateParty "CustodyBank"
  alice <- allocateParty "Alice"
  observer <- allocateParty "SettlementAgent"

  let acc = AccountId "ACC-ALICE-USD-02"

  cashCid <- submitMulti [bank, alice] [] do
    createCmd CashPosition with
      bank = bank
      owner = alice
      accountId = acc
      currency = "USD"
      amount = 2000000.0
      isLocked = False
      lockReference = None
      observers = [observer]

  -- Observer can see it
  obsQuery <- submit observer do
    queryContractId observer cashCid
  assert (obsQuery /= None)

  -- Observer cannot split (requires owner)
  submitMustFail observer do
    exerciseCmd cashCid SplitCash with splitAmount = 1000000.0

  -- Observer cannot add another observer (requires owner)
  submitMustFail observer do
    exerciseCmd cashCid AddCashObserver with newObserver = bank

  pure ()
