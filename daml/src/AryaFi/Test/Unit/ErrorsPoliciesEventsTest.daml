-- | Unit tests for AryaFi.Common.Errors, AryaFi.Common.Policies,
-- and AryaFi.Common.Events modules.
-- Run via: daml test --test-pattern ErrorsPoliciesEventsTest
module AryaFi.Test.Unit.ErrorsPoliciesEventsTest where

import Daml.Script
import AryaFi.Common.Errors
import AryaFi.Common.Policies
import AryaFi.Common.Events
import AryaFi.Common.Identifiers (CorrelationId(..))
import DA.Date (date, Month(..))
import DA.Time (time)

-- ---------------------------------------------------------------------------
-- Errors Tests
-- ---------------------------------------------------------------------------

testRequirePassesOnTrue : Script ()
testRequirePassesOnTrue = script do
  require True "This should not fail"
  pure ()

testRequirePositiveAccepts : Script ()
testRequirePositiveAccepts = script do
  requirePositive 0.01 "amount"
  requirePositive 1000000.0 "largeAmount"
  pure ()

testRequireNonEmptyAccepts : Script ()
testRequireNonEmptyAccepts = script do
  requireNonEmpty "ISIN-US912828ZM24" "isin"
  pure ()

testRequireNonEmptyListAccepts : Script ()
testRequireNonEmptyListAccepts = script do
  requireNonEmptyList [1, 2, 3] "parties"
  pure ()

testRequireRateInRangeAccepts : Script ()
testRequireRateInRangeAccepts = script do
  requireRateInRange 0.05 0.0 1.0 "repoRate"
  requireRateInRange 0.0  0.0 1.0 "zeroRate"
  requireRateInRange 1.0  0.0 1.0 "maxRate"
  pure ()

-- Negative: require fails on False
testRequireFailsOnFalse : Script ()
testRequireFailsOnFalse = script do
  expectFailure "require False should abort" do
    require False "Intentional failure"

-- Negative: requirePositive rejects zero
testRequirePositiveRejectsZero : Script ()
testRequirePositiveRejectsZero = script do
  expectFailure "requirePositive 0 should abort" do
    requirePositive 0.0 "amount"

-- Negative: requirePositive rejects negative
testRequirePositiveRejectsNegative : Script ()
testRequirePositiveRejectsNegative = script do
  expectFailure "requirePositive -1 should abort" do
    requirePositive (-1.0) "amount"

-- Negative: requireNonEmpty rejects empty string
testRequireNonEmptyRejectsEmpty : Script ()
testRequireNonEmptyRejectsEmpty = script do
  expectFailure "requireNonEmpty '' should abort" do
    requireNonEmpty "" "field"

-- Negative: requireRateInRange rejects out-of-range
testRequireRateOutOfRange : Script ()
testRequireRateOutOfRange = script do
  expectFailure "rate > 1.0 should abort" do
    requireRateInRange 1.5 0.0 1.0 "repoRate"

-- Error record construction
testErrorRecordConstruction : Script ()
testErrorRecordConstruction = script do
  let err = AryaFiError with
        category = ComplianceViolation
        code = "KYC_EXPIRED_001"
        message = "KYC attestation has expired for party"
        details = ["Party: BankA", "Expiry: 2026-03-01", "Required: KYC_VERIFIED"]

  assertMsg "Error category" (err.category == ComplianceViolation)
  assertMsg "Error code" (err.code == "KYC_EXPIRED_001")
  assertMsg "Error details count" (length err.details == 3)

-- ---------------------------------------------------------------------------
-- Policy Decision Tests
-- ---------------------------------------------------------------------------

testApprovedDecision : Script ()
testApprovedDecision = script do
  assertMsg "isApproved Approved" (isApproved Approved == True)
  assertMsg "isRejected Approved" (isRejected Approved == False)
  assertMsg "requiresReview Approved" (requiresReview Approved == False)
  assertMsg "getDecisionReason Approved = None" (getDecisionReason Approved == None)

testRejectedDecision : Script ()
testRejectedDecision = script do
  let d = Rejected "JURISDICTION_NOT_PERMITTED"
  assertMsg "isApproved Rejected" (isApproved d == False)
  assertMsg "isRejected Rejected" (isRejected d == True)
  assertMsg "getDecisionReason Rejected" (getDecisionReason d == Some "JURISDICTION_NOT_PERMITTED")

testManualReviewDecision : Script ()
testManualReviewDecision = script do
  let d = RequiresManualReview "KYC_RISK_SCORE_HIGH"
  assertMsg "requiresReview" (requiresReview d == True)
  assertMsg "isApproved ManualReview" (isApproved d == False)
  assertMsg "isRejected ManualReview" (isRejected d == False)

-- AND combinator tests
testAndDecisionBothApproved : Script ()
testAndDecisionBothApproved = script do
  let result = andDecision Approved Approved
  assertMsg "Approved AND Approved = Approved" (result == Approved)

testAndDecisionOneRejected : Script ()
testAndDecisionOneRejected = script do
  let result = andDecision Approved (Rejected "SANCTION_HIT")
  assertMsg "Approved AND Rejected = Rejected" (isRejected result)

  let result2 = andDecision (Rejected "KYC_FAILED") Approved
  assertMsg "Rejected AND Approved = Rejected" (isRejected result2)

testAndDecisionBothRejected : Script ()
testAndDecisionBothRejected = script do
  let result = andDecision (Rejected "KYC_EXPIRED") (Rejected "SANCTION_HIT")
  case result of
    Rejected reason ->
      assertMsg "Both reasons combined" (reason == "KYC_EXPIRED; SANCTION_HIT")
    _ -> abort "Expected Rejected"

testAndDecisionWithManualReview : Script ()
testAndDecisionWithManualReview = script do
  let result = andDecision Approved (RequiresManualReview "RISK_REVIEW")
  assertMsg "Approved AND ManualReview = ManualReview" (requiresReview result)

-- OR combinator tests
testOrDecisionEitherApproved : Script ()
testOrDecisionEitherApproved = script do
  let r1 = orDecision Approved (Rejected "X")
  assertMsg "Approved OR Rejected = Approved" (r1 == Approved)

  let r2 = orDecision (Rejected "X") Approved
  assertMsg "Rejected OR Approved = Approved" (r2 == Approved)

testOrDecisionBothRejected : Script ()
testOrDecisionBothRejected = script do
  let result = orDecision (Rejected "ERR1") (Rejected "ERR2")
  assertMsg "Both rejected means still rejected" (isRejected result)

-- Policy rule descriptor
testPolicyRuleConstruction : Script ()
testPolicyRuleConstruction = script do
  let rule = PolicyRule with
        ruleId = "RULE-KYC-001"
        ruleName = "KYC Verification Required"
        description = "All counterparties must have valid KYC before trading"
        enabled = True
        jurisdictions = ["US", "GB", "SG"]
        assetClasses = ["GovernmentSecurity", "CorporateBond"]

  assertMsg "Rule ID" (rule.ruleId == "RULE-KYC-001")
  assertMsg "Rule enabled" (rule.enabled == True)
  assertMsg "3 jurisdictions" (length rule.jurisdictions == 3)

-- ---------------------------------------------------------------------------
-- Events Tests
-- ---------------------------------------------------------------------------

testAuditLogCreation : Script ()
testAuditLogCreation = script do
  platform <- allocateParty "Platform"
  bankA    <- allocateParty "BankA"
  bankB    <- allocateParty "BankB"

  now <- getTime

  auditCid <- submit platform do
    createCmd AuditLog with
      operator = platform
      parties = [bankA, bankB]
      contractIdRef = "CONTRACT-DVP-001"
      correlationId = CorrelationId "CORR-2026-001"
      eventType = DvpExecuted
      timestamp = now
      details = "DvP settled: 10M US Treasury vs 9.95M USD cash"

  -- BankA should be able to query this event
  auditForA <- queryContractId bankA auditCid
  assertMsg "BankA can see audit event" (auditForA /= None)

  -- BankB should also be able to query
  auditForB <- queryContractId bankB auditCid
  assertMsg "BankB can see audit event" (auditForB /= None)

testAuditLogPrivacy : Script ()
testAuditLogPrivacy = script do
  platform  <- allocateParty "Platform"
  bankA     <- allocateParty "BankA"
  outsider  <- allocateParty "Outsider"

  now <- getTime

  auditCid <- submit platform do
    createCmd AuditLog with
      operator = platform
      parties = [bankA]   -- Outsider NOT in observer list
      contractIdRef = "CONTRACT-LOAN-001"
      correlationId = CorrelationId "CORR-LOAN-001"
      eventType = ContractCreated "InstitutionalLoan"
      timestamp = now
      details = "Loan facility created: 25M USD @ 6.5%"

  -- Outsider should NOT be able to see this
  outsiderView <- queryContractId outsider auditCid
  assertMsg "Outsider cannot see confidential audit event" (outsiderView == None)

testMkStatusChangeEvent : Script ()
testMkStatusChangeEvent = script do
  let event = mkStatusChangeEvent "Active" "Defaulted"
  case event of
    StatusChanged from to ->
      assertMsg "Status changed from Active to Defaulted"
        (from == "Active" && to == "Defaulted")
    _ -> abort "Expected StatusChanged"

-- ---------------------------------------------------------------------------
-- Entry Point
-- ---------------------------------------------------------------------------

-- | Helper to run a script that is expected to fail
expectFailure : Text -> Script a -> Script ()
expectFailure msg action = do
  result <- try action
  case result of
    Left (_ : AnyException) -> pure ()
    Right _                 -> abort ("Expected failure but succeeded: " <> msg)

runErrorsPoliciesEventsTests : Script ()
runErrorsPoliciesEventsTests = script do
  testRequirePassesOnTrue
  testRequirePositiveAccepts
  testRequireNonEmptyAccepts
  testRequireNonEmptyListAccepts
  testRequireRateInRangeAccepts
  testRequireFailsOnFalse
  testRequirePositiveRejectsZero
  testRequirePositiveRejectsNegative
  testRequireNonEmptyRejectsEmpty
  testRequireRateOutOfRange
  testErrorRecordConstruction
  testApprovedDecision
  testRejectedDecision
  testManualReviewDecision
  testAndDecisionBothApproved
  testAndDecisionOneRejected
  testAndDecisionBothRejected
  testAndDecisionWithManualReview
  testOrDecisionEitherApproved
  testOrDecisionBothRejected
  testPolicyRuleConstruction
  testAuditLogCreation
  testAuditLogPrivacy
  testMkStatusChangeEvent
