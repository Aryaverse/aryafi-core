-- | Unit tests for all AryaFi Compliance modules.
-- Covers: KYC attestation lifecycle, sanctions screening, eligibility policy evaluation,
-- transfer restriction rules, ownership concentration limits, and regulatory reporting.
module AryaFi.Test.Unit.ComplianceTest where

import Daml.Script
import AryaFi.Compliance.KYC
import AryaFi.Compliance.Sanctions
import AryaFi.Compliance.Eligibility
import AryaFi.Compliance.TransferRestrictions
import AryaFi.Compliance.OwnershipRestrictions
import AryaFi.Compliance.RegulatoryReporting
import AryaFi.Common.Identifiers
import AryaFi.Common.Policies (PolicyDecision(..))

-- ---------------------------------------------------------------------------
-- KYC Tests
-- ---------------------------------------------------------------------------

testKycCreate : Script ()
testKycCreate = script do
  authority <- allocateParty "KycAuthority"
  subject   <- allocateParty "DealerBankA"
  now       <- getTime
  let future = addRelTime now (days 365)

  kycCid <- submit authority do
    createCmd KycAttestation with
      authority = authority
      subjectParty = subject
      lei = Some (LEI "5493001KJTIIGC8Y1R12")
      status = KycPending
      verificationTimestamp = now
      expiryTimestamp = future
      jurisdiction = "US"
      riskTier = "STANDARD"
      providerRef = None
      observers = []

  kycData <- queryContractId authority kycCid
  case kycData of
    None  -> abort "KYC attestation not visible to authority"
    Some k -> do
      assertMsg "Status is Pending"           (k.status == KycPending)
      assertMsg "Jurisdiction set"            (k.jurisdiction == "US")
      assertMsg "Risk tier set"               (k.riskTier == "STANDARD")
      assertMsg "No observers initially"      (k.observers == [])

  -- Subject can also see it
  subjectView <- queryContractId subject kycCid
  assertMsg "Subject sees attestation"        (subjectView /= None)

testKycUpdateToVerified : Script ()
testKycUpdateToVerified = script do
  authority <- allocateParty "KycAuthority"
  subject   <- allocateParty "DealerBankB"
  now       <- getTime
  let future = addRelTime now (days 365)

  kycCid <- submit authority do
    createCmd KycAttestation with
      authority = authority
      subjectParty = subject
      lei = None
      status = KycPending
      verificationTimestamp = now
      expiryTimestamp = future
      jurisdiction = "GB"
      riskTier = "STANDARD"
      providerRef = None
      observers = []

  verifiedCid <- submit authority do
    exerciseCmd kycCid UpdateKycStatus with
      newStatus = KycVerified
      newExpiry = addRelTime now (days 365)
      newTimestamp = now

  verifiedData <- queryContractId authority verifiedCid
  case verifiedData of
    None  -> abort "Updated KYC not found"
    Some k -> assertMsg "Status is Verified" (k.status == KycVerified)

testKycRevokeAttestation : Script ()
testKycRevokeAttestation = script do
  authority <- allocateParty "KycAuthority"
  subject   <- allocateParty "DealerBankC"
  now       <- getTime
  let future = addRelTime now (days 365)

  kycCid <- submit authority do
    createCmd KycAttestation with
      authority = authority
      subjectParty = subject
      lei = None
      status = KycVerified
      verificationTimestamp = now
      expiryTimestamp = future
      jurisdiction = "SG"
      riskTier = "STANDARD"
      providerRef = None
      observers = []

  revokedCid <- submit authority do
    exerciseCmd kycCid RevokeKyc with
      reason = "AML_ALERT_WATCHLIST_MATCH"
      revokeTimestamp = now

  revokedData <- queryContractId authority revokedCid
  case revokedData of
    None  -> abort "Revoked KYC not found"
    Some k ->
      case k.status of
        KycRejected r -> assertMsg "Reason stored" (r == "AML_ALERT_WATCHLIST_MATCH")
        _             -> abort "Expected KycRejected status"

