-- ---------------------------------------------------------------------------
-- Eligibility Tests
-- ---------------------------------------------------------------------------

testEligibilityApprove : Script ()
testEligibilityApprove = script do
  manager <- allocateParty "PolicyManager"

  polCid <- submit manager do
    createCmd EligibilityPolicy with
      policyManager = manager
      policyName = "TriPartyCollateralEligibility"
      allowedJurisdictions = ["US", "GB", "DE", "CH"]
      allowedAssetClasses = ["GovernmentSecurity", "CorporateBond"]
      minCreditRating = "BBB-"
      isActive = True

  decision <- submit manager do
    exerciseCmd polCid EvaluateEligibility with
      targetJurisdiction = "US"
      targetAssetClass = "GovernmentSecurity"

  assertMsg "Valid jurisdiction+asset class is Approved"
    (decision == Approved)

testEligibilityRejectJurisdiction : Script ()
testEligibilityRejectJurisdiction = script do
  manager <- allocateParty "PolicyManager"

  polCid <- submit manager do
    createCmd EligibilityPolicy with
      policyManager = manager
      policyName = "TriPartyCollateralEligibility"
      allowedJurisdictions = ["US", "GB"]
      allowedAssetClasses = ["GovernmentSecurity"]
      minCreditRating = "A"
      isActive = True

  decision <- submit manager do
    exerciseCmd polCid EvaluateEligibility with
      targetJurisdiction = "CN"
      targetAssetClass = "GovernmentSecurity"

  case decision of
    Rejected _ -> pure ()
    Approved   -> abort "Expected Rejected for disallowed jurisdiction"

testEligibilityInactivePolicy : Script ()
testEligibilityInactivePolicy = script do
  manager <- allocateParty "PolicyManager"

  polCid <- submit manager do
    createCmd EligibilityPolicy with
      policyManager = manager
      policyName = "InactivePolicy"
      allowedJurisdictions = ["US"]
      allowedAssetClasses = ["GovernmentSecurity"]
      minCreditRating = "BBB-"
      isActive = False

  decision <- submit manager do
    exerciseCmd polCid EvaluateEligibility with
      targetJurisdiction = "US"
      targetAssetClass = "GovernmentSecurity"

  case decision of
    Rejected r -> assertMsg "Inactive reason" (r == "Policy is inactive")
    Approved   -> abort "Inactive policy should not approve"

testEligibilityActivateDeactivate : Script ()
testEligibilityActivateDeactivate = script do
  manager <- allocateParty "PolicyManager"

  polCid <- submit manager do
    createCmd EligibilityPolicy with
      policyManager = manager
      policyName = "TogglePolicy"
      allowedJurisdictions = ["US"]
      allowedAssetClasses = ["GovernmentSecurity"]
      minCreditRating = "BBB-"
      isActive = True

  deactivatedCid <- submit manager do
    exerciseCmd polCid DeactivatePolicy

  decision <- submit manager do
    exerciseCmd deactivatedCid EvaluateEligibility with
      targetJurisdiction = "US"
      targetAssetClass = "GovernmentSecurity"

  case decision of
    Rejected _ -> pure ()
    Approved   -> abort "Deactivated policy should reject"

  reactivatedCid <- submit manager do
    exerciseCmd deactivatedCid ActivatePolicy

  decision2 <- submit manager do
    exerciseCmd reactivatedCid EvaluateEligibility with
      targetJurisdiction = "US"
      targetAssetClass = "GovernmentSecurity"

  assertMsg "Reactivated policy approves valid request" (decision2 == Approved)

-- ---------------------------------------------------------------------------
-- TransferRestrictions Tests
-- ---------------------------------------------------------------------------

testTransferRestrictionCreate : Script ()
testTransferRestrictionCreate = script do
  co <- allocateParty "ComplianceOfficer"

  ruleCid <- submit co do
    createCmd TransferRestrictionRule with
      complianceOfficer = co
      isin = ISIN "US912828ZM24"
      regulatoryCategory = Rule144A
      holdingPeriodDays = 0
      whitelistRequired = True
      lockupExpiry = None
      isActive = True

  ruleData <- queryContractId co ruleCid
  case ruleData of
    None   -> abort "Rule not found"
    Some r -> do
      assertMsg "Rule is active"          (r.isActive == True)
      assertMsg "Category is Rule144A"    (r.regulatoryCategory == Rule144A)
      assertMsg "Whitelist required"      (r.whitelistRequired == True)

testTransferRestrictionAllowedNoLockup : Script ()
testTransferRestrictionAllowedNoLockup = script do
  co <- allocateParty "ComplianceOfficer"

  ruleCid <- submit co do
    createCmd TransferRestrictionRule with
      complianceOfficer = co
      isin = ISIN "US912828ZM24"
      regulatoryCategory = RetailUnrestricted
      holdingPeriodDays = 0
      whitelistRequired = False
      lockupExpiry = None
      isActive = True

  allowed <- submit co do
    exerciseCmd ruleCid IsTransferAllowed

  assertMsg "No lockup → transfer allowed" allowed

testTransferRestrictionNotAllowedWhenInactive : Script ()
testTransferRestrictionNotAllowedWhenInactive = script do
  co <- allocateParty "ComplianceOfficer"

  ruleCid <- submit co do
    createCmd TransferRestrictionRule with
      complianceOfficer = co
      isin = ISIN "US912828ZM24"
      regulatoryCategory = RegD_506c
      holdingPeriodDays = 180
      whitelistRequired = True
      lockupExpiry = None
      isActive = False

  allowed <- submit co do
    exerciseCmd ruleCid IsTransferAllowed

  assertMsg "Inactive rule → transfer not allowed" (not allowed)

testTransferRestrictionActivateDeactivate : Script ()
testTransferRestrictionActivateDeactivate = script do
  co <- allocateParty "ComplianceOfficer"

  ruleCid <- submit co do
    createCmd TransferRestrictionRule with
      complianceOfficer = co
      isin = ISIN "US912828ZM24"
      regulatoryCategory = RegS
      holdingPeriodDays = 40
      whitelistRequired = False
      lockupExpiry = None
      isActive = True

  deactivatedCid <- submit co do
    exerciseCmd ruleCid DeactivateRule

  deactData <- queryContractId co deactivatedCid
  case deactData of
    None  -> abort "Deactivated rule not found"
    Some r -> assertMsg "Rule is inactive" (not r.isActive)

  reactivatedCid <- submit co do
    exerciseCmd deactivatedCid ActivateRule

  reactData <- queryContractId co reactivatedCid
  case reactData of
    None  -> abort "Reactivated rule not found"
    Some r -> assertMsg "Rule is active again" r.isActive

-- Negative: cannot deactivate an already-inactive rule
testCannotDeactivateInactiveRule : Script ()
testCannotDeactivateInactiveRule = script do
  co <- allocateParty "ComplianceOfficer"

  ruleCid <- submit co do
    createCmd TransferRestrictionRule with
      complianceOfficer = co
      isin = ISIN "US912828ZM24"
      regulatoryCategory = Rule144A
      holdingPeriodDays = 0
      whitelistRequired = False
      lockupExpiry = None
      isActive = False

  submitMustFail co do
    exerciseCmd ruleCid DeactivateRule

-- ---------------------------------------------------------------------------
-- OwnershipRestrictions Tests
-- ---------------------------------------------------------------------------

testOwnershipRestrictionCreate : Script ()
testOwnershipRestrictionCreate = script do
  regulator <- allocateParty "Regulator"

  restrictionCid <- submit regulator do
    createCmd OwnershipRestriction with
      regulator = regulator
      isin = ISIN "US912828ZM24"
      maxOwnershipPercentage = 5.0
      maxHoldingQuantity = 50000000.0
      disallowedJurisdictions = ["IR", "KP"]
      isActive = True

  data_ <- queryContractId regulator restrictionCid
  case data_ of
    None  -> abort "Restriction not found"
    Some r -> do
      assertMsg "Max % set"     (r.maxOwnershipPercentage == 5.0)
      assertMsg "Max qty set"   (r.maxHoldingQuantity == 50000000.0)
      assertMsg "Jurisdictions" (r.disallowedJurisdictions == ["IR", "KP"])

testCheckOwnershipLimitApproved : Script ()
testCheckOwnershipLimitApproved = script do
  regulator <- allocateParty "Regulator"

  restrictionCid <- submit regulator do
    createCmd OwnershipRestriction with
      regulator = regulator
      isin = ISIN "US912828ZM24"
      maxOwnershipPercentage = 5.0
      maxHoldingQuantity = 50000000.0
      disallowedJurisdictions = ["IR", "KP"]
      isActive = True

  decision <- submit regulator do
    exerciseCmd restrictionCid CheckOwnershipLimit with
      proposedQuantity = 10000000.0
      proposedPercentage = 2.0
      holderJurisdiction = "US"

  assertMsg "Within limits → Approved" (decision == Approved)

testCheckOwnershipLimitExceedsQuantity : Script ()
testCheckOwnershipLimitExceedsQuantity = script do
  regulator <- allocateParty "Regulator"

  restrictionCid <- submit regulator do
    createCmd OwnershipRestriction with
      regulator = regulator
      isin = ISIN "US912828ZM24"
      maxOwnershipPercentage = 5.0
      maxHoldingQuantity = 50000000.0
      disallowedJurisdictions = []
      isActive = True

  decision <- submit regulator do
    exerciseCmd restrictionCid CheckOwnershipLimit with
      proposedQuantity = 60000000.0
      proposedPercentage = 2.0
      holderJurisdiction = "US"

  case decision of
    Rejected _ -> pure ()
    Approved   -> abort "Quantity exceeds max → should be Rejected"

testCheckOwnershipLimitDisallowedJurisdiction : Script ()
testCheckOwnershipLimitDisallowedJurisdiction = script do
  regulator <- allocateParty "Regulator"

  restrictionCid <- submit regulator do
    createCmd OwnershipRestriction with
      regulator = regulator
      isin = ISIN "US912828ZM24"
      maxOwnershipPercentage = 5.0
      maxHoldingQuantity = 50000000.0
      disallowedJurisdictions = ["CN", "RU"]
      isActive = True

  decision <- submit regulator do
    exerciseCmd restrictionCid CheckOwnershipLimit with
      proposedQuantity = 1000000.0
      proposedPercentage = 0.1
      holderJurisdiction = "CN"

  case decision of
    Rejected _ -> pure ()
    Approved   -> abort "Disallowed jurisdiction → should be Rejected"

-- ---------------------------------------------------------------------------
-- RegulatoryReporting Tests
-- ---------------------------------------------------------------------------

testRegulatoryReportCreate : Script ()
testRegulatoryReportCreate = script do
  reporter  <- allocateParty "DealerBankA"
  regulator <- allocateParty "SECRegulator"
  now       <- getTime

  reportCid <- submit reporter do
    createCmd RegulatoryReportRecord with
      reportingParty = reporter
      regulator = regulator
      regime = SEC_CAT
      correlationId = CorrelationId "CORR-CAT-2026-001"
      reportPayload = "{\"tradeId\":\"TRD-001\",\"assetClass\":\"UST\",\"notional\":5000000}"
      submissionTimestamp = now
      isAcknowledged = False
      isRejected = False
      rejectionReason = None
      amendmentCount = 0

  reportData <- queryContractId reporter reportCid
  case reportData of
    None  -> abort "Report not found"
    Some r -> do
      assertMsg "Not acknowledged" (not r.isAcknowledged)
      assertMsg "Not rejected"     (not r.isRejected)
      assertMsg "Amendment count"  (r.amendmentCount == 0)
      assertMsg "Regime is SEC_CAT" (r.regime == SEC_CAT)

testRegulatoryReportAcknowledge : Script ()
testRegulatoryReportAcknowledge = script do
  reporter  <- allocateParty "DealerBankA"
  regulator <- allocateParty "SECRegulator"
  now       <- getTime

  reportCid <- submit reporter do
    createCmd RegulatoryReportRecord with
      reportingParty = reporter
      regulator = regulator
      regime = EMIR_Refit
      correlationId = CorrelationId "CORR-EMIR-2026-001"
      reportPayload = "{\"swap\":\"IRS-USD-5Y\"}"
      submissionTimestamp = now
      isAcknowledged = False
      isRejected = False
      rejectionReason = None
      amendmentCount = 0

  ackedCid <- submit regulator do
    exerciseCmd reportCid AcknowledgeReport

  ackedData <- queryContractId reporter ackedCid
  case ackedData of
    None  -> abort "Acknowledged report not found"
    Some r -> assertMsg "Report acknowledged" r.isAcknowledged

testRegulatoryReportRejectAndAmend : Script ()
testRegulatoryReportRejectAndAmend = script do
  reporter  <- allocateParty "DealerBankA"
  regulator <- allocateParty "MiFIRRegulator"
  now       <- getTime

  reportCid <- submit reporter do
    createCmd RegulatoryReportRecord with
      reportingParty = reporter
      regulator = regulator
      regime = MiFIR
      correlationId = CorrelationId "CORR-MIFIR-2026-001"
      reportPayload = "{\"trade\":\"INCOMPLETE_PAYLOAD\"}"
      submissionTimestamp = now
      isAcknowledged = False
      isRejected = False
      rejectionReason = None
      amendmentCount = 0

  -- Regulator rejects the report
  rejectedCid <- submit regulator do
    exerciseCmd reportCid RejectReport with
      reason = "MISSING_REQUIRED_FIELD_LEI"

  rejectedData <- queryContractId reporter rejectedCid
  case rejectedData of
    None  -> abort "Rejected report not found"
    Some r -> do
      assertMsg "Is rejected"        r.isRejected
      assertMsg "Rejection reason"   (r.rejectionReason == Some "MISSING_REQUIRED_FIELD_LEI")
      assertMsg "Not acknowledged"   (not r.isAcknowledged)

  -- Reporter submits an amendment
  amendedCid <- submit reporter do
    exerciseCmd rejectedCid SubmitAmendment with
      amendedPayload = "{\"trade\":\"COMPLETE\",\"lei\":\"5493001KJTIIGC8Y1R12\"}"
      amendmentTimestamp = now

  amendedData <- queryContractId reporter amendedCid
  case amendedData of
    None  -> abort "Amended report not found"
    Some r -> do
      assertMsg "Amendment count incremented" (r.amendmentCount == 1)
      assertMsg "Rejection cleared"           (not r.isRejected)
      assertMsg "Rejection reason cleared"    (r.rejectionReason == None)
      assertMsg "Not acknowledged yet"        (not r.isAcknowledged)

-- Negative: cannot acknowledge a rejected report
testCannotAcknowledgeRejectedReport : Script ()
testCannotAcknowledgeRejectedReport = script do
  reporter  <- allocateParty "DealerBankA"
  regulator <- allocateParty "MASRegulator"
  now       <- getTime

  reportCid <- submit reporter do
    createCmd RegulatoryReportRecord with
      reportingParty = reporter
      regulator = regulator
      regime = MAS_TradeReporting
      correlationId = CorrelationId "CORR-MAS-2026-001"
      reportPayload = "{\"trade\":\"BAD\"}"
      submissionTimestamp = now
      isAcknowledged = False
      isRejected = True
      rejectionReason = Some "VALIDATION_FAILED"
      amendmentCount = 0

  submitMustFail regulator do
    exerciseCmd reportCid AcknowledgeReport

-- ---------------------------------------------------------------------------
-- Entry Point
-- ---------------------------------------------------------------------------

runComplianceTests : Script ()
runComplianceTests = script do
  -- KYC
  testKycCreate
  testKycUpdateToVerified
  testKycRevokeAttestation
  testKycIsValid
  testKycIsValidWhenPending
  testKycAddObserver
  testKycNonAuthorityCannotRevoke
  -- Sanctions
  testSanctionsCreate
  testSanctionsBlockParty
  testSanctionsClearParty
  testSanctionsIsClear
  testSanctionsNotClearWhenBlocked
  testSanctionsCannotClearAlreadyClear
  -- Eligibility
  testEligibilityApprove
  testEligibilityRejectJurisdiction
  testEligibilityInactivePolicy
  testEligibilityActivateDeactivate
  -- TransferRestrictions
  testTransferRestrictionCreate
  testTransferRestrictionAllowedNoLockup
  testTransferRestrictionNotAllowedWhenInactive
