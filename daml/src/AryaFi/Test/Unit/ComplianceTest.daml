testKycIsValidWhenPending : Script ()
testKycIsValidWhenPending = script do
  authority <- allocateParty "KycAuthority"
  subject   <- allocateParty "DealerBankE"
  now       <- getTime
  let future = addRelTime now (days 365)

  kycCid <- submit authority do
    createCmd KycAttestation with
      authority = authority
      subjectParty = subject
      lei = None
      status = KycPending
      verificationTimestamp = now
      expiryTimestamp = future
      jurisdiction = "AE"
      riskTier = "STANDARD"
      providerRef = None
      observers = []

  isValid <- submit authority do
    exerciseCmd kycCid IsKycValid

  assertMsg "Pending KYC is NOT valid" (not isValid)

testKycAddObserver : Script ()
testKycAddObserver = script do
  authority  <- allocateParty "KycAuthority"
  subject    <- allocateParty "DealerBankF"
  custodian  <- allocateParty "Custodian"
  now        <- getTime
  let future = addRelTime now (days 365)

  kycCid <- submit authority do
    createCmd KycAttestation with
      authority = authority
      subjectParty = subject
      lei = None
      status = KycVerified
      verificationTimestamp = now
      expiryTimestamp = future
      jurisdiction = "US"
      riskTier = "STANDARD"
      providerRef = None
      observers = []

  kycWithObsCid <- submit authority do
    exerciseCmd kycCid AddKycObserver with newObserver = custodian

  -- Custodian can now see the KYC
  custodianView <- queryContractId custodian kycWithObsCid
  assertMsg "Custodian sees KYC after being added" (custodianView /= None)

-- Negative: non-authority cannot revoke
testKycNonAuthorityCannotRevoke : Script ()
testKycNonAuthorityCannotRevoke = script do
  authority <- allocateParty "KycAuthority"
  subject   <- allocateParty "DealerBankG"
  outsider  <- allocateParty "OutsiderCorp"
  now       <- getTime
  let future = addRelTime now (days 365)

  kycCid <- submit authority do
    createCmd KycAttestation with
      authority = authority
      subjectParty = subject
      lei = None
      status = KycVerified
      verificationTimestamp = now
      expiryTimestamp = future
      jurisdiction = "US"
      riskTier = "STANDARD"
      providerRef = None
      observers = []

  submitMustFail outsider do
    exerciseCmd kycCid RevokeKyc with
      reason = "UNAUTHORIZED_ATTEMPT"
      revokeTimestamp = now

-- ---------------------------------------------------------------------------
-- Sanctions Tests
-- ---------------------------------------------------------------------------

testSanctionsCreate : Script ()
testSanctionsCreate = script do
  screening <- allocateParty "ScreeningAuthority"
  subject   <- allocateParty "InstitutionA"
  now       <- getTime
  let future = addRelTime now (days 90)

  sanCid <- submit screening do
    createCmd SanctionsAttestation with
      screeningAuthority = screening
      subjectParty = subject
      lei = Some (LEI "529900T8BM49AURSDO55")
      status = SanctionsClear
      screeningTimestamp = now
      expiryTimestamp = future
      screeningProviderRef = "ACME-SDN-SCREEN-2026-001"
      providerRef = None
      observers = []

  sanData <- queryContractId screening sanCid
  case sanData of
    None  -> abort "Sanctions attestation not found"
    Some s -> assertMsg "Status is Clear" (s.status == SanctionsClear)

testSanctionsBlockParty : Script ()
testSanctionsBlockParty = script do
  screening <- allocateParty "ScreeningAuthority"
  subject   <- allocateParty "FlaggedInstitution"
  now       <- getTime
  let future = addRelTime now (days 90)

  sanCid <- submit screening do
    createCmd SanctionsAttestation with
      screeningAuthority = screening
      subjectParty = subject
      lei = None
      status = SanctionsClear
      screeningTimestamp = now
      expiryTimestamp = future
      screeningProviderRef = "ACME-SDN-SCREEN-2026-002"
      providerRef = None
      observers = []

  blockedCid <- submit screening do
    exerciseCmd sanCid BlockParty with
      sanctionsListRef = "OFAC-SDN-MATCH-ENTITY-12345"
      blockTimestamp = now

  blockedData <- queryContractId screening blockedCid
  case blockedData of
    None  -> abort "Blocked sanctions attestation not found"
    Some s ->
      case s.status of
        SanctionsBlocked ref -> assertMsg "List ref stored" (ref == "OFAC-SDN-MATCH-ENTITY-12345")
        _                    -> abort "Expected SanctionsBlocked status"

testSanctionsClearParty : Script ()
testSanctionsClearParty = script do
  screening <- allocateParty "ScreeningAuthority"
  subject   <- allocateParty "ResolvedInstitution"
  now       <- getTime
  let future = addRelTime now (days 90)

  sanCid <- submit screening do
    createCmd SanctionsAttestation with
      screeningAuthority = screening
      subjectParty = subject
      lei = None
      status = SanctionsFlagged "POTENTIAL_MATCH_PENDING_REVIEW"
      screeningTimestamp = now
      expiryTimestamp = future
      screeningProviderRef = "ACME-SDN-SCREEN-2026-003"
      providerRef = None
      observers = []

  clearedCid <- submit screening do
    exerciseCmd sanCid ClearParty with
      clearanceRef = "ACME-CLEARANCE-2026-003"
      clearTimestamp = now

  clearedData <- queryContractId screening clearedCid
  case clearedData of
    None  -> abort "Cleared sanctions attestation not found"
    Some s -> assertMsg "Status is Clear" (s.status == SanctionsClear)

