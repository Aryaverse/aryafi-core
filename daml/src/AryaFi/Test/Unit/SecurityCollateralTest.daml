-- | Unit tests for AryaFi.Finance.Security and AryaFi.Finance.Collateral.
-- Covers: security split/lock/transfer, collateral lifecycle, revaluation,
-- substitution, dispute resolution, and negative authorization cases.
module AryaFi.Test.Unit.SecurityCollateralTest where

import Daml.Script
import AryaFi.Finance.Security
import AryaFi.Finance.Collateral as Collateral hiding (Active)
import AryaFi.Common.Identifiers
import AryaFi.Common.Types as Types hiding (Active)
import qualified AryaFi.Finance.Collateral as Collateral

-- ---------------------------------------------------------------------------
-- Helpers
-- ---------------------------------------------------------------------------

mkGovtBond : Party -> Party -> AccountId -> Amount -> Script (ContractId SecurityPosition)
mkGovtBond custodian owner accId qty = submitMulti [custodian, owner] [] do
  createCmd SecurityPosition with
    custodian = custodian
    owner = owner
    accountId = accId
    isin = ISIN "US912828ZM50"
    cusip = Some (CUSIP "912828ZM5")
    instrumentName = "US Treasury 4.25% Nov 2026"
    instrumentType = GovernmentBond
    quantity = qty
    couponRate = Some 0.0425
    couponType = Some FixedCoupon
    dayCountConvention = Some ActActISDA
    maturityDate = None
    seniority = Some Senior
    isLocked = False
    lockReference = None
    lockHolder = None
    csdRef = None
    observers = []

mkCollateral : Party -> Party -> Party -> AccountId -> Amount -> Amount -> Rate
             -> Script (ContractId CollateralPosition)
mkCollateral provider receiver custodian accId qty mv haircut =
  submitMulti [provider, receiver, custodian] [] do
    createCmd CollateralPosition with
      collateralProvider = provider
      collateralReceiver = receiver
      custodian = custodian
      accountId = accId
      assetClass = GovernmentSecurity
      isin = ISIN "US912828ZM50"
      quantity = qty
      marketValue = mv
      haircut = haircut
      settlementCurrency = "USD"
      obligationRef = "REPO-2026-001"
      lockReference = "LOCK-SECURITY-001"
      status = Allocated
      externalRef = None
      observers = []

-- ---------------------------------------------------------------------------
-- SecurityPosition Tests
-- ---------------------------------------------------------------------------

testSecurityCreation : Script ()
testSecurityCreation = script do
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "DealerBankA"

  secCid <- mkGovtBond custodian owner (AccountId "ACC-SEC-001") 10000000.0

  secData <- queryContractId owner secCid
  case secData of
    None -> abort "Security not visible to owner"
    Some s -> do
      assertMsg "ISIN set" (s.isin == ISIN "US912828ZM50")
      assertMsg "Quantity set" (s.quantity == 10000000.0)
      assertMsg "Not locked" (s.isLocked == False)
      assertMsg "Instrument type" (s.instrumentType == GovernmentBond)
      assertMsg "Coupon rate set" (s.couponRate == Some 0.0425)

testSecuritySplitPreservesTotal : Script ()
testSecuritySplitPreservesTotal = script do
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "DealerBankA"
  let total = 10000000.0
  secCid <- mkGovtBond custodian owner (AccountId "ACC-SPLIT-001") total

  (s1Cid, s2Cid) <- submit owner do
    exerciseCmd secCid SplitSecurity with splitQuantity = 3000000.0

  s1 <- queryContractId owner s1Cid
  s2 <- queryContractId owner s2Cid
  case (s1, s2) of
    (Some p1, Some p2) -> do
      assertMsg "Split piece 1" (p1.quantity == 3000000.0)
      assertMsg "Split piece 2" (p2.quantity == 7000000.0)
      assertMsg "Total preserved" (p1.quantity + p2.quantity == total)
      assertMsg "Piece 1 not locked" (p1.isLocked == False)
      assertMsg "Piece 2 not locked" (p2.isLocked == False)
    _ -> abort "Split positions not found"

testSecurityLockAndUnlock : Script ()
testSecurityLockAndUnlock = script do
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "DealerBankA"

  secCid <- mkGovtBond custodian owner (AccountId "ACC-LOCK-001") 5000000.0

  lockedCid <- submitMulti [owner, custodian] [] do
    exerciseCmd secCid LockSecurity with lockRef = "REPO-OPENING-2026-001"; holder = custodian

  lockedData <- queryContractId owner lockedCid
  case lockedData of
    None -> abort "Locked security not found"
    Some s -> do
      assertMsg "Is locked" (s.isLocked == True)
      assertMsg "Lock ref" (s.lockReference == Some "REPO-OPENING-2026-001")

  unlockedCid <- submitMulti [owner, custodian] [] do
    exerciseCmd lockedCid UnlockSecurity

  unlockedData <- queryContractId owner unlockedCid
  case unlockedData of
    None -> abort "Unlocked security not found"
    Some s -> do
      assertMsg "Not locked" (s.isLocked == False)
      assertMsg "No lock ref" (s.lockReference == None)

testSecurityTransfer : Script ()
testSecurityTransfer = script do
  custodian <- allocateParty "GlobalCustodian"
  seller    <- allocateParty "SellerDealer"
  buyer     <- allocateParty "BuyerDealer"

  secCid <- mkGovtBond custodian seller (AccountId "ACC-SELLER-001") 5000000.0

  transferredCid <- submitMulti [seller, custodian, buyer] [] do
    exerciseCmd secCid TransferSecurity with
      newOwner = buyer
      newAccountId = AccountId "ACC-BUYER-001"
      correlationId = CorrelationId "CORR-DVP-001"

  buyerView <- queryContractId buyer transferredCid
  case buyerView of
    None -> abort "Buyer cannot see transferred security"
    Some s -> do
      assertMsg "Owner is buyer" (s.owner == buyer)
      assertMsg "Account updated" (s.accountId == AccountId "ACC-BUYER-001")
      assertMsg "Quantity preserved" (s.quantity == 5000000.0)
      assertMsg "Observers cleared" (s.observers == [])

testSecurityObserverScoping : Script ()
testSecurityObserverScoping = script do
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "DealerBankA"
  agent     <- allocateParty "SettlementAgent"
  outsider  <- allocateParty "OutsiderCorp"

  secCid <- mkGovtBond custodian owner (AccountId "ACC-OBS-001") 1000000.0

  outsiderView <- queryContractId outsider secCid
  assertMsg "Outsider cannot see security" (outsiderView == None)

  withAgentCid <- submit owner do
    exerciseCmd secCid AddSecurityObserver with newObserver = agent

  agentView <- queryContractId agent withAgentCid
  assertMsg "Agent can see security" (agentView /= None)

  withoutAgentCid <- submit owner do
    exerciseCmd withAgentCid RemoveSecurityObserver with observerToRemove = agent

  agentView2 <- queryContractId agent withoutAgentCid
  assertMsg "Agent no longer sees security" (agentView2 == None)

-- Negative: cannot split locked security
testCannotSplitLockedSecurity : Script ()
testCannotSplitLockedSecurity = script do
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "DealerBankA"

  secCid <- mkGovtBond custodian owner (AccountId "ACC-SPLK-001") 5000000.0

  lockedCid <- submitMulti [owner, custodian] [] do
    exerciseCmd secCid LockSecurity with lockRef = "REPO-001"; holder = custodian

  submitMustFail owner do
    exerciseCmd lockedCid SplitSecurity with splitQuantity = 1000000.0

-- Negative: cannot transfer locked security
testCannotTransferLockedSecurity : Script ()
testCannotTransferLockedSecurity = script do
  custodian <- allocateParty "GlobalCustodian"
  seller    <- allocateParty "SellerDealer"
  buyer     <- allocateParty "BuyerDealer"

  secCid <- mkGovtBond custodian seller (AccountId "ACC-TRLK-001") 5000000.0

  lockedCid <- submitMulti [seller, custodian] [] do
    exerciseCmd secCid LockSecurity with lockRef = "REPO-001"; holder = custodian

  submitMultiMustFail [seller, custodian] [] do
    exerciseCmd lockedCid TransferSecurity with
      newOwner = buyer
      newAccountId = AccountId "ACC-BUYER-TRLK-001"
      correlationId = CorrelationId "CORR-001"

-- Negative: split amount >= total is rejected
testSplitCannotExceedTotal : Script ()
testSplitCannotExceedTotal = script do
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "DealerBankA"
  secCid <- mkGovtBond custodian owner (AccountId "ACC-SPEX-001") 5000000.0

  submitMustFail owner do
    exerciseCmd secCid SplitSecurity with splitQuantity = 5000000.0

-- Negative: ensure rejects zero quantity
testSecurityEnsurePositiveQuantity : Script ()
testSecurityEnsurePositiveQuantity = script do
  custodian <- allocateParty "GlobalCustodian"
  owner     <- allocateParty "DealerBankA"

  submitMultiMustFail [custodian, owner] [] do
    createCmd SecurityPosition with
      custodian = custodian
      owner = owner
      accountId = AccountId "ACC-ZERO-001"
      isin = ISIN "US912828ZM50"
      cusip = None
      instrumentName = "Test Bond"
      instrumentType = GovernmentBond
      quantity = 0.0
      couponRate = None
      couponType = None
      dayCountConvention = None
      maturityDate = None
      seniority = None
      isLocked = False
      lockReference = None
      lockHolder = None
      csdRef = None
      observers = []

-- ---------------------------------------------------------------------------
-- CollateralPosition Tests
-- ---------------------------------------------------------------------------

testCollateralCreationAndActivation : Script ()
testCollateralCreationAndActivation = script do
  provider  <- allocateParty "BorrowerBank"
  receiver  <- allocateParty "LenderBank"
  custodian <- allocateParty "TriPartyCustodian"

  collCid <- mkCollateral provider receiver custodian (AccountId "ACC-COLL-001")
               10000000.0 9950000.0 0.02

  collData <- queryContractId receiver collCid
  case collData of
    None -> abort "Collateral not visible to receiver"
    Some c -> do
      assertMsg "Status Allocated" (c.status == Allocated)
      assertMsg "Market value" (c.marketValue == 9950000.0)
      assertMsg "Haircut" (c.haircut == 0.02)

  activeCid <- submit custodian do
    exerciseCmd collCid ActivateCollateral

  activeData <- queryContractId provider activeCid
  case activeData of
    None -> abort "Active collateral not visible to provider"
    Some c -> assertMsg "Status Active" (c.status == Collateral.Active)

testCollateralValue : Script ()
testCollateralValue = script do
  provider  <- allocateParty "BorrowerBank"
  receiver  <- allocateParty "LenderBank"
  custodian <- allocateParty "TriPartyCustodian"

  collCid <- mkCollateral provider receiver custodian (AccountId "ACC-VAL-001")
               1000000.0 950000.0 0.05

  activeCid <- submit custodian do exerciseCmd collCid ActivateCollateral

  -- Collateral value = 950,000 × (1 - 0.05) = 902,500
  collValue <- submit custodian do
    exerciseCmd activeCid GetCollateralValue

  assertMsg "Collateral value = 902,500" (collValue == 902500.0)

testCollateralRevaluation : Script ()
testCollateralRevaluation = script do
  provider  <- allocateParty "BorrowerBank"
  receiver  <- allocateParty "LenderBank"
  custodian <- allocateParty "TriPartyCustodian"

  collCid <- mkCollateral provider receiver custodian (AccountId "ACC-REVAL-001")
               10000000.0 9900000.0 0.02

  activeCid <- submit custodian do exerciseCmd collCid ActivateCollateral

  -- Mark-to-market: price dropped
  revaluedCid <- submit custodian do
    exerciseCmd activeCid RevalueCollateral with
      newMarketValue = 9700000.0
      newQuantity = 10000000.0

  revaluedData <- queryContractId provider revaluedCid
  case revaluedData of
    None -> abort "Revalued collateral not found"
    Some c -> assertMsg "Market value updated" (c.marketValue == 9700000.0)

testCollateralSubstitution : Script ()
testCollateralSubstitution = script do
  provider  <- allocateParty "BorrowerBank"
  receiver  <- allocateParty "LenderBank"
  custodian <- allocateParty "TriPartyCustodian"

  collCid   <- mkCollateral provider receiver custodian (AccountId "ACC-SUB-001")
                 5000000.0 4950000.0 0.02
  activeCid <- submit custodian do exerciseCmd collCid ActivateCollateral

  subCid <- submitMulti [provider, receiver] [] do
    exerciseCmd activeCid SubstituteCollateral with
      newIsin = ISIN "GB00BN65R313"
      newQuantity = 5100000.0
      newMarketValue = 5050000.0
      newHaircut = 0.03
      newAssetClass = GovernmentSecurity
      newLockReference = "LOCK-SUBSTITUTE-001"

  subData <- queryContractId receiver subCid
  case subData of
    None -> abort "Substituted collateral not visible to receiver"
    Some c -> do
      assertMsg "New ISIN" (c.isin == ISIN "GB00BN65R313")
      assertMsg "Status Substituted" (c.status == Substituted)
      assertMsg "New haircut" (c.haircut == 0.03)

testCollateralRelease : Script ()
testCollateralRelease = script do
  provider  <- allocateParty "BorrowerBank"
  receiver  <- allocateParty "LenderBank"
  custodian <- allocateParty "TriPartyCustodian"

  collCid   <- mkCollateral provider receiver custodian (AccountId "ACC-REL-001")
                 5000000.0 4950000.0 0.02
  activeCid <- submit custodian do exerciseCmd collCid ActivateCollateral

  releasedCid <- submitMulti [provider, receiver] [] do
    exerciseCmd activeCid ReleaseCollateral

  relData <- queryContractId custodian releasedCid
  case relData of
    None -> abort "Released collateral not found"
    Some c -> assertMsg "Status Released" (c.status == Released)

testCollateralLiquidation : Script ()
testCollateralLiquidation = script do
  provider  <- allocateParty "BorrowerBank"
  receiver  <- allocateParty "LenderBank"
  custodian <- allocateParty "TriPartyCustodian"

  collCid   <- mkCollateral provider receiver custodian (AccountId "ACC-LIQ-001")
                 5000000.0 4950000.0 0.02
  activeCid <- submit custodian do exerciseCmd collCid ActivateCollateral

  liqCid <- submit receiver do
    exerciseCmd activeCid LiquidateCollateral

  liqData <- queryContractId provider liqCid
  case liqData of
    None -> abort "Liquidated collateral not found"
    Some c -> assertMsg "Status Liquidated" (c.status == Liquidated)

testCollateralDisputeResolution : Script ()
testCollateralDisputeResolution = script do
  provider  <- allocateParty "BorrowerBank"
  receiver  <- allocateParty "LenderBank"
  custodian <- allocateParty "TriPartyCustodian"

  collCid   <- mkCollateral provider receiver custodian (AccountId "ACC-DISP-001")
                 10000000.0 9800000.0 0.02
  activeCid <- submit custodian do exerciseCmd collCid ActivateCollateral

  -- Provider raises a dispute
  disputeCid <- submit provider do
    exerciseCmd activeCid RaiseValuationDispute

  dispData <- queryContractId receiver disputeCid
  case dispData of
    None -> abort "Dispute collateral not visible"
    Some c -> assertMsg "InDispute status" (c.status == InDispute)

  -- Both parties agree on new value
  resolvedCid <- submitMulti [provider, receiver] [] do
    exerciseCmd disputeCid ResolveDispute with agreedMarketValue = 9850000.0

  resData <- queryContractId custodian resolvedCid
  case resData of
    None -> abort "Resolved collateral not found"
    Some c -> do
      assertMsg "Status Active again" (c.status == Collateral.Active)
      assertMsg "Agreed market value" (c.marketValue == 9850000.0)

-- Negative: substitution only allowed on Active
testSubstitutionRequiresActive : Script ()
testSubstitutionRequiresActive = script do
  provider  <- allocateParty "BorrowerBank"
  receiver  <- allocateParty "LenderBank"
  custodian <- allocateParty "TriPartyCustodian"

  -- Collateral is Allocated, not Active
  collCid <- mkCollateral provider receiver custodian (AccountId "ACC-SUBNEG-001")
               5000000.0 4950000.0 0.02

  submitMultiMustFail [provider, receiver] [] do
    exerciseCmd collCid SubstituteCollateral with
      newIsin = ISIN "GB00BN65R313"
      newQuantity = 5000000.0
      newMarketValue = 4900000.0
      newHaircut = 0.02
      newAssetClass = GovernmentSecurity
      newLockReference = "LOCK-001"

-- Negative: provider cannot liquidate (only receiver can)
testOnlyReceiverCanLiquidate : Script ()
testOnlyReceiverCanLiquidate = script do
  provider  <- allocateParty "BorrowerBank"
  receiver  <- allocateParty "LenderBank"
  custodian <- allocateParty "TriPartyCustodian"

  collCid   <- mkCollateral provider receiver custodian (AccountId "ACC-LIQNEG-001")
                 5000000.0 4950000.0 0.02
  activeCid <- submit custodian do exerciseCmd collCid ActivateCollateral

  submitMustFail provider do
    exerciseCmd activeCid LiquidateCollateral

-- Negative: ensure rejects invalid haircut (>= 1.0)
testCollateralEnsureHaircutRange : Script ()
testCollateralEnsureHaircutRange = script do
  provider  <- allocateParty "BorrowerBank"
  receiver  <- allocateParty "LenderBank"
  custodian <- allocateParty "TriPartyCustodian"

  submitMultiMustFail [provider, receiver, custodian] [] do
    createCmd CollateralPosition with
      collateralProvider = provider
      collateralReceiver = receiver
      custodian = custodian
      accountId = AccountId "ACC-HCUT-001"
      assetClass = GovernmentSecurity
      isin = ISIN "US912828ZM50"
      quantity = 1000000.0
      marketValue = 990000.0
      haircut = 1.0        -- invalid: must be < 1.0
      settlementCurrency = "USD"
      obligationRef = "REPO-001"
      lockReference = "LOCK-001"
      status = Allocated
      externalRef = None
      observers = []

-- ---------------------------------------------------------------------------
-- Entry Point
-- ---------------------------------------------------------------------------

runSecurityCollateralTests : Script ()
runSecurityCollateralTests = script do
  -- Security tests
  testSecurityCreation
  testSecuritySplitPreservesTotal
  testSecurityLockAndUnlock
  testSecurityTransfer
  testSecurityObserverScoping
  testCannotSplitLockedSecurity
  testCannotTransferLockedSecurity
  testSplitCannotExceedTotal
  testSecurityEnsurePositiveQuantity
  -- Collateral tests
  testCollateralCreationAndActivation
  testCollateralValue
  testCollateralRevaluation
  testCollateralSubstitution
  testCollateralRelease
  testCollateralLiquidation
  testCollateralDisputeResolution
  testSubstitutionRequiresActive
  testOnlyReceiverCanLiquidate
  testCollateralEnsureHaircutRange
