-- | Comprehensive unit and lifecycle tests for AryaFi.Contracts.Loan.
module AryaFi.Test.Unit.LoanTest where

import Daml.Script
import AryaFi.Contracts.Loan
import AryaFi.Common.Types (DayCountConvention(..), LifecycleStatus(..))
import AryaFi.Common.Identifiers (CorrelationId(..))
import DA.Date (date, Month(..))
import DA.Time (time)

setupParties : Script (Party, Party, Party, Party)
setupParties = do
  lender <- allocateParty "JPMorganChase"
  borrower <- allocateParty "ApolloGlobal"
  agentBank <- allocateParty "BNYMellon"
  regulator <- allocateParty "FederalReserve"
  pure (lender, borrower, agentBank, regulator)

baseStartDate : Time
baseStartDate = time (date 2026 Sep 1) 9 0 0

baseMaturityDate : Time
baseMaturityDate = time (date 2027 Sep 1) 9 0 0

-- ---------------------------------------------------------------------------
-- Positive Lifecycle Tests
-- ---------------------------------------------------------------------------

-- | Test full credit facility lifecycle: creation -> drawdown -> accrual -> interest pay -> paydown -> close
testLoanFullLifecycle : Script ()
testLoanFullLifecycle = script do
  (lender, borrower, agentBank, regulator) <- setupParties

  loanCid <- submitMulti [lender, borrower] [] do
    createCmd InstitutionalLoan with
      loanId = "FACILITY-2026-US-001"
      lender = lender
      borrower = borrower
      agentBank = Some agentBank
      currency = "USD"
      facilityLimit = 10000000.0
      drawnPrincipal = 5000000.0
      accruedInterest = 0.0
      interestRate = 0.0575
      dayCountConvention = Act360
      startDate = baseStartDate
      maturityDate = baseMaturityDate
      collateralPledgeRef = None
      status = Active
      defaultReason = None
      correlationId = CorrelationId "CORR-LOAN-001"
      observers = []

  -- Verify active
  isActive <- submit lender do
    exerciseCmd loanCid IsLoanActive
  assertMsg "Loan must be active" isActive

  -- Drawdown additional 2M
  loanCid2 <- submit borrower do
    exerciseCmd loanCid DrawdownPrincipal with
      drawdownAmount = 2000000.0

  Some loan2 <- queryContractId borrower loanCid2
  assertMsg "Drawn principal must equal 7M" (loan2.drawnPrincipal == 7000000.0)

  -- Link collateral pledge reference
  loanCid3 <- submit borrower do
    exerciseCmd loanCid2 LinkCollateralPledge with
      pledgeRef = "PLEDGE-UST-2026-001"

  Some loan3 <- queryContractId borrower loanCid3
  assertMsg "Collateral reference must be populated" (loan3.collateralPledgeRef == Some "PLEDGE-UST-2026-001")

  -- Accrue interest (33,541.67 USD for one month)
  loanCid4 <- submit lender do
    exerciseCmd loanCid3 AccrueInterest with
      additionalInterest = 33541.67

  Some loan4 <- queryContractId lender loanCid4
  assertMsg "Accrued interest must be 33541.67" (loan4.accruedInterest == 33541.67)

  -- Pay accrued interest
  loanCid5 <- submit borrower do
    exerciseCmd loanCid4 PayAccruedInterest with
      paymentAmount = 33541.67

  Some loan5 <- queryContractId borrower loanCid5
  assertMsg "Accrued interest must be zero" (loan5.accruedInterest == 0.0)

  -- Add regulator as observer
  loanCid6 <- submit lender do
    exerciseCmd loanCid5 AddLoanObserver with
      newObserver = regulator

  Some loan6 <- queryContractId lender loanCid6
  assertMsg "Regulator must be observer" (regulator `elem` loan6.observers)

  -- Pay down principal in full
  loanCid7 <- submit borrower do
    exerciseCmd loanCid6 PayDownPrincipal with
      paymentAmount = 7000000.0

  Some loan7 <- queryContractId borrower loanCid7
  assertMsg "Drawn principal must be 0" (loan7.drawnPrincipal == 0.0)
  assertMsg "Status must auto-transition to Closed" (loan7.status == Closed)

  -- Unlink collateral pledge now that obligations are zero
  loanCid8 <- submit lender do
    exerciseCmd loanCid7 UnlinkCollateralPledge

  Some loan8 <- queryContractId lender loanCid8
  assertMsg "Collateral reference must be unlinked" (loan8.collateralPledgeRef == None)
  pure ()

-- | Test default declaration and subsequent cure
testLoanDefaultAndCure : Script ()
testLoanDefaultAndCure = script do
  (lender, borrower, agentBank, _) <- setupParties

  loanCid <- submitMulti [lender, borrower] [] do
    createCmd InstitutionalLoan with
      loanId = "FACILITY-DEFAULT-TEST"
      lender = lender
      borrower = borrower
      agentBank = Some agentBank
      currency = "USD"
      facilityLimit = 5000000.0
      drawnPrincipal = 2000000.0
      accruedInterest = 10000.0
      interestRate = 0.06
      dayCountConvention = Act360
      startDate = baseStartDate
      maturityDate = baseMaturityDate
      collateralPledgeRef = None
      status = Active
      defaultReason = None
      correlationId = CorrelationId "CORR-DEF-001"
      observers = []

  -- Lender declares default
  loanCidDefaulted <- submit lender do
    exerciseCmd loanCid DeclareLoanDefault with
      reason = "Failure to submit audited quarterly financial covenants"

  Some defLoan <- queryContractId lender loanCidDefaulted
  assertMsg "Status must be Defaulted" (defLoan.status == Defaulted)
  assertMsg "Default reason must be set" (defLoan.defaultReason == Some "Failure to submit audited quarterly financial covenants")

  -- Lender cures default upon borrower rectification
  loanCidCured <- submit lender do
    exerciseCmd loanCidDefaulted CureLoanDefault

  Some curedLoan <- queryContractId borrower loanCidCured
  assertMsg "Status must revert to Active" (curedLoan.status == Active)
  assertMsg "Default reason must be cleared" (curedLoan.defaultReason == None)
  pure ()

-- ---------------------------------------------------------------------------
-- Negative Authorization and Invariant Tests
-- ---------------------------------------------------------------------------

-- | Negative: Drawdown exceeding facility limit must be rejected
testOverLimitDrawdownFails : Script ()
testOverLimitDrawdownFails = script do
  (lender, borrower, _, _) <- setupParties

  loanCid <- submitMulti [lender, borrower] [] do
    createCmd InstitutionalLoan with
      loanId = "FACILITY-LIMIT-TEST"
      lender = lender
      borrower = borrower
      agentBank = None
      currency = "USD"
      facilityLimit = 5000000.0
      drawnPrincipal = 4500000.0
      accruedInterest = 0.0
      interestRate = 0.05
      dayCountConvention = Act360
      startDate = baseStartDate
      maturityDate = baseMaturityDate
      collateralPledgeRef = None
      status = Active
      defaultReason = None
      correlationId = CorrelationId "CORR-LIM-001"
      observers = []

  submitMustFail borrower do
    exerciseCmd loanCid DrawdownPrincipal with
      drawdownAmount = 600000.0 -- 4.5M + 0.6M = 5.1M > 5.0M

-- | Negative: Payment exceeding drawn principal must be rejected
testPaydownExceedingDrawnFails : Script ()
testPaydownExceedingDrawnFails = script do
  (lender, borrower, _, _) <- setupParties

  loanCid <- submitMulti [lender, borrower] [] do
    createCmd InstitutionalLoan with
      loanId = "FACILITY-EXCEED-TEST"
      lender = lender
      borrower = borrower
      agentBank = None
      currency = "USD"
      facilityLimit = 5000000.0
      drawnPrincipal = 1000000.0
      accruedInterest = 0.0
      interestRate = 0.05
      dayCountConvention = Act360
      startDate = baseStartDate
      maturityDate = baseMaturityDate
      collateralPledgeRef = None
      status = Active
      defaultReason = None
      correlationId = CorrelationId "CORR-EXC-001"
      observers = []

  submitMustFail borrower do
    exerciseCmd loanCid PayDownPrincipal with
      paymentAmount = 1500000.0

-- | Negative: Non-borrower cannot execute drawdown
testUnauthorizedDrawdownFails : Script ()
testUnauthorizedDrawdownFails = script do
  (lender, borrower, _, _) <- setupParties
  thirdParty <- allocateParty "UnauthorizedParty"

  loanCid <- submitMulti [lender, borrower] [] do
    createCmd InstitutionalLoan with
      loanId = "FACILITY-AUTH-TEST"
      lender = lender
      borrower = borrower
      agentBank = None
      currency = "USD"
      facilityLimit = 5000000.0
      drawnPrincipal = 1000000.0
      accruedInterest = 0.0
      interestRate = 0.05
      dayCountConvention = Act360
      startDate = baseStartDate
      maturityDate = baseMaturityDate
      collateralPledgeRef = None
      status = Active
      defaultReason = None
      correlationId = CorrelationId "CORR-AUTH-001"
      observers = []

  submitMustFail thirdParty do
    exerciseCmd loanCid DrawdownPrincipal with
      drawdownAmount = 500000.0

-- | Negative: Cannot unlink collateral while principal is outstanding
testUnlinkCollateralWhileBalanceOutstandingFails : Script ()
testUnlinkCollateralWhileBalanceOutstandingFails = script do
  (lender, borrower, _, _) <- setupParties

  loanCid <- submitMulti [lender, borrower] [] do
    createCmd InstitutionalLoan with
      loanId = "FACILITY-UNLINK-TEST"
      lender = lender
      borrower = borrower
      agentBank = None
      currency = "USD"
      facilityLimit = 5000000.0
      drawnPrincipal = 2000000.0
      accruedInterest = 0.0
      interestRate = 0.05
      dayCountConvention = Act360
      startDate = baseStartDate
      maturityDate = baseMaturityDate
      collateralPledgeRef = Some "PLEDGE-001"
      status = Active
      defaultReason = None
      correlationId = CorrelationId "CORR-UNL-001"
      observers = []

  submitMustFail lender do
    exerciseCmd loanCid UnlinkCollateralPledge
