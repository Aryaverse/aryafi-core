# Deploy only the website and the files it displays. Everything else in the
# repository stays off the public site. When the site starts showing a new
# file (a document in DOCS or a module in DAML_MODULES in app.js), allow it here.
/*
!/index.html
!/app.js
!/styles.css
!/vercel.json
!/CHANGELOG.md

!/docs
/docs/*
!/docs/KNOWN_LIMITATIONS.md
!/docs/IMPROVEMENT_PLAN.md
!/docs/USER_GUIDE.md
!/docs/integration
/docs/integration/*
!/docs/integration/LEDGER_API_CLIENT.md
!/docs/integration/ISO20022_MAPPINGS.md
!/docs/governance
/docs/governance/*
!/docs/governance/MIGRATION_GUIDE.md
!/docs/governance/VERSIONING_AND_RELEASE.md
!/docs/security
/docs/security/*
!/docs/security/AUTHORIZATION_MATRIX.md
!/docs/security/THREAT_MODEL.md

!/deploy
/deploy/*
!/deploy/testnet
/deploy/testnet/*
!/deploy/testnet/README.md

!/daml
/daml/*
!/daml/src
/daml/src/*
!/daml/src/AryaFi
/daml/src/AryaFi/*
!/daml/src/AryaFi/Finance
/daml/src/AryaFi/Finance/*
!/daml/src/AryaFi/Finance/Cash.daml
